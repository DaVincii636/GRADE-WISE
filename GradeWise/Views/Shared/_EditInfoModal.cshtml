@model GradeWise.Models.ProfileInfo
@{
    // Keep the original GradeWise profile modal structure and styling.
    var errors = TempData["EditInfoErrors"] as List<string> ?? new List<string>();
    var which = TempData["EditInfoForm"] as string;
    var posted = TempData["EditInfoProfile"] as Dictionary<string, string> ?? new Dictionary<string, string>();
    Func<string, string, string> value = (key, fallback) => posted.ContainsKey(key) ? posted[key] : fallback;

    var suffixes = new[] { "Jr.", "Sr.", "II", "III", "IV", "V" };
    var legacyParts = (Model.FullName ?? string.Empty).Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries).ToList();
    var legacySuffix = legacyParts.Count > 0 && suffixes.Contains(legacyParts[legacyParts.Count - 1]) ? legacyParts[legacyParts.Count - 1] : string.Empty;
    if (!string.IsNullOrEmpty(legacySuffix))
    {
        legacyParts.RemoveAt(legacyParts.Count - 1);
    }
    var fallbackFirst = Model.FirstName;
    var fallbackMiddle = Model.MiddleName;
    var fallbackLast = Model.LastName;
    if (string.IsNullOrWhiteSpace(fallbackFirst) && legacyParts.Count > 0)
    {
        fallbackFirst = legacyParts[0];
        fallbackLast = legacyParts.Count > 1 ? legacyParts[legacyParts.Count - 1] : string.Empty;
        fallbackMiddle = legacyParts.Count > 2 ? string.Join(" ", legacyParts.Skip(1).Take(legacyParts.Count - 2)) : string.Empty;
    }
    var firstName = value("FirstName", fallbackFirst ?? string.Empty);
    var middleName = value("MiddleName", fallbackMiddle ?? string.Empty);
    var lastName = value("LastName", fallbackLast ?? string.Empty);
    var suffix = value("Suffix", Model.Suffix ?? legacySuffix);
    var loginId = value("LoginId", Model.StudentNo ?? string.Empty);
    var email = value("Email", Model.Email ?? string.Empty);
    var profileErrors = which == "profile" ? errors : new List<string>();
    var passwordErrors = which == "password" ? errors : new List<string>();
    var reopen = profileErrors.Count > 0 || passwordErrors.Count > 0;
    var isFaculty = string.Equals(Model.Role, GradeWise.Models.Roles.Faculty, StringComparison.OrdinalIgnoreCase);
    var accountIdLabel = isFaculty ? "Faculty username" : "Student number";
    var accountIdHint = isFaculty
        ? "Your faculty username is used to sign in (e.g. fac_juan)."
        : "Your student number is used to sign in (e.g. 26-0001).";
}

<div id="gw-editinfo-modal" class="gw-modal-backdrop" hidden @(reopen ? "data-open-on-load" : null)>
    <div class="gw-panel gw-card-raised gw-modal-card" role="dialog" aria-modal="true" aria-labelledby="gw-editinfo-title">
        <div class="gw-panel-head">
            <h2 id="gw-editinfo-title" class="gw-panel-title">My profile</h2>
        </div>
        <div class="gw-modal-top">
            <div class="gw-modal-meta gw-modal-meta-stack">
                <strong class="gw-profile-name">@Model.FullName</strong>
                <span>@accountIdLabel: @Model.StudentNo</span>
                <span class="gw-muted">@(isFaculty ? "Update your faculty account details or password." : "Update your student account details or password.")</span>
            </div>
            <button type="button" class="gw-iconbtn gw-modal-close" data-modal-close aria-label="Close" title="Close">
                <img src="@Url.Content("~/Content/img/icons/close.svg")" alt="" width="20" height="20" />
            </button>
        </div>

        <div class="gw-panel-body gw-editinfo-body">
            <section class="gw-editinfo-section" aria-labelledby="gw-ei-profile-h">
                <h3 id="gw-ei-profile-h" class="gw-editinfo-heading">Personal and account details</h3>
                <p class="gw-muted gw-editinfo-current">Role: <strong>@Model.Role</strong> (managed by the administrator)</p>
                @if (profileErrors.Count > 0)
                {
                    <div class="gw-alert" role="alert">
                        <strong>Your profile was not updated.</strong>
                        <ul class="gw-error-list">
                            @foreach (var e in profileErrors) { <li>@e</li> }
                        </ul>
                    </div>
                }
                @using (Html.BeginForm("UpdateProfile", "Account", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <div class="gw-field">
                        <label for="gw-ei-first">First name <span class="gw-muted">(required)</span></label>
                        <input type="text" id="gw-ei-first" name="firstName" value="@firstName" maxlength="40" required autocomplete="given-name" />
                    </div>
                    <div class="gw-field">
                        <label for="gw-ei-middle">Middle name <span class="gw-muted">(optional)</span></label>
                        <input type="text" id="gw-ei-middle" name="middleName" value="@middleName" maxlength="40" autocomplete="additional-name" />
                    </div>
                    <div class="gw-field">
                        <label for="gw-ei-last">Last name <span class="gw-muted">(required)</span></label>
                        <input type="text" id="gw-ei-last" name="lastName" value="@lastName" maxlength="40" required autocomplete="family-name" />
                    </div>
                    <div class="gw-field">
                        <label for="gw-ei-suffix">Suffix <span class="gw-muted">(optional)</span></label>
                        <select id="gw-ei-suffix" name="suffix">
                            <option value="" @(string.IsNullOrEmpty(suffix) ? "selected" : null)>None</option>
                            @foreach (var item in suffixes)
                            {
                                <option value="@item" @(suffix == item ? "selected" : null)>@item</option>
                            }
                        </select>
                    </div>
                    <p class="gw-muted gw-editinfo-current">Full name preview: <strong id="gw-ei-name-preview">@Model.FullName</strong></p>
                    <div class="gw-field">
                        <label for="gw-ei-login">@accountIdLabel <span class="gw-muted">(required)</span></label>
                        <input type="text" id="gw-ei-login" name="loginId" value="@loginId" maxlength="50" required autocomplete="username" />
                        <span class="gw-field-hint">@accountIdHint</span>
                    </div>
                    <div class="gw-field">
                        <label for="gw-ei-email">Email <span class="gw-muted">(required)</span></label>
                        <input type="email" id="gw-ei-email" name="email" value="@email" maxlength="254" required autocomplete="email" />
                    </div>
                    <div class="gw-field">
                        <label for="gw-ei-profile-password">Current password <span class="gw-muted">(required to save)</span></label>
                        <input type="password" id="gw-ei-profile-password" name="currentPassword" maxlength="128" required autocomplete="current-password" />
                    </div>
                    <div class="gw-form-buttons">
                        <button type="submit" class="gw-btn">Save profile changes</button>
                    </div>
                }
            </section>

            <section class="gw-editinfo-section" aria-labelledby="gw-ei-pw-h">
                <h3 id="gw-ei-pw-h" class="gw-editinfo-heading">Change password</h3>
                <p class="gw-field-hint gw-hint-block">At least 8 characters, with at least one letter and one number.</p>
                @if (passwordErrors.Count > 0)
                {
                    <div class="gw-alert" role="alert">
                        <strong>Your password was not changed.</strong>
                        <ul class="gw-error-list">
                            @foreach (var e in passwordErrors) { <li>@e</li> }
                        </ul>
                    </div>
                }
                @using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <div class="gw-field">
                        <label for="gw-ei-pwcurrent">Current password</label>
                        <input type="password" id="gw-ei-pwcurrent" name="currentPassword" maxlength="128" required autocomplete="current-password" />
                    </div>
                    <div class="gw-field">
                        <label for="gw-ei-pwnew">New password</label>
                        <input type="password" id="gw-ei-pwnew" name="newPassword" maxlength="128" required autocomplete="new-password" />
                    </div>
                    <div class="gw-field">
                        <label for="gw-ei-pwconfirm">Confirm new password</label>
                        <input type="password" id="gw-ei-pwconfirm" name="confirmPassword" maxlength="128" required autocomplete="new-password" />
                    </div>
                    <div class="gw-form-buttons">
                        <button type="submit" class="gw-btn">Update password</button>
                    </div>
                }
            </section>
        </div>

        <div class="gw-modal-foot">
            <button type="button" class="gw-btn gw-btn-outline" data-modal-close>Close</button>
        </div>
    </div>
</div>

<script>
(function () {
    var modal = document.getElementById('gw-editinfo-modal');
    if (!modal || modal.getAttribute('data-profile-preview-bound') === '1') return;
    modal.setAttribute('data-profile-preview-bound', '1');
    var ids = ['gw-ei-first', 'gw-ei-middle', 'gw-ei-last', 'gw-ei-suffix'];
    var preview = document.getElementById('gw-ei-name-preview');
    function updatePreview() {
        var parts = ids.map(function (id) {
            var el = document.getElementById(id);
            return el ? el.value.trim() : '';
        }).filter(Boolean);
        if (preview) preview.textContent = parts.join(' ') || 'Enter your first and last name';
    }
    ids.forEach(function (id) {
        var el = document.getElementById(id);
        if (el) {
            el.addEventListener('input', updatePreview);
            el.addEventListener('change', updatePreview);
        }
    });
    updatePreview();
})();
</script>
