@using GradeWise.Data
@using MongoDB.Driver
@{
    // Who is signed in? Look the account up in MongoDB so updates show right away.
    string role = null;
    string userName = null;
    string userEmail = null;
    string userNo = null;
    if (User.Identity.IsAuthenticated)
    {
        try
        {
            // Global.asax already found the account for this request; only look it up again if it did not.
            var me = Context.Items["gw.user"] as GradeWise.Models.User;
            if (me == null)
            {
                var db = new MongoDbContext();
                var identityName = User.Identity.Name;
                me = db.Users.Find(u => u.StudentNo == identityName || u.Email == identityName).FirstOrDefault();
            }
            if (me != null)
            {
                role = me.Role;
                userName = me.FullName;
                userEmail = me.Email;
                userNo = me.StudentNo;
            }
        }
        catch (Exception)
        {
            role = null;
            userName = null;
            userEmail = null;
            userNo = null;
        }
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - GradeWise</title>
    <link rel="icon" type="image/svg+xml" href="@Url.Content("~/Content/img/stickers/stamp-ring.svg")" />
    @* Back button: a page that the browser puts back from its back-forward cache is hidden right away
        (before it can be seen) and fetched again from the server, so a signed-out page is never shown. *@
    <style>
        html.gw-checking body {
            visibility: hidden;
        }
    </style>
    <script>
        (function () {
            var root = document.documentElement;
            window.addEventListener("pageshow", function (e) {
                if (!e.persisted) { return; }
                root.classList.add("gw-checking");
                window.location.reload();
                // If the reload is slow, do not leave the page blank for long.
                setTimeout(function () { root.classList.remove("gw-checking"); }, 5000);
            });
        })();
    </script>
    @* Start loading the three fonts at once instead of waiting for fonts.css to be read first. *@
    <link rel="preload" href="@Url.Content("~/Content/fonts/SpaceGrotesk-Regular.woff2")" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="@Url.Content("~/Content/fonts/SpaceGrotesk-Bold.woff2")" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="@Url.Content("~/Content/fonts/Silkscreen-Regular.woff2")" as="font" type="font/woff2" crossorigin />
    @* The ?v= is the file's last-saved time, so a changed file is fetched again and an unchanged one comes from the browser cache. *@
    <link rel="stylesheet" href="@Url.Content("~/Content/fonts.css")?v=@System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Content/fonts.css")).Ticks" />
    @Styles.Render("~/Content/css")
    <link rel="stylesheet" href="@Url.Content("~/Content/Site.css")?v=@System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Content/Site.css")).Ticks" />
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <div class="gw-progress" aria-hidden="true"></div>
    <header class="gw-topbar">
        <div class="gw-topbar-inner">
            <a href="@Url.Action("Index", "Home", new { area = "" })" class="gw-brand">
                <img src="~/Content/img/stickers/stamp-ring.svg" alt="" class="gw-brand-mark" width="36" height="36" />
                <span class="gw-brand-word">GradeWise</span>
            </a>
            @if (!string.IsNullOrEmpty(role))
            {
                <div class="gw-user">
                    <span class="gw-user-name">@userName</span>
                    <span class="gw-role">@role</span>
                    @if (role == GradeWise.Models.Roles.Student)
                    {
                        @Html.Action("Bell", "Notifications")
                        <button type="button" class="gw-iconbtn gw-edit-btn" data-modal-open="gw-editinfo-modal" aria-haspopup="dialog" aria-label="My profile" title="My profile">
                            <img src="~/Content/img/icons/user.svg" alt="" width="24" height="24" />
                        </button>
                    }
                    <a href="@Url.Action("Logout", "Account", new { area = "" })" class="gw-iconbtn gw-signout" aria-label="Sign out" title="Sign out">
                        <img src="~/Content/img/icons/sign-out.svg" alt="" width="24" height="24" />
                    </a>
                </div>
            }
        </div>
    </header>

    <main class="gw-page">
        @RenderBody()
    </main>

    <footer class="gw-footer">
        &copy; @DateTime.Now.Year GradeWise
    </footer>

    @if (role == GradeWise.Models.Roles.Student)
    {
        @Html.Partial("_EditInfoModal", new GradeWise.Models.ProfileInfo { FullName = userName, StudentNo = userNo, Email = userEmail })
    }

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @Scripts.Render("~/bundles/gwmodal")
    @if (role == GradeWise.Models.Roles.Student)
    {
        @Scripts.Render("~/bundles/gwnotifications")
    }
    @RenderSection("scripts", required: false)

    <script>
        // Instant feedback when something is clicked: a thin bar at the top of the page, and the
        // pressed button is switched off so it cannot be sent twice while the next page loads.
        (function () {
            var root = document.documentElement;
            var timer = null;

            function stop() {
                root.classList.remove("gw-loading");
                clearTimeout(timer);
                var busy = document.querySelectorAll(".gw-busy");
                for (var i = 0; i < busy.length; i++) {
                    busy[i].classList.remove("gw-busy");
                    busy[i].disabled = false;
                }
            }

            function start() {
                root.classList.add("gw-loading");
                clearTimeout(timer);
                timer = setTimeout(stop, 12000);   // never get stuck if the page does not change
            }

            document.addEventListener("click", function (e) {
                if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) { return; }
                var a = e.target.closest ? e.target.closest("a[href]") : null;
                if (!a) { return; }
                var href = a.getAttribute("href") || "";
                if (href === "" || href.charAt(0) === "#" || /^(javascript|mailto|tel):/i.test(href)) { return; }
                if ((a.target && a.target !== "_self") || a.hasAttribute("download") || a.hasAttribute("data-no-progress") || a.hasAttribute("data-modal-open")) { return; }
                if (a.origin && a.origin !== window.location.origin) { return; }
                if (/\/Export/i.test(a.pathname)) { return; }   // a file download never leaves the page
                start();
            });

            document.addEventListener("submit", function (e) {
                var form = e.target;
                if (e.defaultPrevented || !form || form.hasAttribute("data-no-progress") || (form.target && form.target !== "_self")) { return; }
                start();
                var button = e.submitter || form.querySelector('button[type="submit"], input[type="submit"]');
                if (button && !button.disabled) {
                    // After this click is handled, so the button's own value is still sent with the form.
                    setTimeout(function () { button.disabled = true; button.classList.add("gw-busy"); }, 0);
                }
            });

            // Back to a page that was kept as it was: clear the bar and switch the buttons on again.
            window.addEventListener("pageshow", stop);
        })();
    </script>
</body>
</html>