@using GradeWise.Data
@{
    // Who is signed in? Look the account up so a name or role change by the admin shows right away.
    string role = null;
    string userName = null;
    if (User.Identity.IsAuthenticated)
    {
        var me = SampleData.FindByLogin(User.Identity.Name);
        if (me != null)
        {
            role = me.Role;
            userName = me.FullName;
        }
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - GradeWise</title>
    <link rel="stylesheet" href="~/Content/fonts.css" />
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <header class="gw-topbar">
        <div class="gw-topbar-inner">
            @Html.ActionLink("GradeWise", "Index", "Home", new { area = "" }, new { @class = "gw-brand" })
            @if (!string.IsNullOrEmpty(role))
            {
                <div class="gw-user">
                    <span class="gw-user-name">@userName</span>
                    <span class="gw-role">@role</span>
                    @Html.ActionLink("Sign out", "Logout", "Account", new { area = "" }, new { @class = "gw-signout" })
                </div>
            }
        </div>
    </header>

    <main class="gw-page">
        @RenderBody()
    </main>

    <footer class="gw-footer">
        &copy; @DateTime.Now.Year GradeWise
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
