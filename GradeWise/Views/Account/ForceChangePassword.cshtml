@{
    ViewBag.Title = "Change Your Password";
    var errors = ViewBag.Errors as List<string>;
}

<div class="gw-login" style="margin-top: 50px;">
    <div class="gw-login-intro" style="text-align: center;">
        <h1 class="gw-login-headline">Welcome to GradeWise</h1>
        <p class="gw-login-sub">For security, you must change your temporary password before continuing.</p>
    </div>

    <div class="gw-login-stage" style="display: flex; justify-content: center;">
        <section class="gw-card gw-card-raised gw-login-card" style="width: 100%; max-width: 440px;">
            <div class="gw-card-head">
                <h2 class="gw-card-tab">Create New Password</h2>
            </div>
            <div class="gw-card-body">

                @if (errors != null && errors.Count > 0)
                {
                    <div class="gw-alert" role="alert">
                        <ul class="gw-error-list" style="margin: 0; padding-left: 20px;">
                            @foreach (var e in errors)
                            {
                                <li>@e</li>
}
                        </ul>
                    </div>
                }

                @using (Html.BeginForm("ForceChangePassword", "Account", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="gw-field gw-login-field">
                        <label for="newPassword">New Password</label>
                        <input type="password" id="newPassword" name="newPassword" required autocomplete="new-password" placeholder="At least 8 characters" />
                    </div>

                    <div class="gw-field gw-login-field">
                        <label for="confirmPassword">Confirm New Password</label>
                        <input type="password" id="confirmPassword" name="confirmPassword" required autocomplete="new-password" />
                    </div>

                    <button type="submit" class="gw-btn gw-btn-block" style="margin-top: 20px;">Save Password & Continue</button>
                }
            </div>
        </section>
    </div>
</div>