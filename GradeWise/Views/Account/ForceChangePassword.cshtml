@{
    ViewBag.Title = "Change Your Password";
    var errors = ViewBag.Errors as List<string>;
    // The same limits the server checks (ValidationHelper.PasswordProblem); shown here and used by the page script.
    var minLength = GradeWise.Helpers.ValidationHelper.MinPasswordLength;
    var maxLength = GradeWise.Helpers.ValidationHelper.MaxPasswordLength;
}

@* The eye icons of the show / hide buttons (the same icons as the sign-in page). *@
@helper EyeIcons()
{
    <svg class="gw-eye" data-icon="visible" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" aria-hidden="true" focusable="false">
        <path d="M2 12s3.6-6.5 10-6.5S22 12 22 12s-3.6 6.5-10 6.5S2 12 2 12z" />
        <circle cx="12" cy="12" r="3" />
    </svg>
    <svg class="gw-eye-off" data-icon="hidden" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" aria-hidden="true" focusable="false">
        <path d="M2 12s3.6-6.5 10-6.5S22 12 22 12s-3.6 6.5-10 6.5S2 12 2 12z" />
        <circle cx="12" cy="12" r="3" />
        <path d="M4 4l16 16" />
    </svg>
}

<div class="gw-login gw-forcepw">
    <div class="gw-login-intro gw-forcepw-intro">
        <h1 class="gw-login-headline">Welcome to GradeWise</h1>
        <p class="gw-login-sub">For security, you must change your temporary password before continuing.</p>
    </div>

    <section class="gw-card gw-card-raised gw-login-card gw-forcepw-card" aria-labelledby="gw-forcepw-title">
        <div class="gw-card-head">
            <h2 class="gw-card-tab" id="gw-forcepw-title">Create New Password</h2>
        </div>
        <div class="gw-card-body">

            @if (errors != null && errors.Count > 0)
            {
                @* The server's reasons (it checks the password again). *@
                <div class="gw-alert gw-forcepw-alert" role="alert" id="gw-forcepw-server-errors">
                    <strong class="gw-forcepw-alert-title">Your password was not saved.</strong>
                    <ul class="gw-error-list">
                        @foreach (var e in errors)
                        {
                            <li>@e</li>
                        }
                    </ul>
                </div>
            }

            @using (Html.BeginForm("ForceChangePassword", "Account", FormMethod.Post, new { id = "gw-forcepw-form" }))
            {
                @Html.AntiForgeryToken()

                <div class="gw-field gw-login-field">
                    <label for="newPassword">New Password</label>
                    <div class="gw-password-wrap">
                        <input type="password" id="newPassword" name="newPassword" required autocomplete="new-password" autofocus
                               aria-describedby="gw-pw-rules newPassword-error" />
                        @* type="button" so it never submits the form; hidden until the page script runs. *@
                        <button type="button" class="gw-password-toggle" data-password-toggle="newPassword"
                                aria-controls="newPassword" aria-pressed="false" aria-label="Show password" title="Show password" hidden>
                            @EyeIcons()
                        </button>
                    </div>
                    <p class="gw-forcepw-error" id="newPassword-error" hidden></p>

                    @* The password rules (the same ones the server checks). The script ticks them off while typing. *@
                    <ul class="gw-pw-rules" id="gw-pw-rules" aria-label="Password requirements" data-min="@minLength" data-max="@maxLength">
                        <li data-rule="length">At least @minLength characters</li>
                        <li data-rule="letter">At least one letter</li>
                        <li data-rule="number">At least one number</li>
                    </ul>
                </div>

                <div class="gw-field gw-login-field">
                    <label for="confirmPassword">Confirm New Password</label>
                    <div class="gw-password-wrap">
                        <input type="password" id="confirmPassword" name="confirmPassword" required autocomplete="new-password"
                               aria-describedby="gw-pw-match confirmPassword-error" />
                        <button type="button" class="gw-password-toggle" data-password-toggle="confirmPassword"
                                aria-controls="confirmPassword" aria-pressed="false" aria-label="Show password" title="Show password" hidden>
                            @EyeIcons()
                        </button>
                    </div>
                    <p class="gw-forcepw-error" id="confirmPassword-error" hidden></p>
                    <p class="gw-pw-match" id="gw-pw-match" aria-live="polite" hidden></p>
                </div>

                <button type="submit" class="gw-btn gw-btn-block gw-forcepw-submit">Save Password &amp; Continue</button>
                <p class="gw-forcepw-note">You will go to your dashboard once the new password is saved. Use it the next time you sign in.</p>
            }
        </div>
    </section>
</div>

@section scripts {
    @* The page script is in Scripts/account-force-password.js. *@
    <script src="@Url.Content("~/Scripts/account-force-password.js")?v=@System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Scripts/account-force-password.js")).Ticks"></script>
}
