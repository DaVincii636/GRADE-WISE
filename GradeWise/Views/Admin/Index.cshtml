@model IEnumerable<GradeWise.Models.User>
@using GradeWise.Models
@{
    ViewBag.Title = "Accounts and terms";

    var users = Model.ToList();
    var meLogin = ViewBag.MeLogin as string;
    var currentTerm = ViewBag.CurrentTerm as string;
    var roles = new[] { GradeWise.Models.Roles.Administrator, GradeWise.Models.Roles.Faculty, GradeWise.Models.Roles.Student };

    var message = TempData["Message"] as string;
    var error = TempData["Error"] as string;
    var tempPassword = TempData["TempPassword"] as string;
    var tempPasswordFor = TempData["TempPasswordFor"] as string;

    // Why an account cannot be deleted (owns courses, has grades or grade history, last administrator).
    // Accounts not listed can be deleted. AdminController.DeleteUser enforces the same rules on the server.
    var deleteBlockers = ViewBag.DeleteBlockers as Dictionary<string, string> ?? new Dictionary<string, string>();

    // Accounts per role, for the role tabs.
    var byRole = roles.ToDictionary(r => r, r => users.Count(u => u.Role == r));
}

<h1 class="gw-page-title">Accounts and terms</h1>
<p class="gw-page-sub">Manage user accounts and the academic term.</p>

@* Results of the last action (TempData). gw-modal.js turns these into toasts; without JavaScript they stay as banners. *@
@if (!string.IsNullOrEmpty(error))
{
    <div class="gw-alert" role="alert" data-gw-flash="error">@error</div>
}
@if (!string.IsNullOrEmpty(message))
{
    <div class="gw-alert gw-alert-ok" role="status" data-gw-flash="success">@message</div>
}
@if (!string.IsNullOrEmpty(tempPassword))
{
    <aside class="gw-sticky-note" role="status" aria-live="polite">
        <img src="@Url.Content("~/Content/img/stickers/tape.svg")" alt="" class="gw-tape" width="120" height="34" />
        <p class="gw-sticky-title">Temporary password for <strong>@tempPasswordFor</strong></p>
        <div class="gw-sticky-row">
            <code class="gw-temp-password" id="temp-password">@tempPassword</code>
            <button type="button" class="gw-btn gw-btn-small gw-btn-outline gw-copy-btn" id="copy-password" aria-describedby="copy-status">
                <img src="@Url.Content("~/Content/img/icons/copy.svg")" alt="" width="18" height="18" data-copy-icon="copy" />
                <img src="@Url.Content("~/Content/img/icons/check.svg")" alt="" width="18" height="18" data-copy-icon="done" hidden />
                <span data-copy-label>Copy</span>
            </button>
        </div>
        <p class="gw-copy-status" id="copy-status" role="status" aria-live="polite"></p>
        <p class="gw-sticky-hint">Copy it now and give it to the user. It is not shown again.</p>
    </aside>
}

<section class="gw-stats" aria-label="Summary">
    <div class="gw-stat" data-tab="Users">
        <div class="gw-stat-value">@users.Count</div>
        <div class="gw-stat-label">Users</div>
    </div>
    <div class="gw-stat" data-tab="Active">
        <div class="gw-stat-value">@users.Count(u => u.IsActive)</div>
        <div class="gw-stat-label">Active accounts</div>
    </div>
    <div class="gw-stat" data-tab="Term">
        <div class="gw-stat-value gw-stat-value-text">@(string.IsNullOrEmpty(currentTerm) ? "Not set" : currentTerm)</div>
        <div class="gw-stat-label">Current term</div>
    </div>
</section>

<div class="gw-toolbar gw-acct-toolbar">
    @Html.ActionLink("Add user", "CreateUser", "Admin", null, new { @class = "gw-btn" })
    <button type="button" class="gw-btn gw-btn-outline" data-import-open hidden>Import students</button>
    @Html.ActionLink("Academic terms", "Terms", "Admin", null, new { @class = "gw-btn gw-btn-outline gw-acct-toolbar-end" })
</div>

<section class="gw-panel gw-accounts" aria-labelledby="gw-accounts-title">
    <div class="gw-panel-head">
        <h2 class="gw-panel-title" id="gw-accounts-title">Users</h2>
    </div>

    @* Tabs, filters and paging work on the accounts already listed below (the real accounts from the
       database). Each account's role comes from the server, so a new account shows up under its role
       automatically. Hidden until the script runs; without JavaScript the full table is shown. *@
    <div class="gw-panel-body gw-acct-controls" id="gw-acct-controls" hidden>
        <div class="gw-acct-tabs" role="tablist" aria-label="Accounts by role">
            <button type="button" class="gw-acct-tab" role="tab" aria-selected="true" aria-controls="gw-acct-table" data-role-tab="">
                All <span class="gw-acct-tab-count">@users.Count</span>
            </button>
            <button type="button" class="gw-acct-tab" role="tab" aria-selected="false" aria-controls="gw-acct-table" data-role-tab="@GradeWise.Models.Roles.Administrator" tabindex="-1">
                Administrators <span class="gw-acct-tab-count">@byRole[GradeWise.Models.Roles.Administrator]</span>
            </button>
            <button type="button" class="gw-acct-tab" role="tab" aria-selected="false" aria-controls="gw-acct-table" data-role-tab="@GradeWise.Models.Roles.Faculty" tabindex="-1">
                Faculty <span class="gw-acct-tab-count">@byRole[GradeWise.Models.Roles.Faculty]</span>
            </button>
            <button type="button" class="gw-acct-tab" role="tab" aria-selected="false" aria-controls="gw-acct-table" data-role-tab="@GradeWise.Models.Roles.Student" tabindex="-1">
                Students <span class="gw-acct-tab-count">@byRole[GradeWise.Models.Roles.Student]</span>
            </button>
        </div>

        <div class="gw-acct-filters" role="search" aria-label="Filter accounts">
            <div class="gw-acct-filter gw-acct-filter-search">
                <label for="gw-acct-search">Search</label>
                <input type="search" id="gw-acct-search" class="gw-inline-select" placeholder="Name, ID or email" autocomplete="off" spellcheck="false" />
            </div>
            <div class="gw-acct-filter">
                <label for="gw-acct-status">Status</label>
                <select id="gw-acct-status" class="gw-inline-select">
                    <option value="">All statuses</option>
                    <option value="active">Active</option>
                    <option value="disabled">Disabled</option>
                </select>
            </div>
            <button type="button" class="gw-btn gw-btn-small gw-btn-outline" id="gw-acct-clear">Clear filters</button>
        </div>
    </div>

    <div class="gw-acct-resultbar" id="gw-acct-resultbar" hidden>
        <div class="gw-acct-pager" aria-label="Pages">
            <span class="gw-acct-range" id="gw-acct-range" aria-live="polite"></span>
            <button type="button" class="gw-acct-pagebtn" data-page-step="-1" aria-label="Previous page" title="Previous page">
                <span aria-hidden="true">&lsaquo;</span>
            </button>
            <button type="button" class="gw-acct-pagebtn" data-page-step="1" aria-label="Next page" title="Next page">
                <span aria-hidden="true">&rsaquo;</span>
            </button>
        </div>
        <div class="gw-acct-sortbox">
            <label for="gw-acct-sort">Sort by</label>
            <select id="gw-acct-sort" class="gw-inline-select">
                <option value="role">Role, then name</option>
                <option value="name-asc">Name, A to Z</option>
                <option value="name-desc">Name, Z to A</option>
                <option value="id-asc">ID, A to Z</option>
                <option value="newest">Newest first</option>
                <option value="oldest">Oldest first</option>
            </select>
            <label for="gw-acct-size">Show</label>
            <select id="gw-acct-size" class="gw-inline-select">
                <option value="10">10</option>
                <option value="25">25</option>
                <option value="50">50</option>
            </select>
        </div>
    </div>

    <div class="gw-table-wrap">
        <table class="gw-table gw-acct-table" id="gw-acct-table">
            <colgroup>
                <col class="gw-acct-col-name" />
                <col class="gw-acct-col-id" />
                <col class="gw-acct-col-email" />
                <col class="gw-acct-col-role" />
                <col class="gw-acct-col-status" />
                <col class="gw-acct-col-actions" />
            </colgroup>
            <thead>
                <tr>
                    <th scope="col">Name</th>
                    <th scope="col" class="gw-acct-cell-id">ID</th>
                    <th scope="col" class="gw-acct-cell-email">Email</th>
                    <th scope="col" class="gw-acct-cell-role">Role</th>
                    <th scope="col">Status</th>
                    <th scope="col" class="gw-acct-cell-actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in users)
                {
                    var isMe = string.Equals(u.StudentNo, meLogin, StringComparison.OrdinalIgnoreCase);
                    var nameParts = (u.FullName ?? "").Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
                    var initials = nameParts.Length == 0 ? "?" : (nameParts[0].Substring(0, 1) + (nameParts.Length > 1 ? nameParts[nameParts.Length - 1].Substring(0, 1) : "")).ToUpperInvariant();
                    var roleClass = u.Role == GradeWise.Models.Roles.Administrator ? "admin" : u.Role == GradeWise.Models.Roles.Faculty ? "faculty" : "student";
                    <tr data-acct-row
                        data-name="@u.FullName"
                        data-login="@u.StudentNo"
                        data-email="@u.Email"
                        data-role="@u.Role"
                        data-status="@(u.IsActive ? "active" : "disabled")"
                        data-created="@u.CreatedAt.ToString("yyyy-MM-ddTHH:mm:ss")"
                        data-role-order="@Array.IndexOf(roles, u.Role)">
                        <td>
                            <div class="gw-acct-person">
                                <span class="gw-acct-avatar gw-acct-avatar-@roleClass" aria-hidden="true">@initials</span>
                                <span class="gw-acct-person-text">
                                    <span class="gw-acct-name">
                                        @u.FullName
                                        @if (isMe)
                                        {
                                            <span class="gw-muted">(you)</span>
                                        }
                                    </span>
                                    <span class="gw-acct-sub gw-acct-sub-id"><code class="gw-acct-id">@u.StudentNo</code></span>
                                    <span class="gw-acct-sub gw-acct-sub-email">@u.Email</span>
                                    <span class="gw-acct-sub gw-acct-sub-role"><span class="gw-badge gw-acct-role gw-acct-role-@roleClass">@u.Role</span></span>
                                </span>
                            </div>
                        </td>
                        <td class="gw-acct-cell-id"><code class="gw-acct-id">@u.StudentNo</code></td>
                        <td class="gw-acct-cell-email"><span class="gw-acct-email">@u.Email</span></td>
                        <td class="gw-acct-cell-role"><span class="gw-badge gw-acct-role gw-acct-role-@roleClass">@u.Role</span></td>
                        <td>
                            <span class="gw-status @(u.IsActive ? "gw-status-active" : "gw-status-off")">@(u.IsActive ? "Active" : "Disabled")</span>
                        </td>
                        <td class="gw-acct-cell-actions">
                            <div class="gw-row-actions">
                                @* All account actions live in the Edit modal below; the row only carries what it needs. *@
                                <button type="button" class="gw-btn gw-btn-small gw-btn-outline"
                                        aria-haspopup="dialog"
                                        aria-label="Edit account for @u.FullName"
                                        data-account-edit
                                        data-name="@u.FullName"
                                        data-login="@u.StudentNo"
                                        data-role="@u.Role"
                                        data-active="@(u.IsActive ? "true" : "false")"
                                        data-me="@(isMe ? "true" : "false")"
                                        data-set-active-url="@Url.Action("SetActive", "Admin", new { id = u.Id })"
                                        data-reset-url="@Url.Action("ResetPassword", "Admin", new { id = u.Id })"
                                        data-delete-url="@Url.Action("DeleteUser", "Admin", new { id = u.Id })"
                                        data-delete-blocked="@(deleteBlockers.ContainsKey(u.Id) ? deleteBlockers[u.Id] : "")">Edit</button>
                            </div>
                        </td>
                    </tr>
                }
                @if (users.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="gw-empty">No accounts yet. Use Add user to create one.</td>
                    </tr>
                }
                <tr id="gw-acct-empty" hidden>
                    <td colspan="6" class="gw-empty">
                        <span id="gw-acct-empty-text">No accounts match these filters.</span>
                        <button type="button" class="gw-acct-linkbtn" data-acct-clear>Clear filters</button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="gw-acct-footbar" id="gw-acct-footbar" hidden>
        <span id="gw-acct-pageinfo"></span>
        <div class="gw-acct-pager">
            <button type="button" class="gw-acct-pagebtn" data-page-step="-1" aria-label="Previous page" title="Previous page">
                <span aria-hidden="true">&lsaquo;</span>
            </button>
            <button type="button" class="gw-acct-pagebtn" data-page-step="1" aria-label="Next page" title="Next page">
                <span aria-hidden="true">&rsaquo;</span>
            </button>
        </div>
    </div>
</section>

@* ---------- Edit account modal ----------
   One shared modal, filled from the clicked row's Edit button (data-* attributes) by the script below.
   Every action is a normal POST to an existing AdminController action, so the server still checks the
   administrator role, the anti-forgery token, and "not your own account" for each one. After the action
   the controller redirects back here and the table, counts and messages show the saved state. *@
<div id="gw-account-modal" class="gw-modal-backdrop" hidden>
    <div class="gw-panel gw-card-raised gw-modal-card" role="dialog" aria-modal="true" aria-labelledby="gw-acct-title" aria-describedby="gw-acct-meta">
        <div class="gw-panel-head">
            <h2 id="gw-acct-title" class="gw-panel-title">Edit account</h2>
        </div>
        <div class="gw-modal-top">
            <div class="gw-modal-meta gw-modal-meta-stack" id="gw-acct-meta">
                <strong class="gw-profile-name" data-acct-field="name"></strong>
                <span>ID: <span data-acct-field="login"></span></span>
                <span>Role: <span class="gw-badge gw-acct-role" data-acct-role-badge></span> <span class="gw-acct-role-fixed">fixed</span></span>
                <span>Status: <span class="gw-status" data-acct-field="status"></span></span>
            </div>
            <button type="button" class="gw-iconbtn gw-modal-close" data-modal-close aria-label="Close" title="Close">
                <img src="@Url.Content("~/Content/img/icons/close.svg")" alt="" width="20" height="20" />
            </button>
        </div>

        <div class="gw-panel-body gw-editinfo-body">
            @* The role is set when the account is created and cannot be changed here. *@
            <p class="gw-muted gw-small gw-acct-role-note">
                The role was set when this account was created and cannot be changed.
            </p>

            @* ----- Disable / Enable ----- *@
            <section class="gw-editinfo-section" aria-labelledby="gw-acct-access-h">
                <h3 id="gw-acct-access-h" class="gw-editinfo-heading">Account access</h3>
                <p class="gw-muted gw-editinfo-current" data-acct-access-text></p>

                <p class="gw-muted gw-editinfo-current" data-acct-self-note hidden>
                    You cannot disable or delete your own account. Ask another administrator.
                </p>

                <form method="post" action="" data-acct-form="access">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="active" value="" data-acct-active-input />
                    <div class="gw-form-buttons">
                        <button type="submit" class="gw-btn gw-btn-danger" data-acct-btn="disable"
                                data-confirm-title="Disable this account?"
                                data-confirm-ok="Disable account"
                                data-confirm-tone="danger">Disable account</button>
                        <button type="submit" class="gw-btn" data-acct-btn="enable"
                                data-confirm-title="Enable this account?"
                                data-confirm-ok="Enable account">Enable account</button>
                    </div>
                </form>
            </section>

            @* ----- Reset password ----- *@
            <section class="gw-editinfo-section" aria-labelledby="gw-acct-reset-h">
                <h3 id="gw-acct-reset-h" class="gw-editinfo-heading">Reset password</h3>
                <p class="gw-muted gw-editinfo-current">
                    Creates a new temporary password. The old password stops working right away.
                    The new one is emailed to the user, who must change it at the next sign-in.
                </p>
                <form method="post" action="" data-acct-form="reset">
                    @Html.AntiForgeryToken()
                    <div class="gw-form-buttons">
                        <button type="submit" class="gw-btn gw-btn-outline" data-acct-btn="reset"
                                data-confirm-title="Reset password?"
                                data-confirm-ok="Reset password">Reset password</button>
                    </div>
                </form>
            </section>

            @* ----- Delete ----- *@
            <section class="gw-editinfo-section" aria-labelledby="gw-acct-delete-h" data-acct-delete-section>
                <h3 id="gw-acct-delete-h" class="gw-editinfo-heading">Delete account</h3>

                @* Shown instead of the form when the account cannot be deleted; filled by the script. *@
                <div class="gw-alert gw-alert-info" role="note" data-acct-delete-blocked hidden>
                    <strong>This account cannot be deleted.</strong>
                    <span data-acct-delete-reason></span>
                </div>
                <div data-acct-delete-allowed>
                    <div class="gw-alert gw-alert-warn" role="note">
                        Deleting is permanent and cannot be undone. The account is removed from course rosters,
                        and its empty grade records and notifications are deleted. If the user only needs to be
                        blocked for now, disable the account instead.
                    </div>
                    <form method="post" action="" data-acct-form="delete">
                        @Html.AntiForgeryToken()
                        <p class="gw-muted gw-editinfo-current" id="gw-acct-delete-hint">
                            To confirm, type the account ID <strong data-acct-field="login"></strong> below.
                        </p>
                        <div class="gw-field">
                            <label for="gw-acct-delete-confirm">Account ID</label>
                            <input type="text" id="gw-acct-delete-confirm" name="confirmLoginId" maxlength="50"
                                   aria-describedby="gw-acct-delete-hint"
                                   autocomplete="off" autocapitalize="off" spellcheck="false" data-acct-delete-input />
                        </div>
                        <div class="gw-form-buttons">
                            <button type="submit" class="gw-btn gw-btn-danger" data-acct-btn="delete" disabled
                                    data-confirm-title="Delete this account permanently?"
                                    data-confirm-ok="Delete account"
                                    data-confirm-tone="danger">Delete account</button>
                        </div>
                    </form>
                </div>
            </section>
        </div>

        <div class="gw-modal-foot">
            <button type="button" class="gw-btn gw-btn-outline" data-modal-close>Close</button>
        </div>
    </div>
</div>

@* ---------- Import students modal ----------
   Reads a CSV or Excel (.xlsx) file in the browser, checks every row with the same rules as Add user,
   then creates the valid rows one at a time through the existing CreateUser action (the same POST the
   Add user form makes, so the server still validates each account, rejects duplicates and emails each
   student a temporary password). Nothing is saved in the browser. *@
<div id="gw-import-modal" class="gw-modal-backdrop" hidden>
    <div class="gw-panel gw-card-raised gw-modal-card gw-import-card" role="dialog" aria-modal="true" aria-labelledby="gw-import-title" aria-describedby="gw-import-intro">
        <div class="gw-panel-head">
            <h2 id="gw-import-title" class="gw-panel-title">Import students</h2>
        </div>
        <div class="gw-modal-top">
            <p class="gw-muted gw-import-intro" id="gw-import-intro">
                Add a whole class section at once from a CSV or Excel file. Each valid row becomes a student
                account, and each student is emailed a temporary password.
            </p>
            <button type="button" class="gw-iconbtn gw-modal-close" data-import-close aria-label="Close" title="Close">
                <img src="@Url.Content("~/Content/img/icons/close.svg")" alt="" width="20" height="20" />
            </button>
        </div>

        <div class="gw-panel-body gw-import-body">
            <form id="gw-import-form" action="@Url.Action("CreateUser", "Admin")" method="post" novalidate>
                @Html.AntiForgeryToken()

                <div class="gw-import-pick">
                    <div class="gw-import-field">
                        <label for="gw-import-section">Section <span class="gw-import-opt">optional</span></label>
                        <input type="text" id="gw-import-section" class="gw-inline-select" maxlength="40" placeholder="e.g. SBIT-3D" autocomplete="off" />
                    </div>
                    <div class="gw-import-field gw-import-field-file">
                        <label for="gw-import-file">File <span class="gw-import-opt">.csv or .xlsx</span></label>
                        <input type="file" id="gw-import-file" accept=".csv,.xlsx,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
                    </div>
                </div>

                <details class="gw-import-help">
                    <summary>File format and template</summary>
                    <p>The first row must be the column names. Columns can be in any order:</p>
                    <ul>
                        <li><strong>student_number</strong> (YY-0000, e.g. 26-0001), <strong>first_name</strong>, <strong>last_name</strong>, <strong>email</strong> are required.</li>
                        <li><strong>middle_name</strong> and <strong>suffix</strong> (Jr., Sr., II, III, IV, V) are optional.</li>
                    </ul>
                    <button type="button" class="gw-btn gw-btn-small gw-btn-outline" data-import-template>Download CSV template</button>
                </details>

                <div class="gw-import-note">
                    <span class="gw-import-tag">Note</span>
                    The section name labels this import only. Accounts do not store a section yet.
                </div>
            </form>

            <div class="gw-alert" role="alert" data-import-error hidden></div>

            <div class="gw-import-results" data-import-results hidden>
                <div class="gw-import-summary" aria-live="polite">
                    <span class="gw-import-chip gw-import-chip-ok"><strong data-import-count="ready">0</strong> ready</span>
                    <span class="gw-import-chip gw-import-chip-bad"><strong data-import-count="problem">0</strong> with problems</span>
                    <span class="gw-import-chip gw-import-chip-done" data-import-done-chip hidden><strong data-import-count="created">0</strong> created</span>
                    <span class="gw-import-chip gw-import-chip-bad" data-import-failed-chip hidden><strong data-import-count="failed">0</strong> failed</span>
                </div>

                <div class="gw-import-progress" data-import-progress hidden>
                    <div class="gw-import-bar"><span data-import-bar></span></div>
                    <p class="gw-import-progress-text" data-import-progress-text aria-live="polite"></p>
                </div>

                <div class="gw-import-filter">
                    <label><input type="checkbox" data-import-only-problems /> Show only rows that need attention</label>
                </div>

                <div class="gw-table-wrap gw-import-tablewrap">
                    <table class="gw-table gw-import-table">
                        <thead>
                            <tr>
                                <th scope="col">Row</th>
                                <th scope="col">Student no.</th>
                                <th scope="col">Name</th>
                                <th scope="col" class="gw-import-cell-email">Email</th>
                                <th scope="col">Result</th>
                            </tr>
                        </thead>
                        <tbody data-import-rows></tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="gw-modal-foot gw-import-foot">
            <button type="button" class="gw-btn gw-btn-outline gw-btn-small" data-import-close>Close</button>
            <button type="button" class="gw-btn gw-btn-outline gw-btn-small" data-import-download hidden>Download rows to fix</button>
            <button type="button" class="gw-btn gw-btn-outline gw-btn-small" data-import-stop hidden>Stop</button>
            <button type="button" class="gw-btn gw-btn-small" data-import-run disabled>Import students</button>
            <button type="button" class="gw-btn gw-btn-small" data-import-refresh hidden>Show new accounts</button>
        </div>
    </div>
</div>

@section scripts {
    @* The page script is in Scripts/admin-accounts.js. *@
    <script src="@Url.Content("~/Scripts/admin-accounts.js")?v=@System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Scripts/admin-accounts.js")).Ticks"></script>
}
