@model IEnumerable<GradeWise.Models.AcademicTerm>
@functions {
    // Server-side display details, used for the first render and when JavaScript is off.
    // Semester and academic year are read from the saved name ("1st Semester, S.Y. 2026-2027").
    public class TermRow
    {
        public GradeWise.Models.AcademicTerm Term;
        public string Semester;       // "1st Semester", "2nd Semester" or "Summer"; null if the name has another format
        public string AcademicYear;   // "2026-2027"; null if unknown
        public int Order;             // sort key (later terms are larger); 0 if unknown
    }

    private static readonly System.Text.RegularExpressions.Regex TermPattern = new System.Text.RegularExpressions.Regex(
        @"^\s*(1st Semester|2nd Semester|Summer)(?: Term)?\s*,\s*[SA]\.?\s*Y\.?\s*(\d{4})\s*-\s*(\d{4})\s*$",
        System.Text.RegularExpressions.RegexOptions.IgnoreCase);

    public static TermRow ReadTerm(GradeWise.Models.AcademicTerm term)
    {
        var row = new TermRow { Term = term };
        var m = TermPattern.Match(term.Name ?? string.Empty);
        if (m.Success)
        {
            var sem = m.Groups[1].Value.ToLowerInvariant();
            int semIndex = sem.StartsWith("1") ? 1 : sem.StartsWith("2") ? 2 : 3;
            row.Semester = semIndex == 1 ? "1st Semester" : semIndex == 2 ? "2nd Semester" : "Summer";
            row.AcademicYear = m.Groups[2].Value + "-" + m.Groups[3].Value;
            row.Order = int.Parse(m.Groups[2].Value) * 10 + semIndex;
        }
        return row;
    }
}
@{
    ViewBag.Title = "Academic terms";

    var message = TempData["Message"] as string;
    var error = TempData["Error"] as string;

    var rows = Model.Select(ReadTerm).OrderByDescending(x => x.Order).ToList();

    // Academic years offered in the form: last year to three years ahead, plus any year already in use.
    var thisYear = DateTime.Now.Year;
    var ayOptions = Enumerable.Range(thisYear - 1, 5).Select(x => x + "-" + (x + 1))
        .Union(rows.Where(x => x.AcademicYear != null).Select(x => x.AcademicYear))
        .Distinct().OrderBy(x => x).ToList();

    // Why a term cannot be deleted (in use, or courses use it). AdminController.DeleteTerm enforces the same rules.
    var deleteBlockers = ViewBag.TermDeleteBlockers as Dictionary<string, string> ?? new Dictionary<string, string>();

    // The real terms from the database, handed to the page script: id, name, isCurrent, the saved dates
    // (yyyy-MM-dd, or "" for terms saved without dates) and why the term cannot be deleted.
    Func<DateTime?, string> isoDate = d => d.HasValue ? d.Value.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture) : "";
    var termsJson = System.Web.Helpers.Json.Encode(Model.Select(x => new {
        id = x.Id, name = x.Name, isCurrent = x.IsCurrent,
        startDate = isoDate(x.StartDate), endDate = isoDate(x.EndDate),
        deleteBlocked = deleteBlockers.ContainsKey(x.Id) ? deleteBlockers[x.Id] : ""
    }).ToList());
    // Dates in the table rendered by the server (before the script runs, or without JavaScript).
    Func<DateTime?, string> shownDate = d => d.HasValue ? d.Value.ToString("MMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture) : "Not set";
}

<div class="gw-terms"
     data-terms="@termsJson"
     data-set-current-url="@Url.Action("SetCurrentTerm", "Admin")"
     data-delete-url="@Url.Action("DeleteTerm", "Admin")"
     data-edit-url="@Url.Action("EditTerm", "Admin")"
     data-today="@DateTime.Now.ToString("yyyy-MM-dd")">

    <h1 class="gw-page-title">Academic terms</h1>
    <p class="gw-page-sub">Add each term with its dates. A term can be made current while today falls within its dates.</p>

    @* Results of the last saved action. gw-modal.js turns these into toasts; without JavaScript they stay as banners. *@
    @if (!string.IsNullOrEmpty(error))
    {
        <div class="gw-alert" role="alert" data-gw-flash="error">@error</div>
    }
    @if (!string.IsNullOrEmpty(message))
    {
        <div class="gw-alert gw-alert-ok" role="status" data-gw-flash="success">@message</div>
    }

    @* Shown once the page script runs: explains which actions are saved and which are preview-only. *@
    <div class="gw-terms-preview-note" id="terms-preview-note" hidden>
        <span class="gw-terms-pending-tag">Preview</span>
        <span><strong>Add term</strong>, <strong>Edit</strong> (dates included), <strong>Make current</strong> and <strong>Delete</strong> are saved. Archiving and restoring are kept on this page only and reset when the page reloads.</span>
    </div>

    @* Shown by the script when the term in use does not match today's date. *@
    <div class="gw-terms-mismatch" id="terms-mismatch" role="note" hidden></div>

    <div class="gw-toolbar">
        @Html.ActionLink("Back to accounts", "Index", "Admin", null, new { @class = "gw-btn gw-btn-outline" })
        <button type="button" class="gw-btn" data-term-add hidden>Add term</button>
    </div>

    <noscript>
        @* Without JavaScript the term form cannot open, so offer the basic form. *@
        <section class="gw-panel gw-form-narrow">
            <div class="gw-panel-head"><h2 class="gw-panel-title">Add a term</h2></div>
            <div class="gw-panel-body">
                @using (Html.BeginForm("AddTerm", "Admin", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <div class="gw-field">
                        <label for="name-basic">Term name</label>
                        <input type="text" id="name-basic" name="name" maxlength="80" required placeholder="1st Semester, S.Y. 2027-2028" />
                    </div>
                    <button type="submit" class="gw-btn">Add term</button>
                }
            </div>
        </section>
    </noscript>

    <section class="gw-panel gw-terms-panel">
        <div class="gw-panel-head">
            <h2 class="gw-panel-title">Terms</h2>
        </div>

        <div class="gw-panel-body">
            <div class="gw-terms-tabs" role="tablist" aria-label="Term lists" id="term-tabs" hidden>
                <button type="button" class="gw-terms-tab" role="tab" id="tab-active" aria-controls="panel-active" aria-selected="true">
                    Active terms <span class="gw-terms-tab-count" data-count="active">@rows.Count</span>
                </button>
                <button type="button" class="gw-terms-tab" role="tab" id="tab-archived" aria-controls="panel-archived" aria-selected="false" tabindex="-1">
                    Archived terms <span class="gw-terms-tab-count" data-count="archived">0</span>
                </button>
            </div>

            <div class="gw-terms-filters" id="term-filters" hidden>
                <div class="gw-terms-filter gw-terms-filter-search">
                    <label for="filter-search">Search</label>
                    <input type="search" id="filter-search" class="gw-inline-select" placeholder="Search terms" autocomplete="off" />
                </div>
                <div class="gw-terms-filter">
                    <label for="filter-year">Academic year</label>
                    <select id="filter-year" class="gw-inline-select">
                        <option value="">All academic years</option>
                    </select>
                </div>
                <div class="gw-terms-filter">
                    <label for="filter-semester">Semester</label>
                    <select id="filter-semester" class="gw-inline-select">
                        <option value="">All semesters</option>
                        <option value="1st Semester">1st Semester</option>
                        <option value="2nd Semester">2nd Semester</option>
                        <option value="Summer">Summer</option>
                    </select>
                </div>
                <div class="gw-terms-filter" data-filter-status-wrap>
                    <label for="filter-status">Status</label>
                    <select id="filter-status" class="gw-inline-select">
                        <option value="">All statuses</option>
                        <option value="current">Current</option>
                        <option value="upcoming">Upcoming</option>
                        <option value="completed">Completed</option>
                        <option value="nodates">No dates</option>
                    </select>
                </div>
                <button type="button" class="gw-btn gw-btn-small gw-btn-outline" id="filter-reset">Clear filters</button>
                <p class="gw-terms-count" id="filter-count" aria-live="polite"></p>
            </div>
        </div>

        @* ---------- Active terms (rows are redrawn by the script from the term store) ---------- *@
        <div class="gw-terms-tabpanel" role="tabpanel" id="panel-active" aria-labelledby="tab-active" data-list="active">
            <div class="gw-table-wrap">
                <table class="gw-table gw-terms-table">
                    <thead>
                        <tr>
                            <th scope="col">Academic year</th>
                            <th scope="col" class="gw-terms-col-sem">Semester</th>
                            <th scope="col" class="gw-terms-col-date">Start date</th>
                            <th scope="col" class="gw-terms-col-date">End date</th>
                            <th scope="col" class="gw-terms-col-status">Status</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody data-tbody="active">
                        @if (rows.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="gw-empty">No terms yet. Use Add term to create one.</td>
                            </tr>
                        }
                        @foreach (var r in rows)
                        {
                            var t = r.Term;
                            <tr class="@(t.IsCurrent ? "gw-term-current" : "")">
                                <td><span class="gw-term-box">@(r.AcademicYear == null ? t.Name : "A.Y. " + r.AcademicYear)</span></td>
                                <td class="gw-terms-col-sem">@(r.Semester ?? "-")</td>
                                <td class="gw-terms-col-date@(t.StartDate.HasValue ? "" : " gw-terms-unset")">@shownDate(t.StartDate)</td>
                                <td class="gw-terms-col-date@(t.EndDate.HasValue ? "" : " gw-terms-unset")">@shownDate(t.EndDate)</td>
                                <td class="gw-terms-col-status">
                                    @if (t.IsCurrent)
                                    {
                                        <span class="gw-terms-inuse">In use</span>
                                    }
                                </td>
                                <td>
                                    @if (!t.IsCurrent)
                                    {
                                        using (Html.BeginForm("SetCurrentTerm", "Admin", new { id = t.Id }, FormMethod.Post, new { @class = "gw-row-form" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="gw-btn gw-btn-small">Make current</button>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @* ---------- Archived terms ---------- *@
        <div class="gw-terms-tabpanel" role="tabpanel" id="panel-archived" aria-labelledby="tab-archived" data-list="archived" hidden>
            <div class="gw-table-wrap">
                <table class="gw-table gw-terms-table">
                    <thead>
                        <tr>
                            <th scope="col">Academic year</th>
                            <th scope="col" class="gw-terms-col-sem">Semester</th>
                            <th scope="col" class="gw-terms-col-date">Start date</th>
                            <th scope="col" class="gw-terms-col-date">End date</th>
                            <th scope="col" class="gw-terms-col-status">Archived on</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody data-tbody="archived">
                        <tr>
                            <td colspan="6" class="gw-empty">No archived terms.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    @* ---------- Add / edit term (one form for both) ---------- *@
    <div id="term-form-modal" class="gw-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="term-form-title" hidden>
        <div class="gw-panel gw-card-raised gw-modal-card gw-terms-modal gw-terms-form-modal">
            <div class="gw-panel-head">
                <h2 id="term-form-title" class="gw-panel-title">Add a term</h2>
            </div>
            @using (Html.BeginForm("AddTerm", "Admin", FormMethod.Post, new { id = "term-form", novalidate = "novalidate" }))
            {
                @Html.AntiForgeryToken()
                <div class="gw-panel-body gw-terms-form-body">
                    <div class="gw-terms-add-fields">
                        <div class="gw-terms-control">
                            <label for="term-year">Academic year <span class="gw-terms-req">required</span></label>
                            <select id="term-year" class="gw-inline-select" aria-required="true" aria-describedby="term-feedback">
                                <option value="">Choose an academic year</option>
                                @foreach (var y in ayOptions)
                                {
                                    <option value="@y">A.Y. @y</option>
                                }
                            </select>
                        </div>
                        <div class="gw-terms-control">
                            <label for="term-semester">Semester <span class="gw-terms-req">required</span></label>
                            <select id="term-semester" class="gw-inline-select" aria-required="true" aria-describedby="term-feedback">
                                <option value="">Choose a semester</option>
                                <option value="1st Semester">1st Semester</option>
                                <option value="2nd Semester">2nd Semester</option>
                                <option value="Summer">Summer</option>
                            </select>
                        </div>
                        <div class="gw-terms-control">
                            <label for="term-start">Start date <span class="gw-terms-req">required</span></label>
                            <input type="date" id="term-start" name="startDate" class="gw-inline-select" aria-required="true" aria-describedby="term-feedback term-dates-hint" />
                        </div>
                        <div class="gw-terms-control">
                            <label for="term-end">End date <span class="gw-terms-req">required</span></label>
                            <input type="date" id="term-end" name="endDate" class="gw-inline-select" aria-required="true" aria-describedby="term-feedback term-dates-hint" />
                        </div>

                        <p class="gw-terms-hint" id="term-dates-hint">The end date must be after the start date. Both must fall within the academic year and must not overlap another active term.</p>

                        <p class="gw-terms-preview">
                            <span class="gw-terms-preview-label">Name</span>
                            <strong id="term-preview">Choose an academic year and semester</strong>
                        </p>
                    </div>

                    <p class="gw-terms-form-note" id="term-form-note"></p>

                    <div class="gw-alert gw-terms-feedback" id="term-feedback" role="alert" hidden></div>

                    @* The name and the dates (startDate, endDate) are sent to AddTerm, or to EditTerm/{id} when editing
                       (the script sets the form's action). The server checks the dates again before saving. *@
                    <input type="hidden" name="name" id="term-name" />
                </div>
                <div class="gw-modal-foot gw-terms-modal-foot">
                    <button type="button" class="gw-btn gw-btn-outline gw-btn-small" data-modal-close>Cancel</button>
                    <button type="submit" class="gw-btn gw-btn-small" id="term-form-submit">Add term</button>
                </div>
            }
        </div>
    </div>

    @* ---------- View details (editing happens from here) ---------- *@
    <div id="term-view" class="gw-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="term-view-title" hidden>
        <div class="gw-panel gw-card-raised gw-modal-card gw-terms-modal">
            <div class="gw-panel-head">
                <h2 id="term-view-title" class="gw-panel-title">Term details</h2>
            </div>
            <div class="gw-panel-body">
                <p class="gw-terms-modal-name"><span class="gw-term-box" data-slot="name"></span></p>
                <dl class="gw-facts">
                    <dt>Academic year</dt>
                    <dd data-slot="year"></dd>
                    <dt>Semester</dt>
                    <dd data-slot="semester"></dd>
                    <dt>Start date</dt>
                    <dd data-slot="start"></dd>
                    <dt>End date</dt>
                    <dd data-slot="end"></dd>
                    <dt>Status</dt>
                    <dd><span class="gw-status gw-term-status" data-slot="status"></span> <span class="gw-terms-inuse" data-slot="inuse" hidden>In use</span></dd>
                    <dt data-slot-archived>Archived on</dt>
                    <dd data-slot-archived data-slot="archived"></dd>
                </dl>
                <p class="gw-muted gw-small gw-terms-modal-note" data-slot="note"></p>
            </div>
            <div class="gw-modal-foot gw-terms-modal-foot">
                <button type="button" class="gw-btn gw-btn-outline gw-btn-small" data-modal-close>Close</button>
                <button type="button" class="gw-btn gw-btn-outline gw-btn-small" data-view-action="edit">Edit</button>
                <button type="button" class="gw-btn gw-btn-outline gw-btn-small" data-view-action="restore">Restore</button>
                <button type="button" class="gw-btn gw-btn-small" data-view-action="current">Make current</button>
            </div>
        </div>
    </div>

    @* ---------- Manage (archive or delete one active term) ---------- *@
    <div id="term-manage" class="gw-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="term-manage-title" hidden>
        <div class="gw-panel gw-card-raised gw-modal-card gw-terms-modal">
            <div class="gw-panel-head">
                <h2 id="term-manage-title" class="gw-panel-title">Manage term</h2>
            </div>
            <div class="gw-panel-body">
                <p class="gw-terms-modal-name"><span class="gw-term-box" data-manage-slot="name"></span></p>

                @* ----- Archive ----- *@
                <section class="gw-editinfo-section" aria-labelledby="term-manage-archive-h">
                    <h3 id="term-manage-archive-h" class="gw-editinfo-heading">Archive term</h3>
                    <p class="gw-muted gw-editinfo-current">Moves the term to Archived terms. Its courses, grades and history are kept, and you can restore it at any time.</p>
                    <div class="gw-alert gw-alert-info" role="note" data-manage-archive-blocked hidden>
                        <strong>This term cannot be archived.</strong>
                        <span>It is the term in use. Make another term current first.</span>
                    </div>
                    <div class="gw-form-buttons">
                        <button type="button" class="gw-btn gw-btn-small gw-btn-outline gw-terms-btn-archive" data-manage-action="archive">Archive term</button>
                    </div>
                </section>

                @* ----- Delete (only for terms without records) ----- *@
                <section class="gw-editinfo-section" aria-labelledby="term-manage-delete-h">
                    <h3 id="term-manage-delete-h" class="gw-editinfo-heading">Delete term</h3>
                    @* Shown instead of the button when the term cannot be deleted; filled by the script. *@
                    <div class="gw-alert gw-alert-info" role="note" data-manage-delete-blocked hidden>
                        <strong>This term cannot be deleted.</strong>
                        <span data-manage-slot="delete-reason"></span>
                    </div>
                    <div data-manage-delete-allowed>
                        <p class="gw-muted gw-editinfo-current">No courses, grades or history use this term. Deleting removes it from the database permanently. This cannot be undone.</p>
                        <div class="gw-form-buttons">
                            <button type="button" class="gw-btn gw-btn-small gw-btn-danger" data-manage-action="delete">Delete term</button>
                        </div>
                    </div>
                </section>
            </div>
            <div class="gw-modal-foot gw-terms-modal-foot">
                <button type="button" class="gw-btn gw-btn-outline gw-btn-small" data-modal-close>Close</button>
            </div>
        </div>
    </div>

    @* Posts Delete to AdminController.DeleteTerm (the script sets the URL). *@
    @using (Html.BeginForm("Terms", "Admin", FormMethod.Post, new { id = "term-delete-form", hidden = "hidden" }))
    {
        @Html.AntiForgeryToken()
    }

    @* Posts "Make current" to the existing SetCurrentTerm action (the script sets the URL). *@
    @using (Html.BeginForm("Terms", "Admin", FormMethod.Post, new { id = "term-current-form", hidden = "hidden" }))
    {
        @Html.AntiForgeryToken()
    }
</div>

@section scripts {
    @* The page script is in Scripts/admin-terms.js. *@
    <script src="@Url.Content("~/Scripts/admin-terms.js")?v=@System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Scripts/admin-terms.js")).Ticks"></script>
}
