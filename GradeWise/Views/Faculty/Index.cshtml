@model GradeWise.Models.CourseListViewModel
@using GradeWise.Services
@{
    ViewBag.Title = "My courses";

    var message = TempData["Message"] as string;
    var error = TempData["Error"] as string;

    // Sticker colours cycle through the same accents the admin Accounts page uses.
    var tones = new[] { "lime", "blue", "gold", "lav", "orange" };
}

<div class="gw-faculty-courses">
<div class="gw-page-head">
    <div>
        <h1 class="gw-page-title">My courses</h1>
        <p class="gw-page-sub">Manage categories and enter scores.</p>
    </div>
    <a href="@Url.Action("CreateCourse", "Faculty")" class="gw-iconbtn gw-iconbtn-add" aria-label="Create course" title="Create course">
        <img src="@Url.Content("~/Content/img/icons/add.svg")" alt="" width="24" height="24" />
    </a>
</div>

@if (!string.IsNullOrEmpty(error))
{
    <div class="gw-alert" role="alert" data-gw-flash="error">@error</div>
}
@if (!string.IsNullOrEmpty(message))
{
    <div class="gw-alert gw-alert-ok" role="status" data-gw-flash="success">@message</div>
}

<section class="gw-stats" aria-label="Summary">
    <div class="gw-stat gw-stat-lime" data-tab="Courses">
        <div class="gw-stat-value">@Model.Courses.Count</div>
        <div class="gw-stat-label">Courses</div>
    </div>
    <div class="gw-stat gw-stat-blue" data-tab="Students">
        <div class="gw-stat-value">@Model.StudentCount</div>
        <div class="gw-stat-label">Enrolled students</div>
    </div>
    <div class="gw-stat gw-stat-gold" data-tab="Missing">
        <div class="gw-stat-value">@Model.MissingScores</div>
        <div class="gw-stat-label">Scores not yet entered</div>
    </div>
</section>

<section class="gw-panel gw-fc-panel" aria-labelledby="gw-fc-title">
    <div class="gw-panel-head">
        <h2 class="gw-panel-title" id="gw-fc-title">Courses</h2>
    </div>

    @if (Model.Courses.Count == 0)
    {
        <div class="gw-panel-body gw-empty-state">
            <img src="@Url.Content("~/Content/img/stickers/mascot-cat.svg")" alt="" class="gw-empty-mascot" width="72" height="72" />
            <p class="gw-empty-title">No courses yet</p>
            <p class="gw-muted">Create a course to start entering scores.</p>
            @Html.ActionLink("Create course", "CreateCourse", "Faculty", null, new { @class = "gw-btn" })
        </div>
    }
    else
    {
        @* Search filter: hidden until faculty-courses.js runs; without JavaScript every course is listed. *@
        <div class="gw-panel-body gw-fc-controls" id="gw-fc-controls" hidden>
            <div class="gw-fc-filters" role="search" aria-label="Filter courses">
                <div class="gw-fc-filter gw-fc-filter-search">
                    <label for="gw-fc-search">Search</label>
                    <input type="search" id="gw-fc-search" class="gw-inline-select" placeholder="Course code or name" autocomplete="off" spellcheck="false" />
                </div>
                <button type="button" class="gw-btn gw-btn-small gw-btn-outline" id="gw-fc-clear">Clear filters</button>
            </div>
            <p class="gw-fc-count" id="gw-fc-count" aria-live="polite"></p>
        </div>

        <ul class="gw-collection" id="gw-fc-list">
            @for (var i = 0; i < Model.Courses.Count; i++)
            {
                var c = Model.Courses[i];
                var tone = tones[i % tones.Length];
                // Passing mark is 65: lime at 75 and above, gold from 65, orange below.
                var avgClass = !c.ClassAverage.HasValue ? "gw-fc-avg-none"
                             : c.ClassAverage.Value >= 75 ? "gw-fc-avg-high"
                             : c.ClassAverage.Value >= 65 ? "gw-fc-avg-mid"
                             : "gw-fc-avg-low";
                <li data-course-row data-search="@((c.Code + " " + c.Name + " " + c.Section).ToLowerInvariant())">
                    <div class="gw-collection-item gw-collection-row gw-fc-row gw-fc-row-@tone">
                        <span class="gw-collection-sticker gw-fc-sticker gw-fc-sticker-@tone" aria-hidden="true">@(c.Code.Length > 2 ? c.Code.Substring(0, 2) : c.Code)</span>
                        <span class="gw-collection-main">
                            <span class="gw-collection-code">@c.Code &middot; @c.Name</span>
                            <span class="gw-collection-meta gw-fc-meta">
                                <span class="gw-fc-chip gw-fc-chip-term">@c.Term</span>
                                <span class="gw-fc-chip gw-fc-chip-students">@c.StudentCount @(c.StudentCount == 1 ? "student" : "students")</span>
                                @if (string.IsNullOrWhiteSpace(c.Section))
                                {
                                    <span class="gw-fc-chip gw-fc-chip-plain">No section</span>
                                }
                                else
                                {
                                    <span class="gw-fc-chip gw-fc-chip-section">Section @c.Section</span>
                                }
                                @if (c.CategoryCount == 0)
                                {
                                    <span class="gw-status gw-status-warn">No weights set</span>
                                }
                                <span class="gw-fc-chip @avgClass">Class average @GradeCalculator.Format(c.ClassAverage) (@c.ScopeLabel)</span>
                            </span>
                        </span>
                        <a href="@Url.Action("Course", "Faculty", new { id = c.Id })" class="gw-collection-go" aria-label="Open @c.Code">
                            <img src="@Url.Content("~/Content/img/icons/chevron-right.svg")" alt="" class="gw-collection-chevron" width="20" height="20" />
                        </a>
                    </div>
                </li>
            }
            <li class="gw-fc-empty" id="gw-fc-empty" hidden>
                <span>No courses match this search.</span>
                <button type="button" class="gw-fc-linkbtn" data-fc-clear>Clear filters</button>
            </li>
        </ul>
    }
</section>
</div>

@section scripts {
    @* The page script is in Scripts/faculty-courses.js. *@
    <script src="@Url.Content("~/Scripts/faculty-courses.js")?v=@System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Scripts/faculty-courses.js")).Ticks"></script>
}
