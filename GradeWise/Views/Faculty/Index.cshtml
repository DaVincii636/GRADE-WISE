@{
    ViewBag.Title = "My courses";
}

<h1 class="gw-page-title">My courses</h1>
<p class="gw-page-sub">Set up grading categories and enter student scores.</p>

<section class="gw-stats" aria-label="Summary">
        <div class="gw-stat">
            <div class="gw-stat-value">&mdash;</div>
            <div class="gw-stat-label">Courses</div>
        </div>
        <div class="gw-stat">
            <div class="gw-stat-value">&mdash;</div>
            <div class="gw-stat-label">Enrolled students</div>
        </div>
        <div class="gw-stat">
            <div class="gw-stat-value">&mdash;</div>
            <div class="gw-stat-label">Scores not yet entered</div>
        </div>
</section>

<section class="gw-panel">
    <div class="gw-panel-head">
        <h2 class="gw-panel-title">Score entry</h2>
    </div>
    <div class="gw-table-wrap">
        <table class="gw-table">
            <thead>
                <tr>
                        <th>Student</th>
                        <th>Quizzes</th>
                        <th>Projects</th>
                        <th>Midterm</th>
                        <th>Final</th>
                        <th>Average</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td colspan="6" class="gw-empty">Create a course to start entering scores.</td>
                </tr>
            </tbody>
        </table>
    </div>
</section>
