@section scripts {
    <script>
        // Bars, slices, columns and rows open their popup through the shared component (gw-modal.js), which also
        // handles Close buttons, Esc, a click on the dark backdrop, the Tab key and returning focus.
        (function () {
            function openFrom(el) {
                var id = el.getAttribute("data-modal-target");
                if (id && window.GW) GW.modal.open(id);
            }

            document.addEventListener("click", function (e) {
                var info = e.target.closest("[data-info-toggle]");
                if (info) {
                    var box = document.getElementById(info.getAttribute("data-info-toggle"));
                    if (box) {
                        var show = box.hasAttribute("hidden");
                        if (show) box.removeAttribute("hidden"); else box.setAttribute("hidden", "");
                        info.setAttribute("aria-expanded", show ? "true" : "false");
                    }
                    return;
                }
                var trigger = e.target.closest("[data-modal-target]");
                if (trigger) openFrom(trigger);
            });

            document.addEventListener("keydown", function (e) {
                if (e.key !== "Enter" && e.key !== " ") return;
                var focused = document.activeElement;
                if (focused && focused.hasAttribute && focused.hasAttribute("data-modal-target") && focused.tagName.toLowerCase() !== "button") {
                    e.preventDefault();
                    openFrom(focused);
                }
            });
        })();

        // Hover tooltip for the charts (anything with class gw-hit and a data-tooltip).
        (function () {
            var tip = document.createElement("div");
            tip.className = "gw-tip";
            tip.setAttribute("role", "tooltip");
            tip.hidden = true;
            document.body.appendChild(tip);

            function place(x, y) {
                var w = tip.offsetWidth, h = tip.offsetHeight;
                var left = Math.max(8, Math.min(x - w / 2, window.innerWidth - w - 8));
                var top = y - h - 14;
                if (top < 8) top = y + 20;
                tip.style.left = left + "px";
                tip.style.top = top + "px";
            }

            function hit(node) {
                return node && node.closest ? node.closest(".gw-hit[data-tooltip]") : null;
            }

            document.addEventListener("mousemove", function (e) {
                var el = hit(e.target);
                if (!el) { tip.hidden = true; return; }
                tip.textContent = el.getAttribute("data-tooltip");
                tip.hidden = false;
                place(e.clientX, e.clientY);
            });
            document.addEventListener("focusin", function (e) {
                var el = hit(e.target);
                if (!el) return;
                var r = el.getBoundingClientRect();
                tip.textContent = el.getAttribute("data-tooltip");
                tip.hidden = false;
                place(r.left + r.width / 2, r.top);
            });
            document.addEventListener("focusout", function () { tip.hidden = true; });
            window.addEventListener("scroll", function () { tip.hidden = true; }, true);
            document.addEventListener("click", function (e) { if (hit(e.target)) tip.hidden = true; });
        })();
    </script>
}
