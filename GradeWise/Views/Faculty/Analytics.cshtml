@model GradeWise.Models.AnalyticsViewModel
@using GradeWise.Models
@using GradeWise.Services
@{
    ViewBag.Title = Model.Code + " analytics";
    var graded = Model.Summary.Graded;
}

<div class="gw-faculty-courses gw-fcourse gw-fpage">

<h1 class="gw-page-title">@Model.Code &middot; @Model.Name</h1>
<p class="gw-page-sub gw-fcourse-sub">
    <span class="gw-fc-chip gw-fc-chip-term">@Model.Term</span>
    <span class="gw-fc-chip gw-fc-chip-section">Class analytics</span>
    <span class="gw-fc-chip gw-fc-chip-students">@Model.StudentCount @(Model.StudentCount == 1 ? "student" : "students")</span>
</p>

<div class="gw-toolbar gw-fcourse-toolbar">
    <a href="@Url.Action("Course", "Faculty", new { id = Model.CourseId })" class="gw-iconbtn gw-iconbtn-text" title="Back to scores">
        <img src="@Url.Content("~/Content/img/icons/back.svg")" alt="" width="24" height="24" />
        <span>Back to scores</span>
    </a>
    <a href="@Url.Action("Enroll", "Faculty", new { id = Model.CourseId })" class="gw-iconbtn gw-iconbtn-text gw-tone-blue" title="Students">
        <img src="@Url.Content("~/Content/img/icons/user.svg")" alt="" width="24" height="24" />
        <span>Students</span>
    </a>
    <a href="@Url.Action("Categories", "Faculty", new { id = Model.CourseId })" class="gw-iconbtn gw-iconbtn-text gw-tone-gold" title="Categories and weights">
        <img src="@Url.Content("~/Content/img/icons/list.svg")" alt="" width="24" height="24" />
        <span>Categories</span>
    </a>
    <a href="@Url.Action("Analytics", "Faculty", new { id = Model.CourseId })" class="gw-iconbtn gw-iconbtn-text gw-tone-lav" aria-current="page" title="Analytics">
        <img src="@Url.Content("~/Content/img/icons/calendar.svg")" alt="" width="24" height="24" />
        <span>Analytics</span>
    </a>
    <a href="@Url.Action("ExportCsv", "Faculty", new { id = Model.CourseId, scope = Model.Scope })" class="gw-iconbtn gw-iconbtn-text gw-tone-lime" title="Export class record (CSV)">
        <img src="@Url.Content("~/Content/img/icons/download.svg")" alt="" width="24" height="24" />
        <span>Export CSV</span>
    </a>
</div>

<div class="gw-fcourse-scopebar">
    <div class="gw-scope-form">
        <span class="gw-fcourse-scopelabel">Grade scope</span>
        <div class="gw-scope-toggle" role="group" aria-label="Grade scope">
            @foreach (var key in GradeScopes.All)
            {
                var on = key == Model.Scope;
                <a href="@Url.Action("Analytics", "Faculty", new { id = Model.CourseId, scope = key })" class="gw-btn gw-btn-small @(on ? "gw-scope-on" : "gw-btn-outline")" aria-current="@(on ? "true" : "false")">@GradeScopes.Label(key)</a>
            }
        </div>
        <p class="gw-scope-note">Students see: @Model.CourseScopeLabel.</p>
    </div>
</div>

@if (Model.Categories.Count > 0 && !Model.WeightsOk)
{
    <div class="gw-alert gw-alert-warn" role="status">
        @Model.ScopeLabel weights total <strong>@GradeCalculator.Format(Model.WeightTotal)%</strong>, not 100%. Numbers below use them as they are.
        @Html.ActionLink("Fix weights", "Categories", "Faculty", new { id = Model.CourseId }, null)
    </div>
}

<section class="gw-stats" aria-label="Class summary">
    <div class="gw-stat gw-stat-blue" data-tab="Students">
        <div class="gw-stat-value">@Model.StudentCount</div>
        <div class="gw-stat-label">Students</div>
    </div>
    <div class="gw-stat gw-stat-lime" data-tab="Average">
        <div class="gw-stat-value">@(Model.Summary.Average.HasValue ? GradeCalculator.Format(Model.Summary.Average) + "%" : GradeCalculator.Format(Model.Summary.Average))</div>
        <div class="gw-stat-label">Class average (@Model.ScopeLabel)</div>
    </div>
    <div class="gw-stat gw-stat-lav" data-tab="Highest">
        <div class="gw-stat-value">@(Model.Summary.Highest.HasValue ? GradeCalculator.Format(Model.Summary.Highest) + "%" : GradeCalculator.Format(Model.Summary.Highest))</div>
        <div class="gw-stat-label">Highest (@Model.ScopeLabel)</div>
    </div>
    <div class="gw-stat gw-stat-orange" data-tab="Lowest">
        <div class="gw-stat-value">@(Model.Summary.Lowest.HasValue ? GradeCalculator.Format(Model.Summary.Lowest) + "%" : GradeCalculator.Format(Model.Summary.Lowest))</div>
        <div class="gw-stat-label">Lowest (@Model.ScopeLabel)</div>
    </div>
</section>

@if (Model.StudentCount > 0)
{
    <section class="gw-stats" aria-label="More statistics">
        <div class="gw-stat gw-stat-blue" data-tab="Median">
            <div class="gw-stat-value">@(Model.Median.HasValue ? GradeCalculator.Format(Model.Median) + "%" : GradeCalculator.Format(Model.Median))</div>
            <div class="gw-stat-label">Median (@Model.ScopeLabel)</div>
        </div>
        <div class="gw-stat gw-stat-lime" data-tab="Passing">
            <div class="gw-stat-value">@(Model.PassRate.HasValue ? GradeCalculator.Format(Model.PassRate) + "%" : GradeCalculator.Format(Model.PassRate))</div>
            <div class="gw-stat-label">Passing: @Model.Passing of @graded graded (64.5+)</div>
        </div>
        <div class="gw-stat gw-stat-gold" data-tab="Spread">
            <div class="gw-stat-value">@GradeCalculator.Format(Model.StdDev)</div>
            <div class="gw-stat-label">Spread (std. deviation)@(Model.Range.HasValue ? ", range " + GradeCalculator.Format(Model.Range) : "")</div>
        </div>
        <div class="gw-stat gw-stat-lav" data-tab="Entered">
            <div class="gw-stat-value">@(Model.CompletionPercent.HasValue ? GradeCalculator.Format(Model.CompletionPercent) + "%" : GradeCalculator.Format(Model.CompletionPercent))</div>
            <div class="gw-stat-label">Scores entered: @Model.ScoresEntered of @Model.ScoresExpected</div>
        </div>
    </section>
}

<section class="gw-panel gw-sr-panel">
    <div class="gw-panel-head">
        <h2 class="gw-panel-title">@Model.ScopeLabel grade distribution</h2>
    </div>
    @if (Model.StudentCount == 0)
    {
        <div class="gw-panel-body gw-empty-state">
            <img src="@Url.Content("~/Content/img/stickers/mascot-cat.svg")" alt="" class="gw-empty-mascot" width="72" height="72" />
            <p class="gw-empty-title">No students yet</p>
            <p class="gw-muted">
                @Html.ActionLink("Enroll students", "Enroll", "Faculty", new { id = Model.CourseId }, null) to see analytics.
            </p>
        </div>
    }
    else if (graded == 0)
    {
        <div class="gw-panel-body gw-empty-block">
            No scores yet, so nothing to chart.
            @Html.ActionLink("Enter scores", "Course", "Faculty", new { id = Model.CourseId }, null)
        </div>
    }
    else
    {
        <div class="gw-panel-body gw-fp-note">
            <p class="gw-hint-block gw-muted">
                Students per <strong>@Model.ScopeLabel Earned Grade</strong> range (points out of 100; ungraded work counts as 0).
                Each range includes its lower number, not its upper. <strong>Click a bar</strong> to see the students.
            </p>
        </div>
        <div class="gw-table-wrap">
            <table class="gw-table gw-dist-table">
                <caption class="gw-sr-only">Number of students per @Model.ScopeLabel Earned Grade range</caption>
                <thead>
                    <tr>
                        <th scope="col">@Model.ScopeLabel grade</th>
                        <th scope="col" class="gw-num">Students</th>
                        <th scope="col" class="gw-dist-col">Chart</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < Model.Bins.Count; i++)
                    {
                        var bin = Model.Bins[i];
                        var modalId = "gw-bin-modal-" + i;
                        var studentWord = Model.StudentCount == 1 ? "student" : "students";
                        var tooltip = bin.Label + ": " + bin.PercentText + " (" + bin.Count + " of " + Model.StudentCount + " " + studentWord + "). Click to view students";
                        <tr class="gw-dist-row" data-modal-target="@modalId" title="@tooltip">
                            <th scope="row">@bin.Label</th>
                            <td class="gw-num">@bin.Count</td>
                            <td class="gw-dist-col">
                                <div class="gw-bar-track gw-bar-clickable" role="button" tabindex="0" data-modal-target="@modalId" data-tooltip="@tooltip" aria-label="@tooltip">
                                    @if (bin.Count > 0)
                                    {
                                        <div class="gw-bar" style="width:@(GradeCalculator.Raw(bin.Percent))%">
                                            <span class="gw-bar-label">@bin.PercentText</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="gw-bar-label gw-bar-label-zero">@bin.PercentText</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    @if (Model.NotGraded > 0)
                    {
                        var notGradedModalId = "gw-bin-modal-notgraded";
                        var notGradedWord = Model.StudentCount == 1 ? "student" : "students";
                        var notGradedTip = "Not graded yet: " + Model.NotGradedPercentText + " (" + Model.NotGraded + " of " + Model.StudentCount + " " + notGradedWord + "). Click to view students";
                        <tr class="gw-dist-none gw-dist-row" data-modal-target="@notGradedModalId" title="@notGradedTip">
                            <th scope="row">Not graded yet</th>
                            <td class="gw-num">@Model.NotGraded</td>
                            <td class="gw-dist-col">
                                <div class="gw-bar-track gw-bar-clickable" role="button" tabindex="0" data-modal-target="@notGradedModalId" data-tooltip="@notGradedTip" aria-label="@notGradedTip">
                                    <div class="gw-bar" style="width:@(GradeCalculator.Raw(Model.NotGradedPercent))%">
                                        <span class="gw-bar-label">@Model.NotGradedPercentText</span>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th scope="row">Total</th>
                        <th class="gw-num">@Model.StudentCount</th>
                        <th class="gw-dist-total">100%</th>
                    </tr>
                </tfoot>
            </table>
        </div>

        for (var i = 0; i < Model.Bins.Count; i++)
        {
            var bin = Model.Bins[i];
            var modalId = "gw-bin-modal-" + i;
            var studentWord = Model.StudentCount == 1 ? "student" : "students";
            <div id="@modalId" class="gw-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="@(modalId)-title" hidden>
                <div class="gw-panel gw-card-raised gw-modal-card">
                    <div class="gw-panel-head">
                        <h3 id="@(modalId)-title" class="gw-panel-title">@Model.ScopeLabel grade: @bin.Label</h3>
                    </div>
                    <div class="gw-modal-top">
                        <div class="gw-modal-meta">
                            <span class="gw-badge gw-status-active">@bin.PercentText</span>
                            <span class="gw-muted">@bin.Count of @Model.StudentCount @studentWord in this range</span>
                        </div>
                        <button type="button" class="gw-iconbtn gw-modal-close" data-modal-close aria-label="Close modal" title="Close">
                            <img src="@Url.Content("~/Content/img/icons/close.svg")" alt="" width="20" height="20" />
                        </button>
                    </div>
                    @if (bin.Students.Count == 0)
                    {
                        <div class="gw-panel-body gw-empty-block">
                            No students in <strong>@bin.Label</strong>.
                        </div>
                    }
                    else
                    {
                        <div class="gw-table-wrap gw-modal-table-wrap">
                            <table class="gw-table">
                                <thead>
                                    <tr>
                                        <th scope="col">Name</th>
                                        <th scope="col" class="gw-num">@Model.ScopeLabel grade</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var s in bin.Students)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@s.FullName</strong><br />
                                                <span class="gw-muted gw-small">@s.StudentNo</span>
                                            </td>
                                            <td class="gw-num"><strong>@GradeCalculator.Format(s.Average)</strong></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    <div class="gw-modal-foot">
                        <button type="button" class="gw-btn gw-btn-outline" data-modal-close>Close</button>
                    </div>
                </div>
            </div>
        }

        if (Model.NotGraded > 0)
        {
            var notGradedModalId = "gw-bin-modal-notgraded";
            var notGradedWord = Model.StudentCount == 1 ? "student" : "students";
            <div id="@notGradedModalId" class="gw-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="@(notGradedModalId)-title" hidden>
                <div class="gw-panel gw-card-raised gw-modal-card">
                    <div class="gw-panel-head">
                        <h3 id="@(notGradedModalId)-title" class="gw-panel-title">Not graded yet</h3>
                    </div>
                    <div class="gw-modal-top">
                        <div class="gw-modal-meta">
                            <span class="gw-badge">@Model.NotGradedPercentText</span>
                            <span class="gw-muted">@Model.NotGraded of @Model.StudentCount @notGradedWord with no scores</span>
                        </div>
                        <button type="button" class="gw-iconbtn gw-modal-close" data-modal-close aria-label="Close modal" title="Close">
                            <img src="@Url.Content("~/Content/img/icons/close.svg")" alt="" width="20" height="20" />
                        </button>
                    </div>
                    <div class="gw-table-wrap gw-modal-table-wrap">
                        <table class="gw-table">
                            <thead>
                                <tr>
                                    <th scope="col">Name</th>
                                    <th scope="col" class="gw-num">@Model.ScopeLabel grade</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in Model.NotGradedStudents)
                                {
                                    <tr>
                                        <td>
                                            <strong>@s.FullName</strong><br />
                                            <span class="gw-muted gw-small">@s.StudentNo</span>
                                        </td>
                                        <td class="gw-num"><span class="gw-cell-empty">Not graded yet</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="gw-modal-foot">
                        <button type="button" class="gw-btn gw-btn-outline" data-modal-close>Close</button>
                    </div>
                </div>
            </div>
        }
    }
</section>

@if (Model.StudentCount > 0 && graded > 0)
{
    <section class="gw-panel gw-sr-panel">
        <div class="gw-panel-head">
            <h2 class="gw-panel-title">@Model.ScopeLabel equivalent grades</h2>
        </div>
        <div class="gw-panel-body gw-fp-note">
            <p class="gw-hint-block gw-muted">Graded students per equivalent grade. 1.00 is best; 5.00 is failed (below 64.5).</p>
        </div>
        <div class="gw-table-wrap">
            <table class="gw-table gw-dist-table">
                <caption class="gw-sr-only">Graded students per @Model.ScopeLabel equivalent grade</caption>
                <thead>
                    <tr>
                        <th scope="col">Equivalent</th>
                        <th scope="col" class="gw-num">Students</th>
                        <th scope="col" class="gw-dist-col">Chart</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var eq in Model.EquivalentBins)
                    {
                        <tr title="@eq.Label: @eq.PercentText (@eq.Count of @graded graded)">
                            <th scope="row">@eq.Label</th>
                            <td class="gw-num">@eq.Count</td>
                            <td class="gw-dist-col">
                                <div class="gw-bar-track">
                                    @if (eq.Count > 0)
                                    {
                                        <div class="gw-bar" style="width:@(GradeCalculator.Raw(eq.Percent))%"><span class="gw-bar-label">@eq.PercentText</span></div>
                                    }
                                    else
                                    {
                                        <span class="gw-bar-label gw-bar-label-zero">@eq.PercentText</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <div class="gw-an-pair">
        <section class="gw-panel gw-sr-panel">
            <div class="gw-panel-head">
                <h2 class="gw-panel-title">Top performers</h2>
            </div>
            <div class="gw-table-wrap">
                <table class="gw-table">
                    <thead>
                        <tr>
                            <th scope="col">Student</th>
                            <th scope="col" class="gw-num">@Model.ScopeLabel</th>
                            <th scope="col" class="gw-num">Eq.</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model.TopStudents)
                        {
                            <tr>
                                <td><strong>@t.FullName</strong><br /><span class="gw-muted gw-small">@t.StudentNo</span></td>
                                <td class="gw-num"><span class="gw-fc-chip gw-sr-ps gw-sr-ps-high"><strong>@GradeCalculator.Format(t.Average)</strong></span></td>
                                <td class="gw-num">@GradeCalculator.Format(GradeCalculator.EquivalentGrade(t.Average))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="gw-panel gw-sr-panel">
            <div class="gw-panel-head">
                <h2 class="gw-panel-title">Needs attention</h2>
            </div>
            @if (Model.AttentionStudents.Count == 0)
            {
                <div class="gw-panel-body gw-empty-block">No graded student is below passing (64.5).</div>
            }
            else
            {
                <div class="gw-table-wrap">
                    <table class="gw-table">
                        <thead>
                            <tr>
                                <th scope="col">Student</th>
                                <th scope="col" class="gw-num">@Model.ScopeLabel</th>
                                <th scope="col" class="gw-num">Eq.</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in Model.AttentionStudents)
                            {
                                <tr>
                                    <td><strong>@a.FullName</strong><br /><span class="gw-muted gw-small">@a.StudentNo</span></td>
                                    <td class="gw-num"><span class="gw-fc-chip gw-sr-ps gw-sr-ps-low"><strong>@GradeCalculator.Format(a.Average)</strong></span></td>
                                    <td class="gw-num">@GradeCalculator.Format(GradeCalculator.EquivalentGrade(a.Average))</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="gw-panel-body gw-an-foot">Below passing: @Model.Failing of @graded graded. Lowest @Model.AttentionStudents.Count shown.</div>
            }
            @if (Model.Incomplete > 0)
            {
                <div class="gw-panel-body gw-an-foot">@Model.Incomplete @(Model.Incomplete == 1 ? "student is" : "students are") marked INC (Final Term exam still blank).</div>
            }
        </section>
    </div>
}

@if (Model.HasTermComparison)
{
    <section class="gw-panel gw-sr-panel">
        <div class="gw-panel-head">
            <h2 class="gw-panel-title">Midterm vs Final Term</h2>
        </div>
        <div class="gw-panel-body gw-fp-note">
            <p class="gw-hint-block gw-muted">Compares the @Model.TermCompared @(Model.TermCompared == 1 ? "student" : "students") graded in both terms.</p>
        </div>
        <div class="gw-table-wrap">
            <table class="gw-table">
                <tbody>
                    <tr><th scope="row">Midterm average</th><td class="gw-num"><strong>@GradeCalculator.Format(Model.MidtermAverage)%</strong></td></tr>
                    <tr><th scope="row">Final Term average</th><td class="gw-num"><strong>@GradeCalculator.Format(Model.FinalTermAverage)%</strong></td></tr>
                    <tr><th scope="row">Average change</th><td class="gw-num"><strong>@(Model.TermChange.HasValue && Model.TermChange.Value > 0 ? "+" : "")@GradeCalculator.Format(Model.TermChange)</strong></td></tr>
                    <tr><th scope="row">Improved</th><td class="gw-num">@Model.Improved</td></tr>
                    <tr><th scope="row">Declined</th><td class="gw-num">@Model.Declined</td></tr>
                    <tr><th scope="row">Unchanged</th><td class="gw-num">@Model.Unchanged</td></tr>
                </tbody>
            </table>
        </div>
    </section>
}

<section class="gw-panel gw-sr-panel">
    <div class="gw-panel-head">
        <h2 class="gw-panel-title">@Model.ScopeLabel category averages</h2>
    </div>
    <div class="gw-table-wrap">
        <table class="gw-table gw-table-grouped">
            <colgroup><col style="width:26%" /><col style="width:11%" /><col style="width:21%" /><col style="width:14%" /><col style="width:12%" /><col style="width:16%" /></colgroup>
            <thead>
                <tr>
                    <th>Category</th>
                    <th class="gw-num">Weight</th>
                    <th class="gw-num">Students graded</th>
                    <th class="gw-num">Class average</th>
                    <th class="gw-num">Passing</th>
                    <th class="gw-num">Low &ndash; high</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Categories.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="gw-empty">
                            No @Model.ScopeLabel categories yet.
                            @Html.ActionLink("Set them up", "Categories", "Faculty", new { id = Model.CourseId }, null)
                        </td>
                    </tr>
                }
                @foreach (var group in Model.Categories.Count == 0 ? new string[0] : new[] { "Class Standing", "Exam" })
                {
                    var groupRows = Model.Categories.Where(c => c.Group == group).ToList();
                    <tr><td colspan="6" class="gw-group-cell"><details class="gw-student-major @(group == "Exam" ? "gw-grp-ex" : "gw-grp-cs")" open><summary><strong>@group</strong><span>avg @GradeCalculator.Format(group == "Exam" ? Model.ExamAverage : Model.ClassStandingAverage) &middot; @(Model.Scope == GradeScopes.FinalGrade ? (group == "Class Standing" ? "30%" : "20%") : (group == "Class Standing" ? "60%" : "40%"))</span></summary>
                        <table class="gw-table gw-table-grouped">
                        <colgroup><col style="width:26%" /><col style="width:11%" /><col style="width:21%" /><col style="width:14%" /><col style="width:12%" /><col style="width:16%" /></colgroup>
                        <tbody>
                        @if (groupRows.Count == 0)
                        {
                            <tr><td colspan="6" class="gw-empty">No @group.ToLower() categories here.</td></tr>
                        }
                        @foreach (var c in groupRows)
                        {
                            var gradedPct = Model.StudentCount > 0 ? Math.Round(c.Graded * 100.0 / Model.StudentCount, 2) : 0;
                            var gradedPctText = gradedPct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";
                            <tr title="@c.Name: @gradedPctText graded (@c.Graded of @Model.StudentCount)">
                                <td>@c.Name <span class="gw-th-sub">(@c.Period)</span></td>
                                <td class="gw-num"><strong>@GradeCalculator.Format(c.Weight)%</strong></td>
                                <td class="gw-num">@c.Graded of @Model.StudentCount <span class="gw-muted">(@gradedPctText)</span></td>
                                <td class="gw-num"><span class="gw-fc-chip gw-sr-ps gw-sr-ps-@(!c.Average.HasValue ? "none" : c.Average.Value >= 75 ? "high" : c.Average.Value >= 65 ? "mid" : "low")">@(c.Average.HasValue ? GradeCalculator.Format(c.Average) + "%" : GradeCalculator.Format(c.Average))</span></td>
                                <td class="gw-num">@(c.PassRate.HasValue ? GradeCalculator.Format(c.PassRate) + "%" : GradeCalculator.Format(c.PassRate))</td>
                                <td class="gw-num">@(c.Lowest.HasValue ? GradeCalculator.Format(c.Lowest) + " to " + GradeCalculator.Format(c.Highest) : GradeCalculator.Format(c.Lowest))</td>
                            </tr>
                        }
                        </tbody></table>
                    </details></td></tr>
                }
            </tbody>
        </table>
    </div>
    @{
        var withAvg = Model.Categories.Where(c => c.Average.HasValue).ToList();
        if (withAvg.Count > 1)
        {
            var strongest = withAvg.OrderByDescending(c => c.Average.Value).First();
            var weakest = withAvg.OrderBy(c => c.Average.Value).First();
            <div class="gw-panel-body gw-an-foot">
                Strongest: <strong>@strongest.Name</strong> (@GradeCalculator.Format(strongest.Average)%).
                Weakest: <strong>@weakest.Name</strong> (@GradeCalculator.Format(weakest.Average)%).
            </div>
        }
    }
</section>

</div>

@section scripts {
    <script>
        // Bars and rows open their modal through the shared component (gw-modal.js), which also handles
        // Close buttons, Esc, a click on the dark backdrop, the Tab key and returning focus.
        (function () {
            function openFrom(el) {
                var id = el.getAttribute("data-modal-target");
                if (id && window.GW) GW.modal.open(id);
            }

            document.addEventListener("click", function (e) {
                var trigger = e.target.closest("[data-modal-target]");
                if (trigger) openFrom(trigger);
            });

            document.addEventListener("keydown", function (e) {
                if (e.key !== "Enter" && e.key !== " ") return;
                var focused = document.activeElement;
                if (focused && focused.hasAttribute("data-modal-target")) {
                    e.preventDefault();
                    openFrom(focused);
                }
            });
        })();
    </script>
}
