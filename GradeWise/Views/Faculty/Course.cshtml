@model GradeWise.Models.CourseDetailViewModel
@using GradeWise.Models
@using GradeWise.Services
@{
    ViewBag.Title = Model.Code + " scores";

    var message = TempData["Message"] as string;
    var error = TempData["Error"] as string;

    // The Edit course window: current values, or what was typed when the last save failed.
    var editErrors = TempData["EditCourseErrors"] as List<string> ?? new List<string>();
    var edit = Model.EditCourse;
    var editCode = TempData["EditCourseCode"] as string ?? edit.Code;
    var editName = TempData["EditCourseName"] as string ?? edit.Name;
    var editSection = TempData["EditCourseSection"] as string ?? edit.Section;
    var editTerm = TempData["EditCourseTerm"] as string ?? edit.Term;
    var dash = "\u2014";

    // Colours borrowed from the admin Accounts page: lime, blue, gold, plus lavender and orange.
    var tones = new[] { "lime", "blue", "gold", "lav", "orange" };

    // Passing mark is 65: lime at 75 and above, gold from 65, orange below.
    Func<double?, string> gradeTone = v => !v.HasValue ? "none" : v.Value >= 75 ? "high" : v.Value >= 65 ? "mid" : "low";

    Func<string, string> initialsOf = n =>
    {
        var parts = (n ?? "").Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 0 ? "?" : (parts[0].Substring(0, 1) + (parts.Length > 1 ? parts[parts.Length - 1].Substring(0, 1) : "")).ToUpperInvariant();
    };
}

@* One student cell, used by the Midterm, Final Term and Final Grade tables. *@
@helper StudentCell(string name, string no, string initials, string tone)
{
    <td class="gw-sr-student">
        <div class="gw-sr-person">
            <span class="gw-sr-avatar gw-sr-avatar-@tone" aria-hidden="true">@initials</span>
            <span class="gw-sr-person-text">
                <span class="gw-sr-name">@name</span>
                <code class="gw-sr-id">@no</code>
            </span>
        </div>
    </td>
}

<div class="gw-faculty-courses gw-fcourse">

<h1 class="gw-page-title">@Model.Code &middot; @Model.Name</h1>
<p class="gw-page-sub gw-fcourse-sub">
    <span class="gw-fc-chip gw-fc-chip-term">@Model.Term</span>
    @if (!string.IsNullOrWhiteSpace(Model.Section))
    {
        <span class="gw-fc-chip gw-fc-chip-section">Section @Model.Section</span>
    }
    else
    {
        <span class="gw-fc-chip gw-fc-chip-plain">No section</span>
    }
    <span class="gw-fc-chip gw-fc-chip-students">@Model.Rows.Count @(Model.Rows.Count == 1 ? "student" : "students")</span>
</p>

@if (!string.IsNullOrEmpty(error))
{
    <div class="gw-alert" role="alert">@error</div>
}
@if (!string.IsNullOrEmpty(message))
{
    <div class="gw-alert gw-alert-ok" role="status">@message</div>
}
@if (Model.Errors.Count > 0)
{
    <div class="gw-alert" role="alert">
        <strong>Nothing was saved. Please fix the following:</strong>
        <ul class="gw-error-list">
            @foreach (var e in Model.Errors)
            {
                <li>@e</li>
            }
        </ul>
    </div>
}
@if (Model.Categories.Count == 0)
{
    <div class="gw-alert gw-alert-warn" role="status">
        This course has no grading categories yet.
        @Html.ActionLink("Set the categories and weights", "Categories", "Faculty", new { id = Model.CourseId }, null)
        before entering scores.
    </div>
}
else if (!Model.PeriodsOk)
{
    <div class="gw-alert gw-alert-warn" role="status">
        <ul class="gw-error-list">
            @if (!Model.MidtermSet)
            {
                <li>Midterm categories are not set yet.</li>
            }
            else if (!GradeWise.Services.GradeCalculator.IsFullWeight(Model.MidtermTotal))
            {
                <li>Midterm weights add up to <strong>@GradeCalculator.Format(Model.MidtermTotal)%</strong>, not 100%.</li>
            }
            @if (!Model.FinalSet)
            {
                <li>Final Term categories are not set yet.</li>
            }
            else if (!GradeWise.Services.GradeCalculator.IsFullWeight(Model.FinalTotal))
            {
                <li>Final Term weights add up to <strong>@GradeCalculator.Format(Model.FinalTotal)%</strong>, not 100%.</li>
            }
        </ul>
        Final Grade is incomplete.
        @Html.ActionLink("Set the categories", "Categories", "Faculty", new { id = Model.CourseId }, null)
    </div>
}

<div class="gw-fcourse-scopebar">
    @using (Html.BeginForm("SetScope", "Faculty", new { id = Model.CourseId }, FormMethod.Post, new { @class = "gw-scope-form" }))
    {
        @Html.AntiForgeryToken()
        <span class="gw-fcourse-scopelabel">Grade scope</span>
        <div class="gw-scope-toggle" role="group" aria-label="Grade scope">
            @foreach (var key in GradeScopes.All)
            {
                var on = key == Model.Scope;
                <button type="submit" name="scope" value="@key" class="gw-btn gw-btn-small @(on ? "gw-scope-on" : "gw-btn-outline")" aria-pressed="@(on ? "true" : "false")">@GradeScopes.Label(key)</button>
            }
        </div>
        <p class="gw-scope-note">Students see the same numbers.</p>
    }
</div>

@if (!Model.ScopeReady)
{
    <div class="gw-alert gw-alert-warn" role="status">
        @if (Model.Scope == GradeScopes.FinalGrade)
        {
            <text>Final Grade numbers show dashes until both Midterm and Final Term have categories and each totals 100%.</text>
        }
        else
        {
            <text>@Model.ScopeLabel numbers show dashes until its categories are set and total 100%.</text>
        }
    </div>
}

<section class="gw-stats" aria-label="Class summary">
    <div class="gw-stat gw-stat-blue" data-tab="Students">
        <div class="gw-stat-value">@Model.Rows.Count</div>
        <div class="gw-stat-label">Students</div>
    </div>
    <div class="gw-stat gw-stat-lime" data-tab="Average">
        <div class="gw-stat-value">@(Model.ScopeReady ? GradeCalculator.Format(Model.Summary.Average) : dash)</div>
        <div class="gw-stat-label">Class average (@Model.ScopeLabel)</div>
    </div>
    <div class="gw-stat gw-stat-lav" data-tab="Highest">
        <div class="gw-stat-value">@(Model.ScopeReady ? GradeCalculator.Format(Model.Summary.Highest) : dash)</div>
        <div class="gw-stat-label">Highest (@Model.ScopeLabel)</div>
    </div>
    <div class="gw-stat gw-stat-orange" data-tab="Lowest">
        <div class="gw-stat-value">@(Model.ScopeReady ? GradeCalculator.Format(Model.Summary.Lowest) : dash)</div>
        <div class="gw-stat-label">Lowest (@Model.ScopeLabel)</div>
    </div>
    <div class="gw-stat gw-stat-gold" data-tab="Equivalent">
        <div class="gw-stat-value">@(Model.ScopeReady ? GradeCalculator.Format(Model.Equivalent) : dash)</div>
        <div class="gw-stat-label">Class equivalent (@Model.ScopeLabel)</div>
    </div>
</section>

<div class="gw-toolbar gw-fcourse-toolbar">
    <a href="@Url.Action("Index", "Faculty")" class="gw-iconbtn gw-iconbtn-text" title="Back to courses">
        <img src="@Url.Content("~/Content/img/icons/back.svg")" alt="" width="24" height="24" />
        <span>Back to courses</span>
    </a>
    <a href="@Url.Action("Enroll", "Faculty", new { id = Model.CourseId })" class="gw-iconbtn gw-iconbtn-text gw-tone-blue" title="Students">
        <img src="@Url.Content("~/Content/img/icons/user.svg")" alt="" width="24" height="24" />
        <span>Students</span>
    </a>
    <a href="@Url.Action("Categories", "Faculty", new { id = Model.CourseId })" class="gw-iconbtn gw-iconbtn-text gw-tone-gold" title="Categories and weights">
        <img src="@Url.Content("~/Content/img/icons/list.svg")" alt="" width="24" height="24" />
        <span>Categories</span>
    </a>
    <a href="@Url.Action("Analytics", "Faculty", new { id = Model.CourseId })" class="gw-iconbtn gw-iconbtn-text gw-tone-lav" title="Analytics">
        <img src="@Url.Content("~/Content/img/icons/calendar.svg")" alt="" width="24" height="24" />
        <span>Analytics</span>
    </a>
    <a href="@Url.Action("ExportCsv", "Faculty", new { id = Model.CourseId, scope = Model.Scope })" class="gw-iconbtn gw-iconbtn-text gw-tone-lime" title="Export CSV">
        <img src="@Url.Content("~/Content/img/icons/download.svg")" alt="" width="24" height="24" />
        <span>Export CSV</span>
    </a>
    <button type="button" class="gw-iconbtn gw-iconbtn-text gw-tone-orange" data-modal-open="gw-editcourse-modal" aria-haspopup="dialog" title="Edit course">
        <img src="@Url.Content("~/Content/img/icons/edit.svg")" alt="" width="24" height="24" />
        <span>Edit course</span>
    </button>
</div>

<section class="gw-panel gw-sr-panel">
    <div class="gw-panel-head">
        <h2 class="gw-panel-title">Score entry</h2>
    </div>

    @if (Model.Categories.Count == 0)
    {
        <div class="gw-panel-body gw-empty-block">Set the grading categories to start entering scores.</div>
    }
    else if (Model.Rows.Count == 0)
    {
        <div class="gw-panel-body gw-empty-block">
            No students are enrolled yet.
            @Html.ActionLink("Enroll students", "Enroll", "Faculty", new { id = Model.CourseId }, null)
        </div>
    }
    else
    {
        @* Slim search bar: hidden until the page script runs; without JavaScript every student is listed. *@
        <div class="gw-sr-tools" id="gw-sr-controls" role="search" aria-label="Filter students" hidden>
            <div class="gw-sr-tools-search">
                <input type="search" id="gw-sr-search" placeholder="Search student name or number" aria-label="Search students" autocomplete="off" spellcheck="false" />
            </div>
            <span class="gw-fc-chip gw-sr-tools-count" id="gw-sr-count" aria-live="polite"></span>
            <button type="button" class="gw-btn gw-btn-small gw-btn-outline" id="gw-sr-clear">Clear</button>
        </div>

        using (Html.BeginForm("SaveScores", "Faculty", new { id = Model.CourseId }, FormMethod.Post, new { id = "score-form" }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="tab" id="active-tab" value="@Model.ActiveTab" />

            var tabs = new[]
            {
                new { Key = "midterm", Label = "Midterm" },
                new { Key = "final-term", Label = "Final Term" },
                new { Key = "final-grade", Label = "Final Grade" }
            };

            <div class="gw-panel-body gw-tabs-wrap">
                <div class="gw-tabs" role="tablist" aria-label="Score tables">
                    @foreach (var t in tabs)
                    {
                        var on = t.Key == Model.ActiveTab;
                        <button type="button" class="gw-tab" role="tab" id="tab-@t.Key" aria-controls="panel-@t.Key"
                                aria-selected="@(on ? "true" : "false")" tabindex="@(on ? 0 : -1)" data-tab="@t.Key">@t.Label</button>
                    }
                </div>
            </div>

            foreach (var period in GradePeriods.All)
            {
                var key = period == GradePeriods.Midterm ? "midterm" : "final-term";
                var isFinal = period == GradePeriods.FinalTerm;

                <div class="gw-tabpanel" role="tabpanel" id="panel-@key" aria-labelledby="tab-@key" hidden="@(key == Model.ActiveTab ? null : "hidden")">
                    @if (!(isFinal ? Model.FinalSet : Model.MidtermSet))
                    {
                        <div class="gw-panel-body gw-empty-block">
                            No @period categories yet.
                            @Html.ActionLink("Set the categories", "Categories", "Faculty", new { id = Model.CourseId }, null)
                        </div>
                    }
                    else
                    {
                        var periodCategories = Model.Categories
                            .Select((c, index) => new { Category = c, Index = index })
                            .Where(x => GradePeriods.Normalize(x.Category.Period) == period)
                            .ToList();

                        @* Which category is open for typing. One category is open at a time, so the table
                           always fits the page: the others show only their PS. All boxes are saved together. *@
                        <div class="gw-panel-body gw-sr-bar">
                            <span class="gw-sr-bar-label">Enter scores for</span>
                            <div class="gw-sr-chips" role="group" aria-label="Category to enter">
                                @for (var p = 0; p < periodCategories.Count; p++)
                                {
                                    var x = periodCategories[p];
                                    <button type="button" class="gw-sr-chip gw-sr-chip-@tones[p % tones.Length]" data-sr-cat="@x.Index" aria-pressed="@(p == 0 ? "true" : "false")">
                                        @x.Category.Name <span class="gw-sr-chip-w">@GradeCalculator.Format(x.Category.Weight)%</span>
                                    </button>
                                }
                            </div>
                        </div>

                        <table class="gw-table gw-sr-table" data-sr-table>
                            <thead>
                                <tr>
                                    <th scope="col" class="gw-sr-student">Student</th>
                                    @for (var p = 0; p < periodCategories.Count; p++)
                                    {
                                        var x = periodCategories[p];
                                        var tone = tones[p % tones.Length];
                                        <th scope="col" class="gw-sr-cat gw-sr-tone-@tone @(p == 0 ? "is-open" : "")" data-cat="@x.Index">
                                            <div class="gw-sr-headtop">
                                                <button type="button" class="gw-sr-cathead" data-sr-cat="@x.Index" aria-expanded="@(p == 0 ? "true" : "false")" title="@x.Category.Name, @GradeCalculator.Format(x.Category.Weight)%, @x.Category.Group">
                                                    <span class="gw-sr-catname">@x.Category.Name</span>
                                                    <span class="gw-sr-catsub">@GradeCalculator.Format(x.Category.Weight)%<span class="gw-sr-catgroup"> &middot; @x.Category.Group</span></span>
                                                </button>
                                                <button type="button" class="gw-sr-tool gw-sr-open-only" data-modal-open="gw-cols-@x.Index" aria-haspopup="dialog" aria-label="Edit columns of @x.Category.Name" title="Add, edit or remove columns">
                                                    <img src="@Url.Content("~/Content/img/icons/edit.svg")" alt="" width="14" height="14" />
                                                    <span>Columns</span>
                                                </button>
                                            </div>
                                            <div class="gw-sr-open-only">
                                                <div class="gw-sr-grid gw-sr-grid-head">
                                                    @foreach (var assessment in x.Category.Assessments)
                                                    {
                                                        <span class="gw-sr-gi">@Html.ActionLink(assessment.Name, "Assessment", "Faculty", new { id = Model.CourseId, category = x.Category.Name, assessment = assessment.Id }, new { title = "Open " + assessment.Name + " to enter its scores and edit it" })</span>
                                                    }
                                                    <span class="gw-sr-gi gw-sr-gi-calc">Total</span>
                                                    <span class="gw-sr-gi gw-sr-gi-calc">PS</span>
                                                    <span class="gw-sr-gi gw-sr-gi-add"><button type="button" class="gw-sr-addtile" data-modal-open="gw-cols-@x.Index" aria-haspopup="dialog" aria-label="Add a column to @x.Category.Name" title="Add a column">+</button></span>
                                                </div>
                                            </div>
                                        </th>
                                    }
                                    <th scope="col" class="gw-sr-fin">Earned<span class="gw-th-sub"> /100</span></th>
                                    <th scope="col" class="gw-sr-fin gw-sr-eq">Eq.</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="gw-sr-hps">
                                    <td class="gw-sr-student"><strong>Highest possible score</strong></td>
                                    @for (var p = 0; p < periodCategories.Count; p++)
                                    {
                                        var x = periodCategories[p];
                                        <td class="gw-sr-cat gw-sr-tone-@tones[p % tones.Length] @(p == 0 ? "is-open" : "")" data-cat="@x.Index">
                                            <div class="gw-sr-sum"><strong>@GradeCalculator.Format(x.Category.Assessments.Sum(a => a.MaxScore))</strong></div>
                                            <div class="gw-sr-grid">
                                                @foreach (var assessment in x.Category.Assessments)
                                                {
                                                    <span class="gw-sr-gi" data-name="@assessment.Name">
                                                        <input type="number" min="0.01" step="any" inputmode="decimal"
                                                               class="gw-score-input gw-sr-input gw-hps-input"
                                                               name="@CourseService.HpsFieldName(assessment.Id)"
                                                               value="@GradeCalculator.Raw(assessment.MaxScore)"
                                                               aria-label="Highest possible score of @x.Category.Name @assessment.Name" />
                                                    </span>
                                                }
                                                <span class="gw-sr-gi gw-sr-gi-calc" data-name="Total"><strong>@GradeCalculator.Format(x.Category.Assessments.Sum(a => a.MaxScore))</strong></span>
                                                <span class="gw-sr-gi gw-sr-gi-calc" data-name="PS"><strong>100.00</strong></span>
                                            </div>
                                        </td>
                                    }
                                    <td class="gw-sr-fin">&nbsp;</td>
                                    <td class="gw-sr-fin gw-sr-eq">&nbsp;</td>
                                </tr>
                                @foreach (var row in Model.Rows)
                                {
                                    var result = isFinal ? row.FinalResult : row.MidtermResult;
                                    var earned = result.EarnedOrNull;
                                    <tr data-student="@((row.FullName + " " + row.StudentNo).ToLowerInvariant())">
                                        @StudentCell(row.FullName, row.StudentNo, initialsOf(row.FullName), gradeTone(earned))
                                        @for (var p = 0; p < periodCategories.Count; p++)
                                        {
                                            var x = periodCategories[p];
                                            var cells = row.CategoryCells[x.Index];
                                            <td class="gw-sr-cat gw-sr-tone-@tones[p % tones.Length] @(p == 0 ? "is-open" : "")" data-cat="@x.Index">
                                                <div class="gw-sr-sum">
                                                    <span class="gw-fc-chip gw-sr-ps gw-sr-ps-@gradeTone(cells.Percent)" title="Total @GradeCalculator.Format(cells.Total) of @GradeCalculator.Format(cells.GradedMax)">@GradeCalculator.Format(cells.Percent)</span>
                                                </div>
                                                <div class="gw-sr-grid">
                                                    @for (var j = 0; j < x.Category.Assessments.Count; j++)
                                                    {
                                                        var assessment = x.Category.Assessments[j];
                                                        <span class="gw-sr-gi" data-name="@assessment.Name">
                                                            <input type="number" min="0" max="@GradeCalculator.Raw(assessment.MaxScore)" step="any" inputmode="decimal"
                                                                   class="gw-score-input gw-sr-input @(cells.Invalid[j] ? "gw-input-bad" : "")"
                                                                   name="@CourseService.CellFieldName(row.StudentId, assessment.Id)"
                                                                   value="@cells.Inputs[j]"
                                                                   placeholder="&mdash;"
                                                                   aria-label="@x.Category.Name @assessment.Name score for @row.FullName" />
                                                        </span>
                                                    }
                                                    <span class="gw-sr-gi gw-sr-gi-calc" data-name="Total">@GradeCalculator.Format(cells.Total)</span>
                                                    <span class="gw-sr-gi gw-sr-gi-calc" data-name="PS"><strong>@GradeCalculator.Format(cells.Percent)</strong></span>
                                                </div>
                                            </td>
                                        }
                                        <td class="gw-sr-fin"><span class="gw-fc-chip gw-sr-ps gw-sr-ps-@gradeTone(earned)"><strong>@GradeCalculator.Format(earned)</strong></span></td>
                                        <td class="gw-sr-fin gw-sr-eq">@GradeCalculator.Format(GradeCalculator.EquivalentFromEarned(result))</td>
                                    </tr>
                                }
                                <tr class="gw-sr-nomatch" hidden>
                                    <td colspan="@(periodCategories.Count + 3)" class="gw-empty">
                                        No students match this search.
                                        <button type="button" class="gw-fc-linkbtn" data-sr-clear>Clear filters</button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="gw-panel-body gw-sr-savebar">
                            <span class="gw-sr-savehint">Scores in every category are saved together.</span>
                            <div class="gw-form-buttons">
                                <button type="submit" class="gw-btn"
                                        data-confirm="This saves every score and highest possible score typed in this class record, in all categories and tabs."
                                        data-confirm-title="Save scores?"
                                        data-confirm-ok="Save">Save scores</button>
                            </div>
                        </div>
                    }
                </div>
            }

            <div class="gw-tabpanel" role="tabpanel" id="panel-final-grade" aria-labelledby="tab-final-grade" hidden="@("final-grade" == Model.ActiveTab ? null : "hidden")">
                <table class="gw-table gw-sr-table gw-sr-final">
                    <thead>
                        <tr>
                            <th scope="col" class="gw-sr-student">Student</th>
                            <th scope="col" class="gw-num gw-sr-tone-blue">Midterm Grade</th>
                            <th scope="col" class="gw-num gw-sr-tone-blue">Midterm Eq.</th>
                            <th scope="col" class="gw-num gw-sr-tone-gold">Final Term Grade</th>
                            <th scope="col" class="gw-num gw-sr-tone-gold">Final Term Eq.</th>
                            <th scope="col" class="gw-num gw-sr-tone-lime">Final Grade</th>
                            <th scope="col" class="gw-num gw-sr-tone-lime">Equivalent</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            <tr data-student="@((row.FullName + " " + row.StudentNo).ToLowerInvariant())">
                                @StudentCell(row.FullName, row.StudentNo, initialsOf(row.FullName), gradeTone(row.Result.EarnedOrNull))
                                <td class="gw-num">@GradeCalculator.Format(row.MidtermResult.EarnedOrNull)</td>
                                <td class="gw-num">@GradeCalculator.Format(GradeCalculator.EquivalentFromEarned(row.MidtermResult))</td>
                                <td class="gw-num">@GradeCalculator.Format(row.FinalResult.EarnedOrNull)</td>
                                <td class="gw-num">@GradeCalculator.Format(GradeCalculator.EquivalentFromEarned(row.FinalResult))</td>
                                <td class="gw-num"><span class="gw-fc-chip gw-sr-ps gw-sr-ps-@gradeTone(row.Result.EarnedOrNull)"><strong>@GradeCalculator.Format(row.Result.EarnedOrNull)</strong></span></td>
                                <td class="gw-num"><strong>@(row.Incomplete ? "INC" : GradeCalculator.Format(GradeCalculator.EquivalentFromEarned(row.Result)))</strong></td>
                            </tr>
                        }
                        <tr class="gw-sr-nomatch" hidden>
                            <td colspan="7" class="gw-empty">
                                No students match this search.
                                <button type="button" class="gw-fc-linkbtn" data-sr-clear>Clear filters</button>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div class="gw-panel-body">
                    <p class="gw-note gw-note-first">This table is read only. Enter scores in the Midterm and Final Term tabs.</p>
                </div>
            </div>

            <div class="gw-panel-body">
                <p class="gw-note gw-note-first">
                    Enter each score out of its column's <strong>highest possible score</strong>, and leave a box empty if the work is not given yet.
                    <strong>Total</strong> adds the entered scores of a category and <strong>PS</strong> is that total divided by the highest possible total of the same columns, times 100. The PS is what the category weight is applied to.
                    <strong>Earned Grade</strong> is the points collected out of 100, and work that is not graded yet counts as 0.
                    <strong>Final Grade</strong> is the average of the Midterm and the Final Term.
                    <strong>INC</strong> (incomplete) shows when the Midterm and the Final Term class standing are each at least 65 but the Final Term exam is still blank.
                </p>
            </div>
        }
    }
</section>

@* ---------- Add or remove columns (one window per category) ----------
   These forms are outside the score form on purpose (a form cannot sit inside another form). *@
@if (Model.Categories.Count > 0)
{
    for (var ci = 0; ci < Model.Categories.Count; ci++)
    {
        var c = Model.Categories[ci];
        <div id="gw-cols-@ci" class="gw-modal-backdrop" hidden>
            <div class="gw-panel gw-card-raised gw-modal-card" role="dialog" aria-modal="true" aria-labelledby="gw-cols-title-@ci">
                <div class="gw-panel-head">
                    <h2 id="gw-cols-title-@ci" class="gw-panel-title">@c.Name columns</h2>
                </div>
                <div class="gw-modal-top">
                    <div class="gw-modal-meta gw-colm-meta">
                        <span class="gw-fc-chip gw-fc-chip-term">@c.Period</span>
                        <span class="gw-fc-chip gw-fc-chip-section">@c.Group</span>
                        <span class="gw-fc-chip gw-fc-chip-students">@c.Assessments.Count @(c.Assessments.Count == 1 ? "column" : "columns")</span>
                    </div>
                    <button type="button" class="gw-iconbtn gw-modal-close" data-modal-close aria-label="Close" title="Close">
                        <img src="@Url.Content("~/Content/img/icons/close.svg")" alt="" width="20" height="20" />
                    </button>
                </div>
                <div class="gw-panel-body gw-colm">
                    <p class="gw-muted gw-small gw-colm-note">Removing a column deletes its scores. The page reloads after each change, so save typed scores first.</p>

                    <ul class="gw-colm-list">
                        @foreach (var assessment in c.Assessments)
                        {
                            <li class="gw-colm-row">
                                <span class="gw-colm-name">@assessment.Name</span>
                                <span class="gw-fc-chip gw-fc-chip-students">Highest @GradeCalculator.Raw(assessment.MaxScore)</span>
                                <span class="gw-colm-actions">
                                    <a href="@Url.Action("Assessment", "Faculty", new { id = Model.CourseId, category = c.Name, assessment = assessment.Id })" class="gw-btn gw-btn-small gw-btn-outline">Edit</a>
                                    @using (Html.BeginForm("RemoveAssessment", "Faculty", new { id = Model.CourseId, category = c.Name, assessment = assessment.Id }, FormMethod.Post, new { @class = "gw-inline-form", data_confirm = "Remove column " + assessment.Name + " from " + c.Name + "? The scores entered in it are deleted." }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="gw-btn gw-btn-small gw-btn-outline gw-colm-remove" disabled="@(c.Assessments.Count <= 1)" title="@(c.Assessments.Count <= 1 ? "A category needs at least one column" : "Remove this column")">Remove</button>
                                    }
                                </span>
                            </li>
                        }
                    </ul>

                    <div class="gw-colm-add">
                        <h3 class="gw-colm-add-title">Add a column</h3>
                        @using (Html.BeginForm("AddAssessment", "Faculty", new { id = Model.CourseId, category = c.Name }, FormMethod.Post, new { @class = "gw-colm-addform" }))
                        {
                            @Html.AntiForgeryToken()
                            <div class="gw-colm-field">
                                <label for="gw-colm-name-@ci">Name <span class="gw-muted">(optional)</span></label>
                                <input type="text" id="gw-colm-name-@ci" name="name" maxlength="40" placeholder="Next number" />
                            </div>
                            <div class="gw-colm-field gw-colm-field-max">
                                <label for="gw-colm-max-@ci">Highest score</label>
                                <input type="number" id="gw-colm-max-@ci" name="maxScore" min="0.01" step="any" value="100" />
                            </div>
                            <button type="submit" class="gw-btn gw-btn-small">Add column</button>
                        }
                    </div>
                </div>
                <div class="gw-modal-foot">
                    <button type="button" class="gw-btn gw-btn-outline" data-modal-close>Close</button>
                </div>
            </div>
        </div>
    }
}

<div id="gw-editcourse-modal" class="gw-modal-backdrop" hidden @(editErrors.Count > 0 ? "data-open-on-load" : null)>
    <div class="gw-panel gw-card-raised gw-modal-card" role="dialog" aria-modal="true" aria-labelledby="gw-editcourse-title">
        <div class="gw-panel-head">
            <h2 id="gw-editcourse-title" class="gw-panel-title">Edit course</h2>
        </div>
        <div class="gw-modal-top">
            <div class="gw-modal-meta">
                <span class="gw-muted">Change the code, name, section or term. Categories, students and scores stay as they are.</span>
            </div>
            <button type="button" class="gw-iconbtn gw-modal-close" data-modal-close aria-label="Close" title="Close">
                <img src="@Url.Content("~/Content/img/icons/close.svg")" alt="" width="20" height="20" />
            </button>
        </div>

        @using (Html.BeginForm("EditCourse", "Faculty", new { id = Model.CourseId }, FormMethod.Post, new { @class = "gw-editcourse-form" }))
        {
            @Html.AntiForgeryToken()
            <div class="gw-panel-body gw-editinfo-body">
                @if (editErrors.Count > 0)
                {
                    <div class="gw-alert" role="alert">
                        <strong>The course was not changed.</strong>
                        <ul class="gw-error-list">
                            @foreach (var e in editErrors)
                            {
                                <li>@e</li>
                            }
                        </ul>
                    </div>
                }

                <div class="gw-field">
                    <label for="gw-ec-code">Course code</label>
                    <input type="text" id="gw-ec-code" name="code" value="@editCode" maxlength="20" required data-autofocus />
                </div>
                <div class="gw-field">
                    <label for="gw-ec-name">Course name</label>
                    <input type="text" id="gw-ec-name" name="name" value="@editName" maxlength="100" required />
                </div>
                @if (edit.SectionNames.Count > 0)
                {
                    <div class="gw-field">
                        <label for="gw-ec-section">Section</label>
                        <select id="gw-ec-section" name="section">
                            <option value="">No section</option>
                            @foreach (var s in edit.SectionNames)
                            {
                                <option value="@s" selected="@(s == editSection)">@s</option>
                            }
                        </select>
                    </div>
                }
                else
                {
                    <div class="gw-field">
                        <label>Section</label>
                        <div class="gw-field-static">@(string.IsNullOrWhiteSpace(edit.Section) ? "No section" : edit.Section)</div>
                    </div>
                }
                <div class="gw-field">
                    <label for="gw-ec-term">Term</label>
                    <select id="gw-ec-term" name="term" required>
                        @foreach (var t in edit.TermNames)
                        {
                            <option value="@t" selected="@(t == editTerm)">@t</option>
                        }
                    </select>
                </div>
            </div>

            <div class="gw-modal-foot">
                <button type="submit" class="gw-btn">Save changes</button>
                <button type="button" class="gw-btn gw-btn-outline" data-modal-close>Cancel</button>
            </div>
        }
    </div>
</div>

</div>

@section scripts {
    @* The page script is in Scripts/faculty-course.js. *@
    <script src="@Url.Content("~/Scripts/faculty-course.js")?v=@System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Scripts/faculty-course.js")).Ticks"></script>
}
