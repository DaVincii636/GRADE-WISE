@model GradeWise.Models.CourseDetailViewModel
@using GradeWise.Models
@using GradeWise.Services
@{
    ViewBag.Title = Model.Code + " scores";

    var message = TempData["Message"] as string;
    var error = TempData["Error"] as string;

    // The Edit course window: current values, or what was typed when the last save failed.
    var editErrors = TempData["EditCourseErrors"] as List<string> ?? new List<string>();
    var edit = Model.EditCourse;
    var editCode = TempData["EditCourseCode"] as string ?? edit.Code;
    var editName = TempData["EditCourseName"] as string ?? edit.Name;
    var editSection = TempData["EditCourseSection"] as string ?? edit.Section;
    var editTerm = TempData["EditCourseTerm"] as string ?? edit.Term;
    var dash = "\u2014";
}

<h1 class="gw-page-title">@Model.Code &middot; @Model.Name</h1>
<p class="gw-page-sub">@Model.Term@if (!string.IsNullOrWhiteSpace(Model.Section)) { <text> &middot; Section @Model.Section</text> }</p>

@if (!string.IsNullOrEmpty(error))
{
    <div class="gw-alert" role="alert">@error</div>
}
@if (!string.IsNullOrEmpty(message))
{
    <div class="gw-alert gw-alert-ok" role="status">@message</div>
}
@if (Model.Errors.Count > 0)
{
    <div class="gw-alert" role="alert">
        <strong>Nothing was saved. Please fix the following:</strong>
        <ul class="gw-error-list">
            @foreach (var e in Model.Errors)
            {
                <li>@e</li>
            }
        </ul>
    </div>
}
@if (Model.Categories.Count == 0)
{
    <div class="gw-alert gw-alert-warn" role="status">
        This course has no grading categories yet.
        @Html.ActionLink("Set the categories and weights", "Categories", "Faculty", new { id = Model.CourseId }, null)
        before entering scores.
    </div>
}
else if (!Model.PeriodsOk)
{
    <div class="gw-alert gw-alert-warn" role="status">
        <ul class="gw-error-list">
            @if (!Model.MidtermSet)
            {
                <li>Midterm categories are not set yet.</li>
            }
            else if (!GradeWise.Services.GradeCalculator.IsFullWeight(Model.MidtermTotal))
            {
                <li>Midterm weights add up to <strong>@GradeCalculator.Format(Model.MidtermTotal)%</strong>, not 100%.</li>
            }
            @if (!Model.FinalSet)
            {
                <li>Final Term categories are not set yet.</li>
            }
            else if (!GradeWise.Services.GradeCalculator.IsFullWeight(Model.FinalTotal))
            {
                <li>Final Term weights add up to <strong>@GradeCalculator.Format(Model.FinalTotal)%</strong>, not 100%.</li>
            }
        </ul>
        Final Grade is incomplete.
        @Html.ActionLink("Set the categories", "Categories", "Faculty", new { id = Model.CourseId }, null)
    </div>
}

<div class="gw-scope">
    @using (Html.BeginForm("SetScope", "Faculty", new { id = Model.CourseId }, FormMethod.Post, new { @class = "gw-scope-form" }))
    {
        @Html.AntiForgeryToken()
        <div class="gw-scope-toggle" role="group" aria-label="Grade scope">
            @foreach (var key in GradeScopes.All)
            {
                var on = key == Model.Scope;
                <button type="submit" name="scope" value="@key" class="gw-btn gw-btn-small @(on ? "gw-scope-on" : "gw-btn-outline")" aria-pressed="@(on ? "true" : "false")">@GradeScopes.Label(key)</button>
            }
        </div>
        <p class="gw-scope-note">Students see the same numbers.</p>
    }
</div>

@if (!Model.ScopeReady)
{
    <div class="gw-alert gw-alert-warn" role="status">
        @if (Model.Scope == GradeScopes.FinalGrade)
        {
            <text>Final Grade numbers show dashes until both Midterm and Final Term have categories and each totals 100%.</text>
        }
        else
        {
            <text>@Model.ScopeLabel numbers show dashes until its categories are set and total 100%.</text>
        }
    </div>
}

<section class="gw-stats" aria-label="Class summary">
    <div class="gw-stat" data-tab="Students">
        <div class="gw-stat-value">@Model.Rows.Count</div>
        <div class="gw-stat-label">Students</div>
    </div>
    <div class="gw-stat" data-tab="Average">
        <div class="gw-stat-value">@(Model.ScopeReady ? GradeCalculator.Format(Model.Summary.Average) : dash)</div>
        <div class="gw-stat-label">Class average (@Model.ScopeLabel)</div>
    </div>
    <div class="gw-stat" data-tab="Highest">
        <div class="gw-stat-value">@(Model.ScopeReady ? GradeCalculator.Format(Model.Summary.Highest) : dash)</div>
        <div class="gw-stat-label">Highest (@Model.ScopeLabel)</div>
    </div>
    <div class="gw-stat" data-tab="Lowest">
        <div class="gw-stat-value">@(Model.ScopeReady ? GradeCalculator.Format(Model.Summary.Lowest) : dash)</div>
        <div class="gw-stat-label">Lowest (@Model.ScopeLabel)</div>
    </div>
    <div class="gw-stat" data-tab="Equivalent">
        <div class="gw-stat-value">@(Model.ScopeReady ? GradeCalculator.Format(Model.Equivalent) : dash)</div>
        <div class="gw-stat-label">Class equivalent (@Model.ScopeLabel)</div>
    </div>
</section>

<div class="gw-toolbar">
    <a href="@Url.Action("Index", "Faculty")" class="gw-iconbtn gw-iconbtn-text" title="Back to courses">
        <img src="@Url.Content("~/Content/img/icons/back.svg")" alt="" width="24" height="24" />
        <span>Back to courses</span>
    </a>
    <a href="@Url.Action("Enroll", "Faculty", new { id = Model.CourseId })" class="gw-iconbtn gw-iconbtn-text" title="Students">
        <img src="@Url.Content("~/Content/img/icons/user.svg")" alt="" width="24" height="24" />
        <span>Students</span>
    </a>
    <a href="@Url.Action("Categories", "Faculty", new { id = Model.CourseId })" class="gw-iconbtn gw-iconbtn-text" title="Categories and weights">
        <img src="@Url.Content("~/Content/img/icons/list.svg")" alt="" width="24" height="24" />
        <span>Categories</span>
    </a>
    <a href="@Url.Action("Analytics", "Faculty", new { id = Model.CourseId })" class="gw-iconbtn gw-iconbtn-text" title="Analytics">
        <img src="@Url.Content("~/Content/img/icons/calendar.svg")" alt="" width="24" height="24" />
        <span>Analytics</span>
    </a>
    <a href="@Url.Action("ExportCsv", "Faculty", new { id = Model.CourseId, scope = Model.Scope })" class="gw-iconbtn gw-iconbtn-text" title="Export CSV">
        <img src="@Url.Content("~/Content/img/icons/download.svg")" alt="" width="24" height="24" />
        <span>Export CSV</span>
    </a>
    <button type="button" class="gw-iconbtn gw-iconbtn-text" data-modal-open="gw-editcourse-modal" aria-haspopup="dialog" title="Edit course">
        <img src="@Url.Content("~/Content/img/icons/edit.svg")" alt="" width="24" height="24" />
        <span>Edit course</span>
    </button>
</div>

<section class="gw-panel">
    <div class="gw-panel-head">
        <h2 class="gw-panel-title">Score entry</h2>
    </div>

    @if (Model.Categories.Count == 0)
    {
        <div class="gw-panel-body gw-empty-block">Set the grading categories to start entering scores.</div>
    }
    else if (Model.Rows.Count == 0)
    {
        <div class="gw-panel-body gw-empty-block">
            No students are enrolled yet.
            @Html.ActionLink("Enroll students", "Enroll", "Faculty", new { id = Model.CourseId }, null)
        </div>
    }
    else
    {
        using (Html.BeginForm("SaveScores", "Faculty", new { id = Model.CourseId }, FormMethod.Post, new { id = "score-form" }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="tab" id="active-tab" value="@Model.ActiveTab" />

            var tabs = new[]
            {
                new { Key = "midterm", Label = "Midterm" },
                new { Key = "final-term", Label = "Final Term" },
                new { Key = "final-grade", Label = "Final Grade" }
            };

            <div class="gw-panel-body gw-tabs-wrap">
                <div class="gw-tabs" role="tablist" aria-label="Score tables">
                    @foreach (var t in tabs)
                    {
                        var on = t.Key == Model.ActiveTab;
                        <button type="button" class="gw-tab" role="tab" id="tab-@t.Key" aria-controls="panel-@t.Key"
                                aria-selected="@(on ? "true" : "false")" tabindex="@(on ? 0 : -1)" data-tab="@t.Key">@t.Label</button>
                    }
                </div>
            </div>

            foreach (var period in GradePeriods.All)
            {
                var key = period == GradePeriods.Midterm ? "midterm" : "final-term";
                var isFinal = period == GradePeriods.FinalTerm;

                <div class="gw-tabpanel" role="tabpanel" id="panel-@key" aria-labelledby="tab-@key" hidden="@(key == Model.ActiveTab ? null : "hidden")">
                    @if (!(isFinal ? Model.FinalSet : Model.MidtermSet))
                    {
                        <div class="gw-panel-body gw-empty-block">
                            No @period categories yet.
                            @Html.ActionLink("Set the categories", "Categories", "Faculty", new { id = Model.CourseId }, null)
                        </div>
                    }
                    else
                    {
                        <div class="gw-table-wrap">
                            <table class="gw-table gw-score-table">
                                <thead>
                                    <tr>
                                        <th class="gw-sticky-col">Student</th>
                                        @foreach (var c in Model.Categories)
                                        {
                                            if (GradePeriods.Normalize(c.Period) != period) { continue; }
                                            <th class="gw-num">@c.Name<br /><span class="gw-th-sub">@GradeCalculator.Format(c.Weight)%</span></th>
                                        }
                                        <th class="gw-num">Earned Grade<br /><span class="gw-th-sub">of 100</span></th>
                                        <th class="gw-num">Equivalent</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in Model.Rows)
                                    {
                                        var result = isFinal ? row.FinalResult : row.MidtermResult;
                                        <tr>
                                            <td class="gw-sticky-col">
                                                @row.FullName
                                                <div class="gw-muted gw-small">@row.StudentNo</div>
                                            </td>
                                            @for (var i = 0; i < Model.Categories.Count; i++)
                                            {
                                                var category = Model.Categories[i];
                                                if (GradePeriods.Normalize(category.Period) != period) { continue; }
                                                <td class="gw-num">
                                                    <input type="number" min="0" max="100" step="any" inputmode="decimal"
                                                           class="gw-score-input @(row.Invalid[i] ? "gw-input-bad" : "")"
                                                           name="@CourseService.ScoreFieldName(row.StudentId, category.Name)"
                                                           value="@row.Inputs[i]"
                                                           placeholder="&mdash;"
                                                           aria-label="@category.Name score for @row.FullName" />
                                                </td>
                                            }
                                            <td class="gw-num"><strong>@GradeCalculator.Format(result.EarnedOrNull)</strong></td>
                                            <td class="gw-num">@GradeCalculator.Format(GradeCalculator.EquivalentFromEarned(result))</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="gw-panel-body">
                            <div class="gw-form-buttons">
                                <button type="submit" class="gw-btn">Save scores</button>
                            </div>
                        </div>
                    }
                </div>
            }

            <div class="gw-tabpanel" role="tabpanel" id="panel-final-grade" aria-labelledby="tab-final-grade" hidden="@("final-grade" == Model.ActiveTab ? null : "hidden")">
                <div class="gw-table-wrap">
                    <table class="gw-table gw-score-table">
                        <thead>
                            <tr>
                                <th class="gw-sticky-col">Student</th>
                                <th class="gw-num">Midterm Grade</th>
                                <th class="gw-num">Midterm Eq.</th>
                                <th class="gw-num">Final Term Grade</th>
                                <th class="gw-num">Final Term Eq.</th>
                                <th class="gw-num">Final Grade</th>
                                <th class="gw-num">Equivalent</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.Rows)
                            {
                                <tr>
                                    <td class="gw-sticky-col">
                                        @row.FullName
                                        <div class="gw-muted gw-small">@row.StudentNo</div>
                                    </td>
                                    <td class="gw-num">@GradeCalculator.Format(row.MidtermResult.EarnedOrNull)</td>
                                    <td class="gw-num">@GradeCalculator.Format(GradeCalculator.EquivalentFromEarned(row.MidtermResult))</td>
                                    <td class="gw-num">@GradeCalculator.Format(row.FinalResult.EarnedOrNull)</td>
                                    <td class="gw-num">@GradeCalculator.Format(GradeCalculator.EquivalentFromEarned(row.FinalResult))</td>
                                    <td class="gw-num"><strong>@GradeCalculator.Format(row.Result.EarnedOrNull)</strong></td>
                                    <td class="gw-num"><strong>@GradeCalculator.Format(GradeCalculator.EquivalentFromEarned(row.Result))</strong></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="gw-panel-body">
                    <p class="gw-note gw-note-first">This table is read only. Enter scores in the Midterm and Final Term tabs.</p>
                </div>
            </div>

            <div class="gw-panel-body">
                <p class="gw-note gw-note-first">
                    Scores are percentages from 0 to 100. Leave a box empty if the work is not graded yet.
                    <strong>Earned Grade</strong> is the points collected out of 100, and work that is not graded yet counts as 0.
                    <strong>Final Grade</strong> is the average of the Midterm and the Final Term.
                </p>
            </div>
        }
    }
</section>

<div id="gw-editcourse-modal" class="gw-modal-backdrop" hidden @(editErrors.Count > 0 ? "data-open-on-load" : null)>
    <div class="gw-panel gw-card-raised gw-modal-card" role="dialog" aria-modal="true" aria-labelledby="gw-editcourse-title">
        <div class="gw-panel-head">
            <h2 id="gw-editcourse-title" class="gw-panel-title">Edit course</h2>
        </div>
        <div class="gw-modal-top">
            <div class="gw-modal-meta">
                <span class="gw-muted">Change the code, name, section or term. Categories, students and scores stay as they are.</span>
            </div>
            <button type="button" class="gw-iconbtn gw-modal-close" data-modal-close aria-label="Close" title="Close">
                <img src="@Url.Content("~/Content/img/icons/close.svg")" alt="" width="20" height="20" />
            </button>
        </div>

        @using (Html.BeginForm("EditCourse", "Faculty", new { id = Model.CourseId }, FormMethod.Post, new { @class = "gw-editcourse-form" }))
        {
            @Html.AntiForgeryToken()
            <div class="gw-panel-body gw-editinfo-body">
                @if (editErrors.Count > 0)
                {
                    <div class="gw-alert" role="alert">
                        <strong>The course was not changed.</strong>
                        <ul class="gw-error-list">
                            @foreach (var e in editErrors)
                            {
                                <li>@e</li>
                            }
                        </ul>
                    </div>
                }

                <div class="gw-field">
                    <label for="gw-ec-code">Course code</label>
                    <input type="text" id="gw-ec-code" name="code" value="@editCode" maxlength="20" required data-autofocus />
                </div>
                <div class="gw-field">
                    <label for="gw-ec-name">Course name</label>
                    <input type="text" id="gw-ec-name" name="name" value="@editName" maxlength="100" required />
                </div>
                @if (edit.SectionNames.Count > 0)
                {
                    <div class="gw-field">
                        <label for="gw-ec-section">Section</label>
                        <select id="gw-ec-section" name="section">
                            <option value="">No section</option>
                            @foreach (var s in edit.SectionNames)
                            {
                                <option value="@s" selected="@(s == editSection)">@s</option>
                            }
                        </select>
                    </div>
                }
                else
                {
                    <div class="gw-field">
                        <label>Section</label>
                        <div class="gw-field-static">@(string.IsNullOrWhiteSpace(edit.Section) ? "No section" : edit.Section)</div>
                    </div>
                }
                <div class="gw-field">
                    <label for="gw-ec-term">Term</label>
                    <select id="gw-ec-term" name="term" required>
                        @foreach (var t in edit.TermNames)
                        {
                            <option value="@t" selected="@(t == editTerm)">@t</option>
                        }
                    </select>
                </div>
            </div>

            <div class="gw-modal-foot">
                <button type="submit" class="gw-btn">Save changes</button>
                <button type="button" class="gw-btn gw-btn-outline" data-modal-close>Cancel</button>
            </div>
        }
    </div>
</div>

@section scripts {
    <script>
        (function () {
            var tabs = [].slice.call(document.querySelectorAll('[role="tab"][data-tab]'));
            var hidden = document.getElementById("active-tab");
            if (!tabs.length) { return; }

            function selectTab(tab, focus) {
                tabs.forEach(function (t) {
                    var on = t === tab;
                    t.setAttribute("aria-selected", on ? "true" : "false");
                    t.tabIndex = on ? 0 : -1;
                    document.getElementById(t.getAttribute("aria-controls")).hidden = !on;
                });
                if (hidden) { hidden.value = tab.getAttribute("data-tab"); }
                if (focus) { tab.focus(); }
            }

            tabs.forEach(function (tab) {
                tab.addEventListener("click", function () { selectTab(tab, false); });
                tab.addEventListener("keydown", function (e) {
                    if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") { return; }
                    var next = tabs[(tabs.indexOf(tab) + (e.key === "ArrowRight" ? 1 : tabs.length - 1)) % tabs.length];
                    selectTab(next, true);
                });
            });
        })();
    </script>
}
