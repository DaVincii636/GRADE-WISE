@model GradeWise.Models.CategoriesViewModel
@using GradeWise.Models
@{
    ViewBag.Title = Model.Code + " categories";

    var message = TempData["Message"] as string;
    var error = TempData["Error"] as string;

    // Always leave two empty rows at the bottom so new categories can be typed straight away.
    var emptyRows = Model.Rows.Count(r => string.IsNullOrEmpty(r.Original) && string.IsNullOrWhiteSpace(r.Name) && string.IsNullOrWhiteSpace(r.Weight));
    var spare = System.Math.Max(0, (Model.Rows.Count == 0 ? 4 : 2) - emptyRows);
}

<h1 class="gw-page-title">@Model.Code &middot; Categories and weights</h1>
<p class="gw-page-sub">@Model.Name, @Model.Term</p>

@if (!string.IsNullOrEmpty(error))
{
    <div class="gw-alert" role="alert">@error</div>
}
@if (!string.IsNullOrEmpty(message))
{
    <div class="gw-alert gw-alert-ok" role="status">@message</div>
}
@if (Model.Errors.Count > 0)
{
    <div class="gw-alert" role="alert">
        <strong>Nothing was saved. Please fix the following:</strong>
        <ul class="gw-error-list">
            @foreach (var e in Model.Errors)
            {
                <li>@e</li>
            }
        </ul>
    </div>
}

<div class="gw-toolbar">
    @Html.ActionLink("Back to scores", "Course", "Faculty", new { id = Model.CourseId }, new { @class = "gw-btn gw-btn-outline" })
</div>

<section class="gw-panel gw-form-narrow">
    <div class="gw-panel-head">
        <h2 class="gw-panel-title">Grading categories</h2>
    </div>
    <div class="gw-panel-body">
        <p class="gw-field-hint gw-hint-block">
            Put every category in the Midterm or the Final Term. Inside each term the weights add up to exactly 100,
            and the final grade is half Midterm and half Final Term. Each name must be unique in the course, for example
            Midterm Quizzes and Final Quizzes. Renaming or moving a category keeps its scores; removing one deletes them.
        </p>

        @using (Html.BeginForm("Categories", "Faculty", new { id = Model.CourseId }, FormMethod.Post, new { id = "cat-form" }))
        {
            @Html.AntiForgeryToken()
            <table class="gw-cat-table gw-field-table">
                <thead>
                    <tr>
                        <th>Category</th>
                        <th>Period</th>
                        <th>Weight (%)</th>
                        <th><span class="gw-sr-only">Remove</span></th>
                    </tr>
                </thead>
                <tbody id="cat-body">
                    @foreach (var r in Model.Rows)
                    {
                        <tr>
                            <td>
                                <input type="hidden" name="originals" value="@r.Original" />
                                <input type="text" name="names" value="@r.Name" maxlength="40" aria-label="Category name" />
                            </td>
                            <td>
                                <select name="periods" aria-label="Period">
                                    @foreach (var p in GradePeriods.All)
                                    {
                                        <option value="@p" selected="@(p == r.Period)">@p</option>
                                    }
                                </select>
                            </td>
                            <td><input type="number" name="weights" value="@r.Weight" min="0.01" max="100" step="any" inputmode="decimal" aria-label="Weight in percent" /></td>
                            <td><button type="button" class="gw-btn gw-btn-small gw-btn-outline" data-remove="1">Remove</button></td>
                        </tr>
                    }
                    @for (var i = 0; i < spare; i++)
                    {
                        <tr>
                            <td>
                                <input type="hidden" name="originals" value="" />
                                <input type="text" name="names" value="" maxlength="40" aria-label="Category name" />
                            </td>
                            <td>
                                <select name="periods" aria-label="Period">
                                    @foreach (var p in GradePeriods.All)
                                    {
                                        <option value="@p">@p</option>
                                    }
                                </select>
                            </td>
                            <td><input type="number" name="weights" value="" min="0.01" max="100" step="any" inputmode="decimal" aria-label="Weight in percent" /></td>
                            <td><button type="button" class="gw-btn gw-btn-small gw-btn-outline" data-remove="1">Remove</button></td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="gw-period-totals" aria-live="polite">
                @foreach (var p in GradePeriods.All)
                {
                    <div class="gw-period-total" data-period="@p">
                        <span class="gw-period-name">@p</span>
                        <span><strong class="gw-total-number" data-total>0</strong> / 100</span>
                        <span class="gw-muted" data-left>(100 left)</span>
                    </div>
                }
            </div>

            <div class="gw-form-buttons">
                <button type="submit" class="gw-btn">Save categories</button>
                <button type="button" class="gw-btn gw-btn-outline" id="cat-add">Add category</button>
            </div>
        }
    </div>
</section>

@section scripts {
    <script>
        (function () {
            var PERIODS = ["Midterm", "Final Term"];
            var body = document.getElementById("cat-body");
            var form = document.getElementById("cat-form");
            var confirmed = false;

            function round2(n) { return Math.round(n * 100) / 100; }

            function liveRows() {
                // removed rows are hidden (and emptied), so they never count
                return [].slice.call(body.querySelectorAll("tr")).filter(function (tr) { return !tr.hidden; });
            }

            function periodOf(tr) { return tr.querySelector("select[name=periods]").value; }
            function weightOf(tr) { return tr.querySelector("input[name=weights]"); }

            function totalFor(period, skipRow) {
                var total = 0;
                liveRows().forEach(function (tr) {
                    if (tr === skipRow || periodOf(tr) !== period) { return; }
                    var v = parseFloat(weightOf(tr).value);
                    if (!isNaN(v)) { total += v; }
                });
                return round2(total);
            }

            // A period can never go over 100: cut the typed value down to what is left.
            function clampRow(tr) {
                var input = weightOf(tr);
                var v = parseFloat(input.value);
                if (isNaN(v)) { return; }
                var max = round2(100 - totalFor(periodOf(tr), tr));
                if (max <= 0) { input.value = ""; }
                else if (v > max) { input.value = max; }
            }

            function refresh() {
                PERIODS.forEach(function (p) {
                    var box = document.querySelector('.gw-period-total[data-period="' + p + '"]');
                    var total = totalFor(p, null);
                    var left = round2(100 - total);
                    box.querySelector("[data-total]").textContent = total;
                    box.querySelector("[data-left]").textContent = "(" + (left > 0 ? left + " left" : "full") + ")";
                });
            }

            function nextPeriod() {
                for (var i = 0; i < PERIODS.length; i++) {
                    if (totalFor(PERIODS[i], null) < 100) { return PERIODS[i]; }
                }
                return PERIODS[0];
            }

            document.getElementById("cat-add").addEventListener("click", function () {
                var period = nextPeriod();
                var tr = document.createElement("tr");
                var options = PERIODS.map(function (p) {
                    return '<option value="' + p + '"' + (p === period ? " selected" : "") + ">" + p + "</option>";
                }).join("");
                tr.innerHTML =
                    '<td><input type="hidden" name="originals" value="" />' +
                    '<input type="text" name="names" maxlength="40" aria-label="Category name" /></td>' +
                    '<td><select name="periods" aria-label="Period">' + options + "</select></td>" +
                    '<td><input type="number" name="weights" min="0.01" max="100" step="any" inputmode="decimal" aria-label="Weight in percent" /></td>' +
                    '<td><button type="button" class="gw-btn gw-btn-small gw-btn-outline" data-remove="1">Remove</button></td>';
                body.appendChild(tr);
                tr.querySelector("input[name=names]").focus();
            });

            // Remove = empty the row and hide it. The server ignores empty rows.
            body.addEventListener("click", function (e) {
                var btn = e.target;
                if (!btn.getAttribute || !btn.getAttribute("data-remove")) { return; }
                var tr = btn.closest("tr");
                var original = tr.querySelector("input[name=originals]").value;
                var name = tr.querySelector("input[name=names]");
                var weight = weightOf(tr);
                if (original && name.value) { tr.setAttribute("data-removed", name.value); }
                name.value = "";
                weight.value = "";
                tr.hidden = true;
                refresh();
            });

            body.addEventListener("input", function (e) {
                if (e.target.name === "weights") { clampRow(e.target.closest("tr")); }
                refresh();
            });

            body.addEventListener("change", function (e) {
                if (e.target.name === "periods") { clampRow(e.target.closest("tr")); }
                refresh();
            });

            // Warn before saving if a category that has scores is being removed.
            form.addEventListener("submit", function (e) {
                if (confirmed) { return; }

                var removed = [];
                body.querySelectorAll("tr").forEach(function (tr) {
                    var original = tr.querySelector("input[name=originals]").value;
                    var name = tr.querySelector("input[name=names]").value.trim();
                    var weight = weightOf(tr).value.trim();
                    if (original && !name && !weight) { removed.push(original); }
                });
                if (removed.length === 0) { return; }

                e.preventDefault();
                GW.confirm({
                    title: "Delete category scores?",
                    message: "Removing " + removed.join(", ") + " deletes the scores already entered for it.",
                    okText: "Delete",
                    tone: "danger"
                }).then(function (ok) {
                    if (!ok) { return; }
                    confirmed = true;
                    HTMLFormElement.prototype.submit.call(form);
                });
            });

            refresh();
        })();
    </script>
}
