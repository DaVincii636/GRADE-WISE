@model GradeWise.Models.StudentDashboardViewModel
@using System
@using System.Collections.Generic
@using System.Globalization
@using System.Linq
@using GradeWise.Services
@{
    // Oldest first, as the service returns them. The chart plots Earned Grade (points out of 100).
    var points = Model.History;

    // The table starts with this many rows; "Show more" reveals more, ten at a time; "Show less" goes back.
    const int FirstShown = 5;
    const int MoreStep = 10;

    // Chart size and margins. Earned Grade runs from 0 to 100 up the side.
    const double W = 600, H = 190, L = 40, R = 16, T = 12, B = 30;
    var pass = GradeCalculator.PassingAverage;
    Func<int, double> px = i => points.Count == 1 ? L + (W - L - R) / 2 : L + (W - L - R) * i / (points.Count - 1);
    Func<double, double> py = v => T + (H - T - B) * (1 - v / 100.0);

    // Razor treats the SVG text tag as its own tag, so the chart labels are built as plain strings (fixed words and numbers only).
    Func<double, double, string, string, string> label = (x, y, anchor, content) =>
        "<text class=\"gw-chart-label\" x=\"" + GradeCalculator.Raw(x) + "\" y=\"" + GradeCalculator.Raw(y)
        + "\" text-anchor=\"" + anchor + "\">" + content + "</text>";

    // Points for the ink line, and the same points closed along the bottom for the lime area fill.
    var linePoints = string.Join(" ", points.Select((p, i) => GradeCalculator.Raw(px(i)) + "," + GradeCalculator.Raw(py(p.Earned))));
    var areaPoints = linePoints + " " + GradeCalculator.Raw(W - R) + "," + GradeCalculator.Raw(H - B)
        + " " + GradeCalculator.Raw(L) + "," + GradeCalculator.Raw(H - B);

    var hiddenCount = Math.Max(0, points.Count - FirstShown);

    // Names the scope in the heading and the grade column ("Midterm grade", "Final Term grade", "Final Grade").
    var gradeHead = Model.Scope == GradeWise.Models.GradeScopes.FinalGrade ? "Final Grade" : Model.ScopeLabel + " grade";
}

<section class="gw-panel gw-history-panel">
    <div class="gw-panel-head">
        <h2 class="gw-panel-title">Progress history (@Model.ScopeLabel)</h2>
    </div>

    @if (Model.HistoryHidden > 0)
    {
        <div class="gw-panel-body gw-history-note">
            <p class="gw-muted gw-small">
                @Model.HistoryHidden earlier @(Model.HistoryHidden == 1 ? "entry was" : "entries were") saved before Midterm and Final Term were tracked separately;
                @(Model.HistoryHidden == 1 ? "it appears" : "they appear") under Final Grade.
            </p>
        </div>
    }

    @if (points.Count == 0)
    {
        <div class="gw-panel-body gw-empty-state">
            <img src="@Url.Content("~/Content/img/stickers/mascot-cat.svg")" alt="" class="gw-empty-mascot" width="72" height="72" />
            <p class="gw-empty-title">No history yet</p>
            <p class="gw-muted">A snapshot of your @(Model.Scope == GradeWise.Models.GradeScopes.FinalGrade ? "Final Grade" : Model.ScopeLabel + " grade") is saved each time your instructor updates your scores.</p>
        </div>
    }
    else
    {
        if (points.Count >= 2)
        {
            <div class="gw-panel-body">
                <svg class="gw-chart" viewBox="0 0 @W @H" role="img"
                     aria-label="Line chart of your @gradeHead over time, from @GradeCalculator.Format(points[0].Earned) to @GradeCalculator.Format(points[points.Count - 1].Earned) out of 100. Passing is @(pass.ToString("0")).">
                    @foreach (var tick in new[] { 0, 50, 100 })
                    {
                        <line class="gw-chart-grid" x1="@GradeCalculator.Raw(L)" x2="@GradeCalculator.Raw(W - R)" y1="@GradeCalculator.Raw(py(tick))" y2="@GradeCalculator.Raw(py(tick))" />
                        @Html.Raw(label(L - 6, py(tick) + 4, "end", tick.ToString()))
                    }
                    <line class="gw-chart-pass" x1="@GradeCalculator.Raw(L)" x2="@GradeCalculator.Raw(W - R)" y1="@GradeCalculator.Raw(py(pass))" y2="@GradeCalculator.Raw(py(pass))" />
                    @Html.Raw(label(L - 6, py(pass) + 4, "end", pass.ToString("0")))
                    @Html.Raw(label(W - R, py(pass) - 4, "end", "passing " + pass.ToString("0")))

                    <polygon class="gw-chart-area" points="@areaPoints" />
                    <polyline class="gw-chart-line" points="@linePoints" />

                    @for (var i = 0; i < points.Count; i++)
                    {
                        <circle class="gw-chart-dot" cx="@GradeCalculator.Raw(px(i))" cy="@GradeCalculator.Raw(py(points[i].Earned))" r="4">
                            <title>@points[i].Label: @gradeHead @GradeCalculator.Format(points[i].Earned)</title>
                        </circle>
                    }
                </svg>
            </div>
        }

        <div class="gw-table-wrap">
            <table class="gw-table gw-history-table" id="gw-history-table">
                <thead>
                    <tr>
                        <th>When</th>
                        <th>What changed</th>
                        <th class="gw-num">@gradeHead</th>
                        <th class="gw-num">Equivalent</th>
                        <th class="gw-num">Change</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = points.Count - 1; i >= 0; i--)
                    {
                        var h = points[i];
                        var rowNumber = points.Count - 1 - i;   // 0 is the newest row

                        // "A, B, C and 2 more" becomes "A, B, C" + a button; the button swaps in the full list (h.Details).
                        var more = System.Text.RegularExpressions.Regex.Match(h.Summary ?? "", @"^(.*) and (\d+) more$");
                        var canExpand = more.Success && !string.IsNullOrEmpty(h.Details) && h.Details != h.Summary;
                        <tr class="gw-history-row" hidden="@(rowNumber >= FirstShown)">
                            <td><time class="gw-history-time" datetime="@h.Iso">@h.Label</time></td>
                            <td class="gw-history-what" title="@h.Details">
                                @if (canExpand)
                                {
                                    <span class="gw-what-short">@more.Groups[1].Value</span>
                                    <button type="button" class="gw-what-toggle gw-what-more" aria-expanded="false">and @more.Groups[2].Value more</button>
                                    <span class="gw-what-full" hidden>@h.Details <button type="button" class="gw-what-toggle gw-what-less" aria-expanded="true">show less</button></span>
                                }
                                else
                                {
                                    @h.Summary
                                }
                            </td>
                            <td class="gw-num">@GradeCalculator.Format(h.Earned)</td>
                            <td class="gw-num">@GradeCalculator.Format(h.Equivalent)</td>
                            <td class="gw-num">
                                @if (h.Change.HasValue)
                                {
                                    @((h.Change.Value >= 0 ? "+" : "") + GradeCalculator.Format(h.Change))
                                }
                                else
                                {
                                    <span class="gw-muted">&mdash;</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        if (hiddenCount > 0)
        {
            <div class="gw-panel-body gw-history-more">
                <button type="button" class="gw-btn gw-btn-small gw-btn-outline" id="gw-history-more" data-step="@MoreStep">Show more (@hiddenCount)</button>
                <button type="button" class="gw-btn gw-btn-small gw-btn-outline" id="gw-history-less" data-first="@FirstShown" hidden>Show less</button>
            </div>
        }
    }
</section>

<script>
    (function () {
        function pad(n) { return n < 10 ? "0" + n : String(n); }

        // Show each time in the viewer's own time zone as MM/DD/YYYY h:mm AM/PM.
        var times = document.querySelectorAll("time.gw-history-time[datetime]");
        for (var t = 0; t < times.length; t++) {
            var d = new Date(times[t].getAttribute("datetime"));
            if (isNaN(d.getTime())) continue;
            var hours = d.getHours();
            var suffix = hours >= 12 ? "PM" : "AM";
            hours = hours % 12;
            if (hours === 0) hours = 12;
            times[t].textContent = pad(d.getMonth() + 1) + "/" + pad(d.getDate()) + "/" + d.getFullYear() +
                " " + hours + ":" + pad(d.getMinutes()) + " " + suffix;
        }

        // "and N more" in the What changed column: show the full list, "show less" folds it back.
        document.addEventListener("click", function (e) {
            var btn = e.target && e.target.closest ? e.target.closest(".gw-what-toggle") : null;
            if (!btn) return;
            var cell = btn.closest(".gw-history-what");
            if (!cell) return;
            var expand = btn.classList.contains("gw-what-more");
            var shortText = cell.querySelector(".gw-what-short");
            var moreBtn = cell.querySelector(".gw-what-more");
            var full = cell.querySelector(".gw-what-full");
            var lessBtn = cell.querySelector(".gw-what-less");
            if (!shortText || !moreBtn || !full || !lessBtn) return;
            shortText.hidden = expand;
            moreBtn.hidden = expand;
            full.hidden = !expand;
            moreBtn.setAttribute("aria-expanded", expand ? "true" : "false");
            (expand ? lessBtn : moreBtn).focus();
        });

        // "Show more" reveals up to ten more rows. "Show less" goes back to the first five.
        var more = document.getElementById("gw-history-more");
        var less = document.getElementById("gw-history-less");
        var table = document.getElementById("gw-history-table");
        if (!more || !less || !table) return;
        var step = parseInt(more.getAttribute("data-step"), 10) || 10;
        var first = parseInt(less.getAttribute("data-first"), 10) || 5;

        function rows() { return table.querySelectorAll("tr.gw-history-row"); }

        function refresh() {
            var all = rows();
            var hiddenCount = 0;
            for (var i = 0; i < all.length; i++) {
                if (all[i].hasAttribute("hidden")) hiddenCount++;
            }
            more.textContent = "Show more (" + hiddenCount + ")";
            more.hidden = hiddenCount === 0;
            less.hidden = all.length - hiddenCount <= first;
        }

        more.addEventListener("click", function () {
            var all = rows();
            var left = step;
            for (var i = 0; i < all.length && left > 0; i++) {
                if (all[i].hasAttribute("hidden")) {
                    all[i].removeAttribute("hidden");
                    left--;
                }
            }
            refresh();
            if (more.hidden) less.focus();
        });

        less.addEventListener("click", function () {
            var all = rows();
            for (var i = first; i < all.length; i++) all[i].setAttribute("hidden", "");
            refresh();
            (table.tHead || table).scrollIntoView({ block: "nearest" });
            more.focus();
        });
    })();
</script>
