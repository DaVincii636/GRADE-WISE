@model GradeWise.Models.StudentDashboardViewModel
@using GradeWise.Models
@using GradeWise.Services
@{
    ViewBag.Title = "Grade summary";
    var equivalentText = Model.Incomplete ? "INC" : GradeCalculator.Format(Model.Equivalent);
}

<div class="gw-toolbar gw-summary-toolbar gw-no-print">
    @Html.ActionLink("Back to course", "Course", "Student", new { id = Model.SelectedId }, new { @class = "gw-btn gw-btn-outline" })
    @if (Model.HasCourse)
    {
        <button type="button" id="print-summary" class="gw-btn"><img src="@Url.Content("~/Content/img/icons/print.svg")" alt="" width="18" height="18" /> Print or save as PDF</button>
    }
</div>

@if (!Model.HasCourse)
{
    <section class="gw-panel">
        <div class="gw-panel-body gw-empty-block">
            You are not enrolled in any course yet, so there is nothing to print.
        </div>
    </section>
}
else
{
    <article class="gw-summary gw-summary-sheet gw-faculty-courses gw-fcourse gw-student-grades">
        <header class="gw-summary-head">
            <h1 class="gw-page-title">Grade summary</h1>
            <p class="gw-page-sub">GRADE-WISE &middot; printed @DateTime.Now.ToString("MMMM d, yyyy", System.Globalization.CultureInfo.InvariantCulture)</p>
        </header>

        <section class="gw-panel gw-summary-facts" aria-labelledby="summary-facts-title">
            <div class="gw-panel-head">
                <h2 id="summary-facts-title" class="gw-panel-title">Student details</h2>
            </div>
            <div class="gw-panel-body">
                <dl class="gw-facts">
                    <div><dt>Student</dt><dd>@Model.StudentName (@Model.StudentNo)</dd></div>
                    <div><dt>Course</dt><dd>@Model.Code &middot; @Model.Name</dd></div>
                    <div><dt>Term</dt><dd>@Model.Term</dd></div>
                    <div><dt>Showing</dt><dd>@Model.ScopeLabel</dd></div>
                </dl>
            </div>
        </section>

        @if (!Model.HasCategories)
        {
            <div class="gw-alert gw-alert-warn" role="status">
                No @Model.ScopeLabel grading categories are set yet, so there is nothing to summarize.
            </div>
        }
        else if (!Model.WeightsOk)
        {
            <div class="gw-alert gw-alert-warn" role="status">
                The @Model.ScopeLabel weights add up to <strong>@GradeCalculator.Format(Model.WeightTotal)%</strong>, not 100%. These numbers may change once they are fixed.
            </div>
        }

        <section class="gw-stats" aria-label="Summary">
            <div class="gw-stat gw-stat-lime" data-tab="Earned">
                <div class="gw-stat-value">@GradeCalculator.Format(Model.EarnedGrade)</div>
                <div class="gw-stat-label">Earned <span class="gw-th-sub">(/100, ungraded counts as 0)</span></div>
            </div>
            <div class="gw-stat gw-stat-blue" data-tab="Equivalent">
                <div class="gw-stat-value">@equivalentText</div>
                <div class="gw-stat-label">Equivalent grade <span class="gw-th-sub">(Eq.)</span></div>
            </div>
            <div class="gw-stat gw-stat-gold" data-tab="Remaining">
                <div class="gw-stat-value">@(Model.HasCategories ? GradeCalculator.Format(Model.RemainingWeight) + "%" : "\u2014")</div>
                <div class="gw-stat-label">Remaining weight <span class="gw-th-sub">(not graded yet)</span></div>
            </div>
        </section>

        @Html.Partial("_GradeTables", Model, new ViewDataDictionary(ViewData) { { "Print", true } })

        @Html.Partial("_History", Model)

        <p class="gw-summary-note">
            Your own scores only. A copy of GRADE-WISE as of the date above, not an official transcript.
        </p>
    </article>
}

@section scripts {
    <script>
        var printButton = document.getElementById("print-summary");
        if (printButton) {
            printButton.addEventListener("click", function () { window.print(); });
        }
    </script>
}
