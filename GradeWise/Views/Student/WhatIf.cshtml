@model GradeWise.Models.WhatIfViewModel
@using GradeWise.Services
@{
    ViewBag.Title = "What-If simulator";
    // Final Grade keeps the plain wording; Midterm and Final Term name the period.
    var isFinalGrade = Model.Scope == GradeWise.Models.GradeScopes.FinalGrade;
    var projectedLabel = isFinalGrade ? "Projected final grade" : "Projected " + Model.ScopeLabel + " grade";
    var targetLabel = isFinalGrade ? "Target final grade" : "Target " + Model.ScopeLabel + " grade";
}

<h1 class="gw-page-title">What-If simulator</h1>
<p class="gw-page-sub">
    Try different scores for your remaining work and see where your @(isFinalGrade ? "final" : Model.ScopeLabel) grade could land.
    @if (Model.HasCourse)
    {
        <span class="gw-badge">Showing: @Model.ScopeLabel</span>
    }
</p>

@if (!Model.HasCourse)
{
    <section class="gw-panel">
        <div class="gw-panel-body gw-empty-state">
            <img src="@Url.Content("~/Content/img/stickers/mascot-cat.svg")" alt="" class="gw-empty-mascot" width="72" height="72" />
            <p class="gw-empty-title">Nothing to simulate yet</p>
            <p class="gw-muted">You are not enrolled in any course yet. Your instructor enrolls you, and the simulator is available once they do.</p>
        </div>
    </section>
}
else
{
    <section class="gw-panel gw-picker-panel">
        <div class="gw-panel-body">
            <div class="gw-picker">
                <label for="course-picker">Course</label>
                <select id="course-picker" class="gw-inline-select"
                        data-url="@Url.Action("WhatIf", "Student", new { id = "__ID__" })">
                    @foreach (var c in Model.Courses)
                    {
                        <option value="@c.Id" selected="@(c.Id == Model.SelectedId)">@c.Code &middot; @c.Name</option>
                    }
                </select>
                @Html.ActionLink("Back to my grades", "Index", "Student", new { id = Model.SelectedId }, new { @class = "gw-btn gw-btn-small gw-btn-outline" })
                <span class="gw-muted">@Model.Term</span>
            </div>
        </div>
    </section>

    if (!Model.HasCategories)
    {
        <div class="gw-alert gw-alert-warn" role="status">
            Your instructor has not set the @Model.ScopeLabel grading categories for this course yet, so there is nothing to simulate.
        </div>
    }
    else if (!Model.WeightsOk)
    {
        <div class="gw-alert gw-alert-warn" role="status">
            The @Model.ScopeLabel grading weights for this course add up to <strong>@GradeCalculator.Format(Model.WeightTotal)%</strong>, not 100%.
            The simulator is switched off until your instructor fixes them, because the results would not be reliable.
        </div>
    }
    else if (Model.NothingLeft)
    {
        <section class="gw-stats" aria-label="Final result">
            <div class="gw-stat" data-tab="Final">
                <div class="gw-stat-value">@GradeCalculator.Format(Model.Earned)%</div>
                <div class="gw-stat-label">@(isFinalGrade ? "Final grade" : Model.ScopeLabel + " grade")</div>
            </div>
            <div class="gw-stat" data-tab="Grade">
                <div class="gw-stat-value">@GradeCalculator.Format(Model.Equivalent)</div>
                <div class="gw-stat-label">Equivalent grade</div>
            </div>
        </section>
        <div class="gw-alert gw-alert-ok" role="status">
            Every @Model.ScopeLabel category in this course is already graded, so there is nothing left to simulate.
        </div>
    }
    else
    {
        <div id="whatif"
             data-earned="@GradeCalculator.Raw(Model.Earned)"
             data-remaining="@GradeCalculator.Raw(Model.RemainingWeight)"
             data-default="@GradeCalculator.Raw(Model.DefaultScore)"
             data-target="@GradeCalculator.Raw(GradeCalculator.PassingAverage)">

            <section class="gw-stats" aria-label="Projection">
                <div class="gw-stat" data-tab="Earned">
                    <div class="gw-stat-value">@GradeCalculator.Format(Model.Earned)</div>
                    <div class="gw-stat-label">Points earned so far <span class="gw-th-sub">(out of @GradeCalculator.Format(Model.WeightTotal))</span></div>
                </div>
                <div class="gw-stat" data-tab="Remaining">
                    <div class="gw-stat-value">@GradeCalculator.Format(Model.RemainingWeight)%</div>
                    <div class="gw-stat-label">Remaining weight <span class="gw-th-sub">(still to be graded)</span></div>
                </div>
                <div class="gw-stat gw-stat-live" data-tab="Projected">
                    <div class="gw-stat-value" id="sim-final" aria-live="polite">&mdash;</div>
                    <div class="gw-stat-label">@projectedLabel</div>
                </div>
                <div class="gw-stat gw-stat-live" data-tab="Grade">
                    <div class="gw-stat-value" id="sim-grade" aria-live="polite">&mdash;</div>
                    <div class="gw-stat-label">Projected equivalent grade</div>
                </div>
            </section>

            <section class="gw-panel">
                <div class="gw-panel-head">
                    <h2 class="gw-panel-title">Your scenario</h2>
                </div>
                <div class="gw-panel-body">
                    <p class="gw-hint-block gw-muted">
                        Drag a slider, or type a score, for each category that is not graded yet. The projected grade above updates as you go.
                    </p>
                    <div class="gw-table-wrap">
                        <table class="gw-table gw-sim-table">
                            <thead>
                                <tr>
                                    <th>Category</th>
                                    <th class="gw-num">Weight</th>
                                    <th>Score you might get</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in Model.Ungraded)
                                {
                                    <tr class="gw-sim-row" data-weight="@GradeCalculator.Raw(c.Weight)">
                                        <td>@c.Name</td>
                                        <td class="gw-num">@GradeCalculator.Format(c.Weight)%</td>
                                        <td>
                                            <div class="gw-sim-control">
                                                <input type="range" class="gw-sim-range" min="0" max="100" step="1"
                                                       value="@GradeCalculator.Raw(Model.DefaultScore)"
                                                       aria-label="Score slider for @c.Name" />
                                                <input type="number" class="gw-score-input gw-sim-num" min="0" max="100" step="0.01"
                                                       value="@GradeCalculator.Raw(Model.DefaultScore)"
                                                       aria-label="Score for @c.Name" />
                                                <span class="gw-muted">/ 100</span>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div id="sim-scenario-msg" class="gw-alert gw-sim-msg" role="status" style="display:none"></div>
                    <div class="gw-form-buttons">
                        <button type="button" id="sim-reset" class="gw-btn gw-btn-small gw-btn-outline">Reset</button>
                    </div>
                </div>
            </section>

            <section class="gw-panel">
                <div class="gw-panel-head">
                    <h2 class="gw-panel-title">Target grade</h2>
                </div>
                <div class="gw-panel-body">
                    <p class="gw-hint-block gw-muted">
                        Pick the @(isFinalGrade ? "final" : Model.ScopeLabel) grade you are aiming for and see what your remaining work needs to average.
                    </p>

                    <div class="gw-chips" role="group" aria-label="Target equivalent grade">
                        @foreach (var step in Model.Scale)
                        {
                            <button type="button" class="gw-chip" aria-pressed="false"
                                    data-min="@GradeCalculator.Raw(step.MinAverage)" data-grade="@GradeCalculator.Raw(step.Grade)">
                                @GradeCalculator.Format(step.Grade) <span class="gw-th-sub">@step.MinAverage.ToString("0")%</span>
                            </button>
                        }
                    </div>

                    <div class="gw-sim-control gw-sim-target">
                        <label for="sim-target-num" class="gw-sim-label">@targetLabel</label>
                        <input type="range" id="sim-target-range" min="0" max="100" step="0.5" value="@GradeCalculator.Raw(GradeCalculator.PassingAverage)"
                               aria-label="Target slider" />
                        <input type="number" id="sim-target-num" class="gw-score-input" min="0" max="100" step="0.01" value="@GradeCalculator.Raw(GradeCalculator.PassingAverage)" />
                        <span class="gw-muted">%</span>
                    </div>

                    <div id="sim-target-msg" class="gw-alert gw-sim-msg" role="status" aria-live="polite"></div>
                    <p id="sim-compare" class="gw-muted gw-sim-compare" aria-live="polite"></p>
                    <button type="button" id="sim-apply" class="gw-btn gw-btn-small" style="display:none">Use this score for all remaining work</button>
                </div>
            </section>
        </div>

        if (Model.Graded.Count > 0)
        {
            <section class="gw-panel">
                <div class="gw-panel-head">
                    <h2 class="gw-panel-title">Already graded</h2>
                </div>
                <div class="gw-table-wrap">
                    <table class="gw-table">
                        <thead>
                            <tr>
                                <th>Category</th>
                                <th class="gw-num">Weight</th>
                                <th class="gw-num">Your score</th>
                                <th class="gw-num">Weighted points</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.Graded)
                            {
                                <tr>
                                    <td>@r.Category</td>
                                    <td class="gw-num">@GradeCalculator.Format(r.Weight)%</td>
                                    <td class="gw-num">@GradeCalculator.Format(r.Score)</td>
                                    <td class="gw-num">@GradeCalculator.Format(r.WeightedPoints)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }

        <section class="gw-panel gw-calc" aria-label="How this is calculated">
            <div class="gw-panel-head">
                <h2 class="gw-panel-title">How this is calculated</h2>
            </div>
            <div class="gw-panel-body">
                <p class="gw-hint-block gw-muted">
                    Your @projectedLabel.ToLowerInvariant() is the points you have already earned, plus the points your remaining work could add.
                    Each category adds <strong>weight &times; score &divide; 100</strong>. This table uses your own numbers and changes as you move the sliders.
                </p>
                <div class="gw-table-wrap">
                    <table class="gw-table gw-calc-table">
                        <thead>
                            <tr>
                                <th>Part</th>
                                <th>Working</th>
                                <th class="gw-num">Points</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <th scope="row">Earned so far</th>
                                <td class="gw-calc-note">Graded work, already counted</td>
                                <td class="gw-num">@GradeCalculator.Format(Model.Earned)</td>
                            </tr>
                            @foreach (var c in Model.Ungraded)
                            {
                                <tr class="gw-calc-row">
                                    <th scope="row">@c.Name</th>
                                    <td class="gw-calc-note"><span class="gw-calc-formula">&mdash;</span></td>
                                    <td class="gw-num gw-calc-points">&mdash;</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th scope="row">@projectedLabel</th>
                                <td class="gw-calc-note" id="calc-sum" aria-live="polite">&mdash;</td>
                                <td class="gw-num" id="calc-total">&mdash;</td>
                            </tr>
                            <tr>
                                <th scope="row">Equivalent grade</th>
                                <td class="gw-calc-note">Looked up on the grade scale (@GradeCalculator.Format(GradeCalculator.PassingAverage)% is the lowest passing average)</td>
                                <td class="gw-num" id="calc-grade">&mdash;</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
                <p class="gw-note">Each line is rounded to two decimals for display; the total is worked out from the exact values.</p>
            </div>
        </section>
    }
}

@section scripts {
    <script src="@Url.Content("~/Scripts/whatif.js")?v=@System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Scripts/whatif.js")).Ticks"></script>
    <script>
        // Switch course as soon as another one is picked. The address is built from the page's own route,
        // so the course you are leaving can never be sent along with the new one.
        var picker = document.getElementById("course-picker");
        if (picker) {
            picker.addEventListener("change", function () {
                var template = picker.getAttribute("data-url");
                if (!template || !picker.value) return;
                window.location.href = template.replace("__ID__", encodeURIComponent(picker.value));
            });
        }
    </script>
}
