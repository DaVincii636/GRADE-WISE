@model GradeWise.Models.WhatIfViewModel
@using GradeWise.Models
@using GradeWise.Services
@{
    ViewBag.Title = "What-If simulator";
    // Final Grade keeps the plain wording; Midterm and Final Term name the period.
    var isFinalGrade = Model.Scope == GradeWise.Models.GradeScopes.FinalGrade;
    var projectedLabel = isFinalGrade ? "Projected final grade" : "Projected " + Model.ScopeLabel + " grade";
    var targetLabel = isFinalGrade ? "Target final grade" : "Target " + Model.ScopeLabel + " grade";

    // Dot colours cycle through the same accents the faculty My courses page uses.
    var tones = new[] { "lime", "blue", "gold", "lav", "orange" };

    // Same colour for a category as in the score table: its place inside its own term.
    Func<string, string, string> toneOf = (period, name) =>
    {
        int pos;
        Model.Positions.TryGetValue(period + "|" + name, out pos);
        return tones[pos % tones.Length];
    };

    // Passing mark is 65: lime at 75 and above, gold from 65, orange below (same as the faculty table).
    Func<double?, string> gradeTone = v => !v.HasValue ? "none" : v.Value >= 75 ? "high" : v.Value >= GradeCalculator.PassingAverage ? "mid" : "low";

    // Faculty grouping: Class Standing then Exam. On the Final Grade view each term gets its own pair.
    Func<string, string, string> blockName = (period, group) => isFinalGrade ? period + " \u00b7 " + group : group;
    var weightOf = isFinalGrade ? "of final" : "of term";

    var ungradedBlocks = GradePeriods.All
        .SelectMany(p => GradeGroups.All.Select(g => new
        {
            Name = blockName(p, g),
            Key = g == GradeGroups.Exam ? "ex" : "cs",
            Items = Model.Ungraded.Where(c => GradePeriods.Normalize(c.Period) == p && GradeGroups.Normalize(c.Group) == g).ToList()
        }))
        .Where(b => b.Items.Count > 0)
        .ToList();

    var gradedBlocks = GradePeriods.All
        .SelectMany(p => GradeGroups.All.Select(g => new
        {
            Name = blockName(p, g),
            Key = g == GradeGroups.Exam ? "ex" : "cs",
            Items = Model.Graded.Where(r => GradePeriods.Normalize(r.Period) == p && GradeGroups.Normalize(r.Group) == g).ToList()
        }))
        .Where(b => b.Items.Count > 0)
        .ToList();
}

<div class="gw-faculty-courses gw-fcourse gw-student-whatif">
<div class="gw-page-head">
    <div>
        <h1 class="gw-page-title">What-If simulator</h1>
        <p class="gw-page-sub">
            Try scores for your remaining work and see where your @(isFinalGrade ? "final" : Model.ScopeLabel) grade could land.
            @if (Model.HasCourse)
            {
                <span class="gw-badge">@Model.Term</span>
                <span class="gw-badge">Showing: @Model.ScopeLabel</span>
            }
        </p>
    </div>
</div>

@if (!Model.HasCourse)
{
    <section class="gw-panel">
        <div class="gw-panel-body gw-empty-state">
            <img src="@Url.Content("~/Content/img/stickers/mascot-cat.svg")" alt="" class="gw-empty-mascot" width="72" height="72" />
            <p class="gw-empty-title">Nothing to simulate yet</p>
            <p class="gw-muted">Your instructor enrolls you. The simulator opens once they do.</p>
        </div>
    </section>
}
else
{
    <section class="gw-panel gw-picker-panel gw-fc-panel">
        <div class="gw-panel-head">
            <h2 class="gw-panel-title">Course</h2>
        </div>
        <div class="gw-panel-body gw-fc-controls">
            <div class="gw-fc-filters">
                <div class="gw-fc-filter gw-fc-filter-search">
                    <label for="course-picker">Choose a course</label>
                    <select id="course-picker" class="gw-inline-select"
                            data-url="@Url.Action("WhatIf", "Student", new { id = "__ID__" })">
                        @foreach (var c in Model.Courses)
                        {
                            <option value="@c.Id" selected="@(c.Id == Model.SelectedId)">@c.Code &middot; @c.Name</option>
                        }
                    </select>
                </div>
                @Html.ActionLink("Back to course", "Course", "Student", new { id = Model.SelectedId }, new { @class = "gw-btn gw-btn-small gw-btn-outline" })
            </div>
        </div>
    </section>

    if (!Model.HasCategories)
    {
        <div class="gw-alert gw-alert-warn" role="status">
            No @Model.ScopeLabel grading categories are set for this course yet, so there is nothing to simulate.
        </div>
    }
    else if (!Model.WeightsOk)
    {
        <div class="gw-alert gw-alert-warn" role="status">
            The @Model.ScopeLabel weights add up to <strong>@GradeCalculator.Format(Model.WeightTotal)%</strong>, not 100%. The simulator is off until they are fixed.
        </div>
    }
    else if (Model.NothingLeft)
    {
        <section class="gw-stats" aria-label="Final result">
            <div class="gw-stat gw-stat-lime" data-tab="Final">
                <div class="gw-stat-value">@GradeCalculator.Format(Model.Earned)</div>
                <div class="gw-stat-label">@(isFinalGrade ? "Final Grade" : Model.ScopeLabel + " Grade") <span class="gw-th-sub">/100</span></div>
            </div>
            <div class="gw-stat gw-stat-blue" data-tab="Grade">
                <div class="gw-stat-value">@GradeCalculator.Format(Model.Equivalent)</div>
                <div class="gw-stat-label">Equivalent</div>
            </div>
        </section>
        <div class="gw-alert gw-alert-ok" role="status">
            Every @Model.ScopeLabel category is graded, so there is nothing left to simulate.
        </div>
    }
    else
    {
        <div id="whatif"
             data-goal-key="@("gw.goal." + Model.StudentNo + "." + Model.SelectedId)"
             data-earned="@GradeCalculator.Raw(Model.Earned)"
             data-remaining="@GradeCalculator.Raw(Model.RemainingWeight)"
             data-default="@GradeCalculator.Raw(Model.DefaultScore)"
             data-target="@GradeCalculator.Raw(GradeCalculator.PassingAverage)">

            <section class="gw-stats" aria-label="Projection">
                <div class="gw-stat gw-stat-lime" data-tab="Earned">
                    <div class="gw-stat-value">@GradeCalculator.Format(Model.Earned)</div>
                    <div class="gw-stat-label">Earned <span class="gw-th-sub">/100 (ungraded = 0)</span></div>
                </div>
                <div class="gw-stat gw-stat-gold" data-tab="Remaining">
                    <div class="gw-stat-value">@GradeCalculator.Format(Model.RemainingWeight)%</div>
                    <div class="gw-stat-label">Remaining weight <span class="gw-th-sub">(not graded yet)</span></div>
                </div>
                <div class="gw-stat gw-stat-live gw-stat-lav" data-tab="Projected">
                    <div class="gw-stat-value" id="sim-final" aria-live="polite">&mdash;</div>
                    <div class="gw-stat-label">@projectedLabel</div>
                </div>
                <div class="gw-stat gw-stat-live gw-stat-orange" data-tab="Grade">
                    <div class="gw-stat-value" id="sim-grade" aria-live="polite">&mdash;</div>
                    <div class="gw-stat-label">Projected Equivalent</div>
                </div>
            </section>

            <section class="gw-panel gw-sw-scenario">
                <div class="gw-panel-head">
                    <h2 class="gw-panel-title">Your scenario</h2>
                </div>
                <div class="gw-panel-body">
                    <div class="gw-fp-note gw-sw-note">
                        <p>Each term: <strong>Class Standing 60%</strong> + <strong>Exam 40%</strong>. Drag a slider or type a PS for each ungraded category.</p>
                    </div>
                    <div class="gw-table-wrap">
                        <table class="gw-table gw-sim-table">
                            <thead>
                                <tr>
                                    <th>Category</th>
                                    <th class="gw-num">Weight <span class="gw-th-sub">(@weightOf)</span></th>
                                    <th>PS you might get</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var block in ungradedBlocks)
                                {
                                    <tr class="gw-sw-grouprow gw-sw-group-@block.Key">
                                        <td colspan="3"><span class="gw-sw-group-name">@block.Name</span> <span class="gw-sw-group-w">@GradeCalculator.Format(block.Items.Sum(i => i.Weight))%</span></td>
                                    </tr>
                                    foreach (var c in block.Items)
                                    {
                                        <tr class="gw-sim-row" data-weight="@GradeCalculator.Raw(c.Weight)">
                                            <td><span class="gw-sg-cat"><span class="gw-sg-dot gw-sg-dot-@toneOf(c.Period, c.Name)" aria-hidden="true"></span>@c.Name</span></td>
                                            <td class="gw-num">@GradeCalculator.Format(c.Weight)%</td>
                                            <td>
                                                <div class="gw-sim-control">
                                                    <input type="range" class="gw-sim-range" min="0" max="100" step="1"
                                                           value="@GradeCalculator.Raw(Model.DefaultScore)"
                                                           aria-label="PS slider for @c.Name" />
                                                    <input type="number" class="gw-score-input gw-sim-num" min="0" max="100" step="0.01"
                                                           value="@GradeCalculator.Raw(Model.DefaultScore)"
                                                           aria-label="PS for @c.Name" />
                                                    <span class="gw-muted">/ 100</span>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                    <div id="sim-scenario-msg" class="gw-alert gw-sim-msg" role="status" style="display:none"></div>
                    <div class="gw-form-buttons">
                        <button type="button" id="sim-reset" class="gw-btn gw-btn-small gw-btn-outline">Reset</button>
                    </div>
                </div>
            </section>

            <section class="gw-panel gw-sw-target">
                <div class="gw-panel-head">
                    <h2 class="gw-panel-title">Target grade</h2>
                </div>
                <div class="gw-panel-body">
                    <div class="gw-fp-note gw-sw-note">
                        <p>Pick your goal to see what your remaining work must average.</p>
                        <p id="sim-goal-note" class="gw-goal-note" aria-live="polite"></p>
                    </div>

                    <div class="gw-chips" role="group" aria-label="Target equivalent grade">
                        @foreach (var step in Model.Scale)
                        {
                            <button type="button" class="gw-chip" aria-pressed="false"
                                    data-min="@GradeCalculator.Raw(step.MinAverage)" data-grade="@GradeCalculator.Raw(step.Grade)">
                                @GradeCalculator.Format(step.Grade) <span class="gw-th-sub">@GradeCalculator.Raw(step.MinAverage)%</span>
                            </button>
                        }
                    </div>

                    <div class="gw-sim-control gw-sim-target">
                        <label for="sim-target-num" class="gw-sim-label">@targetLabel</label>
                        <input type="range" id="sim-target-range" min="0" max="100" step="0.5" value="@GradeCalculator.Raw(GradeCalculator.PassingAverage)"
                               aria-label="Target slider" />
                        <input type="number" id="sim-target-num" class="gw-score-input" min="0" max="100" step="0.01" value="@GradeCalculator.Raw(GradeCalculator.PassingAverage)" />
                        <span class="gw-muted">%</span>
                    </div>

                    <div id="sim-target-msg" class="gw-alert gw-sim-msg" role="status" aria-live="polite"></div>
                    <p id="sim-compare" class="gw-muted gw-sim-compare" aria-live="polite"></p>
                    <div class="gw-form-buttons">
                        <button type="button" id="sim-apply" class="gw-btn gw-btn-small" style="display:none">Use this score for all remaining work</button>
                        <button type="button" id="sim-goal-clear" class="gw-btn gw-btn-small gw-btn-outline" hidden
                                data-confirm="Your saved goal will be removed."
                                data-confirm-title="Clear goal?"
                                data-confirm-ok="Clear">Clear goal</button>
                    </div>
                </div>
            </section>
        </div>

        if (Model.Graded.Count > 0)
        {
            <section class="gw-panel gw-sw-graded">
                <div class="gw-panel-head">
                    <h2 class="gw-panel-title">Already graded</h2>
                </div>
                <div class="gw-table-wrap">
                    <table class="gw-table">
                        <thead>
                            <tr>
                                <th>Category</th>
                                <th class="gw-num">Weight <span class="gw-th-sub">(@weightOf)</span></th>
                                <th class="gw-num">PS</th>
                                <th class="gw-num">Earned</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var block in gradedBlocks)
                            {
                                <tr class="gw-sw-grouprow gw-sw-group-@block.Key">
                                    <td colspan="4"><span class="gw-sw-group-name">@block.Name</span> <span class="gw-sw-group-w">@GradeCalculator.Format(block.Items.Sum(i => i.Weight))%</span></td>
                                </tr>
                                foreach (var r in block.Items)
                                {
                                    <tr>
                                        <td><span class="gw-sg-cat"><span class="gw-sg-dot gw-sg-dot-@toneOf(r.Period, r.Category)" aria-hidden="true"></span>@r.Category</span></td>
                                        <td class="gw-num">@GradeCalculator.Format(r.Weight)%</td>
                                        <td class="gw-num"><span class="gw-fc-chip gw-sr-ps gw-sr-ps-@gradeTone(r.Score)">@GradeCalculator.Format(r.Score)</span></td>
                                        <td class="gw-num">@GradeCalculator.Format(r.WeightedPoints)</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }

        <section class="gw-panel gw-calc" aria-label="How this is calculated">
            <div class="gw-panel-head">
                <h2 class="gw-panel-title">How this is calculated</h2>
            </div>
            <div class="gw-panel-body">
                <div class="gw-fp-note gw-sw-note">
                    <p>Projected = <strong>Earned</strong> + <strong>weight &times; PS &divide; 100</strong> for each remaining category. Final Grade = &frac12; Midterm + &frac12; Final Term.</p>
                </div>
                <div class="gw-table-wrap">
                    <table class="gw-table gw-calc-table">
                        <thead>
                            <tr>
                                <th>Part</th>
                                <th>Working</th>
                                <th class="gw-num">Points</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <th scope="row">Earned</th>
                                <td class="gw-calc-note">Graded work, already counted</td>
                                <td class="gw-num">@GradeCalculator.Format(Model.Earned)</td>
                            </tr>
                            @foreach (var block in ungradedBlocks)
                            {
                                <tr class="gw-sw-grouprow gw-sw-group-@block.Key">
                                    <td colspan="3"><span class="gw-sw-group-name">@block.Name</span> <span class="gw-sw-group-w">@GradeCalculator.Format(block.Items.Sum(i => i.Weight))%</span></td>
                                </tr>
                                foreach (var c in block.Items)
                                {
                                    <tr class="gw-calc-row">
                                        <th scope="row"><span class="gw-sg-cat"><span class="gw-sg-dot gw-sg-dot-@toneOf(c.Period, c.Name)" aria-hidden="true"></span>@c.Name</span></th>
                                        <td class="gw-calc-note"><span class="gw-calc-formula">&mdash;</span></td>
                                        <td class="gw-num gw-calc-points">&mdash;</td>
                                    </tr>
                                }
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th scope="row">@projectedLabel</th>
                                <td class="gw-calc-note" id="calc-sum" aria-live="polite">&mdash;</td>
                                <td class="gw-num" id="calc-total">&mdash;</td>
                            </tr>
                            <tr>
                                <th scope="row">Equivalent (Eq.)</th>
                                <td class="gw-calc-note">From the grade scale. Lowest pass: @GradeCalculator.Format(GradeCalculator.PassingAverage)%</td>
                                <td class="gw-num" id="calc-grade">&mdash;</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
            @* One line under the table: the rounding note, then what PS and Earned mean (it wraps only when the screen is narrow). *@
            <div class="gw-panel-body gw-calc-foot">
                <p class="gw-calc-foot-note">Lines are rounded. The total uses exact values.</p>
                <dl class="gw-sr-legend-list">
                    <div><dt>PS</dt><dd>Total &divide; highest possible &times; 100. Weights apply to PS.</dd></div>
                    <div><dt>Earned</dt><dd>Points out of 100. Ungraded work counts as 0.</dd></div>
                </dl>
            </div>
        </section>
    }
}

</div>

@section scripts {
    <script src="@Url.Content("~/Scripts/whatif.js")?v=@System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Scripts/whatif.js")).Ticks"></script>
    <script>
        // Switch course as soon as another one is picked. The address is built from the page's own route,
        // so the course you are leaving can never be sent along with the new one.
        var picker = document.getElementById("course-picker");
        if (picker) {
            picker.addEventListener("change", function () {
                var template = picker.getAttribute("data-url");
                if (!template || !picker.value) return;
                window.location.href = template.replace("__ID__", encodeURIComponent(picker.value));
            });
        }
    </script>
}
