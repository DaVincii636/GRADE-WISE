@model GradeWise.Models.StudentDashboardViewModel
@using System.Globalization
@using GradeWise.Models
@using GradeWise.Services
@{
    ViewBag.Title = "My courses";
    // Sticker colours cycle through the same accents the faculty My courses page uses.
    var tones = new[] { "lime", "blue", "gold", "lav", "orange" };
}

@* Defined before the page markup, so it also runs when the student has no courses. The script is in Scripts/student-grades.js. *@
@section scripts {
    <script src="@Url.Content("~/Scripts/student-grades.js")?v=@System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Scripts/student-grades.js")).Ticks"></script>
}

<div class="gw-faculty-courses gw-fcourse gw-student-grades gw-calm">
<div class="gw-page-head gw-page-head-date">
    <div>
        <h1 class="gw-page-title">My courses</h1>
        <p class="gw-page-sub">Pick a course to see your scores.</p>
    </div>
    <div class="gw-datebox" aria-live="off">
        <span class="gw-datebox-day" id="gw-day">@DateTime.Now.ToString("dddd", CultureInfo.InvariantCulture)</span>
        <span class="gw-datebox-date" id="gw-date">@DateTime.Now.ToString("MM/dd/yyyy", CultureInfo.InvariantCulture)</span>
    </div>
</div>

@{
    // Shown after the student changes their email or password (see AccountController).
    var flash = TempData["Message"] as string;
}
@if (!string.IsNullOrEmpty(flash))
{
    <div class="gw-alert gw-alert-ok" role="status">@flash</div>
}

@if (!Model.HasCourse)
{
    <section class="gw-panel">
        <div class="gw-panel-body gw-empty-state">
            <img src="@Url.Content("~/Content/img/stickers/mascot-cat.svg")" alt="" class="gw-empty-mascot" width="72" height="72" />
            <p class="gw-empty-title">No courses yet</p>
            <p class="gw-muted">Your instructor enrolls you. Your grades show up here once they do.</p>
        </div>
    </section>
    @:</div>
    return;
}

<section class="gw-panel gw-picker-panel gw-fc-panel" aria-labelledby="gw-sg-title">
    <div class="gw-panel-head">
        <h2 class="gw-panel-title" id="gw-sg-title">Your courses</h2>
    </div>
    @* Search filter: hidden until student-grades.js runs (and only shown for longer course lists); without JavaScript every course is listed. *@
    <div class="gw-panel-body gw-fc-controls" id="gw-fc-controls" hidden>
        <div class="gw-fc-filters" role="search" aria-label="Filter courses">
            <div class="gw-fc-filter gw-fc-filter-search">
                <label for="gw-fc-search">Search</label>
                <input type="search" id="gw-fc-search" class="gw-inline-select" placeholder="Course code, name or instructor" autocomplete="off" spellcheck="false" />
            </div>
            <button type="button" class="gw-btn gw-btn-small gw-btn-outline" id="gw-fc-clear">Clear filters</button>
        </div>
        <p class="gw-fc-count" id="gw-fc-count" aria-live="polite"></p>
    </div>

    <ul class="gw-collection" id="gw-fc-list">
        @for (var i = 0; i < Model.Courses.Count; i++)
        {
            var c = Model.Courses[i];
            var tone = tones[i % tones.Length];
            <li data-course-row data-search="@((c.Code + " " + c.Name + " " + c.FacultyName).ToLowerInvariant())">
                <a href="@Url.Action("Course", "Student", new { id = c.Id })" class="gw-collection-item gw-collection-row gw-fc-row gw-fc-row-@tone">
                    <span class="gw-collection-sticker gw-fc-sticker gw-fc-sticker-@tone" aria-hidden="true">@(c.Code.Length > 2 ? c.Code.Substring(0, 2) : c.Code)</span>
                    <span class="gw-collection-main">
                        <span class="gw-collection-code">@c.Code &middot; @c.Name</span>
                        <span class="gw-collection-meta gw-fc-meta">
                            <span class="gw-fc-chip gw-fc-chip-section">@c.FacultyName</span>
                        </span>
                    </span>
                    <img src="@Url.Content("~/Content/img/icons/chevron-right.svg")" alt="" class="gw-collection-chevron" width="20" height="20" />
                </a>
            </li>
        }
        <li class="gw-fc-empty" id="gw-fc-empty" hidden>
            <span>No courses match this search.</span>
            <button type="button" class="gw-fc-linkbtn" data-fc-clear>Clear filters</button>
        </li>
    </ul>
</section>
</div>
