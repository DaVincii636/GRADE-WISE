@model GradeWise.Models.StudentDashboardViewModel
@using System.Globalization
@using GradeWise.Models
@using GradeWise.Services
@{
    ViewBag.Title = "My grades";
    // The Period column only makes sense when both periods are shown together (Final Grade).
    var showPeriod = Model.Scope == GradeScopes.FinalGrade;
}

@* Defined before any early return below, so it also runs when the student has no courses. *@
@section scripts {
    <script>
        (function () {
            // Day and date come from the browser, so they match the student's own time zone.
            var names = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];
            var now = new Date();
            var two = function (n) { return n < 10 ? "0" + n : "" + n; };
            var day = document.getElementById("gw-day");
            var date = document.getElementById("gw-date");
            if (day) { day.textContent = names[now.getDay()]; }
            if (date) { date.textContent = two(now.getMonth() + 1) + "/" + two(now.getDate()) + "/" + now.getFullYear(); }

            // Choosing a course scrolls down to its numbers. The flag survives the page reload.
            var rows = document.querySelectorAll(".gw-picker-panel a.gw-collection-item");
            for (var r = 0; r < rows.length; r++) {
                rows[r].addEventListener("click", function () {
                    try { sessionStorage.setItem("gwScroll", "1"); } catch (e) { }
                });
            }

            var flag = null;
            try {
                flag = sessionStorage.getItem("gwScroll");
                sessionStorage.removeItem("gwScroll");
            } catch (e) { }

            var target = document.getElementById("course-summary");
            if (flag === "1" && target) {
                var calm = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
                window.scrollTo(0, 0);
                window.requestAnimationFrame(function () {
                    target.scrollIntoView({ behavior: calm ? "auto" : "smooth", block: "start" });
                });
            }
        })();
    </script>
}

<div class="gw-page-head gw-page-head-date">
    <div>
        <h1 class="gw-page-title">My grades</h1>
        <p class="gw-page-sub">
            Your courses, scores, and projected final grade.
            @if (Model.HasCourse)
            {
                <span class="gw-badge">@Model.Term</span>
                <span class="gw-badge">Showing: @Model.ScopeLabel</span>
            }
        </p>
    </div>
    <div class="gw-datebox" aria-live="off">
        <span class="gw-datebox-day" id="gw-day">@DateTime.Now.ToString("dddd", CultureInfo.InvariantCulture)</span>
        <span class="gw-datebox-date" id="gw-date">@DateTime.Now.ToString("MM/dd/yyyy", CultureInfo.InvariantCulture)</span>
    </div>
</div>

@{
    // Shown after the student changes their email or password (see AccountController).
    var flash = TempData["Message"] as string;
}
@if (!string.IsNullOrEmpty(flash))
{
    <div class="gw-alert gw-alert-ok" role="status">@flash</div>
}

@if (!Model.HasCourse)
{
    <section class="gw-panel">
        <div class="gw-panel-body gw-empty-state">
            <img src="@Url.Content("~/Content/img/stickers/mascot-cat.svg")" alt="" class="gw-empty-mascot" width="72" height="72" />
            <p class="gw-empty-title">No courses yet</p>
            <p class="gw-muted">You are not enrolled in any course yet. Your instructor enrolls you, and your grades appear here once they do.</p>
        </div>
    </section>
    return;
}

<section class="gw-panel gw-picker-panel">
    <div class="gw-panel-head">
        <h2 class="gw-panel-title">Your courses</h2>
    </div>
    <ul class="gw-collection">
        @foreach (var c in Model.Courses)
        {
            var current = c.Id == Model.SelectedId;
            <li>
                <a href="@(Url.Action("Index", "Student", new { id = c.Id }) + "#course-summary")" class="gw-collection-item" aria-current="@(current ? "true" : "false")">
                    <span class="gw-collection-sticker" aria-hidden="true">@(c.Code.Length > 2 ? c.Code.Substring(0, 2) : c.Code)</span>
                    <span class="gw-collection-main">
                        <span class="gw-collection-code">@c.Code</span>
                        <span class="gw-collection-meta">@c.Name &middot; @c.FacultyName</span>
                    </span>
                    <img src="@Url.Content("~/Content/img/icons/chevron-right.svg")" alt="" class="gw-collection-chevron" width="20" height="20" />
                </a>
            </li>
        }
    </ul>
    <div class="gw-panel-body gw-collection-actions">
        @Html.ActionLink("What-If simulator", "WhatIf", "Student", new { id = Model.SelectedId }, new { @class = "gw-btn gw-btn-small" })
        @Html.ActionLink("Printable summary", "Summary", "Student", new { id = Model.SelectedId }, new { @class = "gw-btn gw-btn-small gw-btn-outline" })
    </div>
</section>

@if (!Model.HasCategories)
{
    <div class="gw-alert gw-alert-warn" role="status">
        Your instructor has not set the @Model.ScopeLabel grading categories for this course yet, so there is nothing to calculate.
    </div>
}
else if (!Model.WeightsOk)
{
    <div class="gw-alert gw-alert-warn" role="status">
        The @Model.ScopeLabel grading weights for this course add up to <strong>@GradeCalculator.Format(Model.WeightTotal)%</strong>, not 100%.
        Your numbers may change once your instructor fixes them.
    </div>
}

<section class="gw-stats" id="course-summary" aria-label="Summary">
    <div class="gw-stat gw-stat-stamp" data-tab="Average">
        @if (Model.Equivalent.HasValue)
        {
            <span class="gw-grade-stamp" aria-label="Equivalent grade @GradeCalculator.Format(Model.Equivalent)">
                <img src="@Url.Content("~/Content/img/stickers/stamp-ring.svg")" alt="" class="gw-grade-stamp-ring" width="64" height="64" />
                <span class="gw-grade-stamp-text">@GradeCalculator.Format(Model.Equivalent)</span>
            </span>
        }
        <div class="gw-stat-value">@(Model.Average.HasValue ? GradeCalculator.Format(Model.Average) + "%" : "\u2014")</div>
        <div class="gw-stat-label">Current average <span class="gw-th-sub">(@Model.ScopeLabel, graded work so far)</span></div>
    </div>
    <div class="gw-stat" data-tab="Equivalent">
        <div class="gw-stat-value">@GradeCalculator.Format(Model.Equivalent)</div>
        <div class="gw-stat-label">Equivalent grade <span class="gw-th-sub">(@Model.ScopeLabel, based on points earned so far)</span></div>
    </div>
    <div class="gw-stat" data-tab="Remaining">
        <div class="gw-stat-value">@(Model.HasCategories ? GradeCalculator.Format(Model.RemainingWeight) + "%" : "\u2014")</div>
        <div class="gw-stat-label">Remaining weight <span class="gw-th-sub">(@Model.ScopeLabel, not graded yet)</span></div>
    </div>
</section>

<section class="gw-panel">
    <div class="gw-panel-head">
        <h2 class="gw-panel-title">Assessment breakdown</h2>
    </div>
    <div class="gw-table-wrap">
        <table class="gw-table">
            <thead>
                <tr>
                    <th>Category</th>
                    @if (showPeriod)
                    {
                        <th>Period</th>
                    }
                    <th class="gw-num">Weight</th>
                    <th class="gw-num">Your score</th>
                    <th class="gw-num">Weighted points</th>
                    <th class="gw-num">Class average</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Rows.Count == 0)
                {
                    <tr>
                        <td colspan="@(showPeriod ? 6 : 5)" class="gw-empty">Your scores appear here once your instructor enters them.</td>
                    </tr>
                }
                @foreach (var r in Model.Rows)
                {
                    <tr>
                        <td>@r.Category</td>
                        @if (showPeriod)
                        {
                            <td>@r.Period</td>
                        }
                        <td class="gw-num">@GradeCalculator.Format(r.Weight)%</td>
                        <td class="gw-num">
                            @if (r.Score.HasValue)
                            {
                                @GradeCalculator.Format(r.Score)
                            }
                            else
                            {
                                <span class="gw-cell-empty">Not graded yet</span>
                            }
                        </td>
                        <td class="gw-num">@GradeCalculator.Format(r.WeightedPoints)</td>
                        <td class="gw-num">
                            @if (r.ClassAverage.HasValue)
                            {
                                @GradeCalculator.Format(r.ClassAverage)
                            }
                            else
                            {
                                <span class="gw-muted">&mdash;</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
            @if (Model.Rows.Count > 0)
            {
                <tfoot>
                    <tr>
                        <th>Total</th>
                        @if (showPeriod)
                        {
                            <th></th>
                        }
                        <th class="gw-num">@GradeCalculator.Format(Model.WeightTotal)%</th>
                        <th></th>
                        <th class="gw-num">@GradeCalculator.Format(Model.Earned)</th>
                        <th></th>
                    </tr>
                </tfoot>
            }
        </table>
    </div>
</section>

@Html.Partial("_History", Model)

@{
    var hasClass = Model.ClassAverage.HasValue;
    string gapText = null;
    if (hasClass && Model.EarnedGrade.HasValue)
    {
        var diff = Model.EarnedGrade.Value - Model.ClassAverage.Value;
        gapText = System.Math.Abs(diff) < 0.005
            ? "the same as the class"
            : GradeCalculator.Format(System.Math.Abs(diff)) + " points " + (diff > 0 ? "above" : "below") + " the class";
    }
}

<section class="@(hasClass ? "gw-panel gw-benchmark" : "gw-panel gw-benchmark gw-benchmark-empty")" aria-labelledby="benchmark-title">
    @if (hasClass)
    {
        <div class="gw-benchmark-figure">
            <img src="@Url.Content("~/Content/img/icons/quote.svg")" alt="" class="gw-quote" width="28" height="28" />
            <div class="gw-stat-value">@GradeCalculator.Format(Model.ClassAverage)%</div>
        </div>
        <div class="gw-benchmark-body">
            <h2 id="benchmark-title" class="gw-panel-title">How you compare</h2>
            <p>
                Across <strong>@Model.ClassGraded</strong> students with scores, the class @Model.ScopeLabel average is
                <strong>@GradeCalculator.Format(Model.ClassAverage)%</strong>.
                @if (gapText != null)
                {
                    <span>Yours is <strong>@GradeCalculator.Format(Model.EarnedGrade)%</strong>, which is <strong>@gapText</strong>.</span>
                }
            </p>
        </div>
        <p class="gw-benchmark-note">Only averages are shown. You never see other students' names or scores.</p>
    }
    else
    {
        <div class="gw-benchmark-body">
            <h2 id="benchmark-title" class="gw-panel-title">How you compare</h2>
            <p class="gw-muted">
                The class benchmark appears once at least @Model.MinClassSize students have scores. This keeps everyone's grades private.
            </p>
        </div>
    }
</section>
