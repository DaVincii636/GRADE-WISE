@{
    ViewBag.Title = "My grades";
}

<h1 class="gw-page-title">My grades</h1>
<p class="gw-page-sub">Your courses, scores, and projected final grade.</p>

<section class="gw-stats" aria-label="Summary">
        <div class="gw-stat">
            <div class="gw-stat-value">&mdash;</div>
            <div class="gw-stat-label">Current average</div>
        </div>
        <div class="gw-stat">
            <div class="gw-stat-value">&mdash;</div>
            <div class="gw-stat-label">Equivalent grade</div>
        </div>
        <div class="gw-stat">
            <div class="gw-stat-value">&mdash;</div>
            <div class="gw-stat-label">Remaining weight</div>
        </div>
</section>

<section class="gw-panel">
    <div class="gw-panel-head">
        <h2 class="gw-panel-title">Assessment breakdown</h2>
    </div>
    <div class="gw-table-wrap">
        <table class="gw-table">
            <thead>
                <tr>
                        <th>Category</th>
                        <th>Weight</th>
                        <th>Score</th>
                        <th>Weighted points</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td colspan="4" class="gw-empty">Your scores appear here once your instructor enters them.</td>
                </tr>
            </tbody>
        </table>
    </div>
</section>
