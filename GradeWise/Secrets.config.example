<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy this file to "Secrets.config" (same folder) and fill in your own values.
  Secrets.config is ignored by Git, so never commit it.

  Local MongoDB:  mongodb://localhost:27017
  Atlas cluster:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&amp;w=majority
  (In XML, write & as &amp;)
-->
<appSettings>
  <add key="MongoConnectionString" value="mongodb://localhost:27017" />
  <add key="MongoDatabaseName" value="gradewise" />
</appSettings>
